{%- comment -%} Brand color fallbacks: derived colors inherit style_brand_color when left empty {%- endcomment -%}
{%- assign styleBrandColor = settings.style_brand_color -%}
{%- assign styleAccentColor = settings.style_accent_color -%}
{%- if styleAccentColor == blank and styleBrandColor != blank -%}
	{%- assign styleAccentColor = styleBrandColor -%}
{%- endif -%}
{%- assign styleBtnBgColor = settings.style_btn_bg_color -%}
{%- if styleBtnBgColor == blank and styleBrandColor != blank -%}
	{%- assign styleBtnBgColor = styleBrandColor -%}
{%- endif -%}
{%- assign styleBtnTextColor = settings.style_btn_text_color -%}
{%- if styleBtnTextColor == blank and styleBtnBgColor != blank -%}
	{%- assign styleBtnBgBrightnessForText = styleBtnBgColor | color_brightness -%}
	{%- if styleBtnBgBrightnessForText > 190 -%}
		{%- assign styleBtnTextColor = '#000000' | color_min_contrast: styleBtnBgColor -%}
	{%- else -%}
		{%- assign styleBtnTextColor = '#ffffff' | color_min_contrast: styleBtnBgColor -%}
	{%- endif -%}
{%- endif -%}
{%- assign styleHeaderAccentColor = settings.style_header_accent_color -%}
{%- if styleHeaderAccentColor == blank and styleBrandColor != blank -%}
	{%- assign styleHeaderAccentColor = styleBrandColor -%}
{%- endif -%}
{%- assign styleAnnouncementBgColor = settings.style_announcement_bg_color -%}
{%- if styleAnnouncementBgColor == blank and styleBrandColor != blank -%}
	{%- assign styleBrandColorBrightness = styleBrandColor | color_brightness -%}
	{%- if styleBrandColorBrightness > 128 -%}
		{%- assign styleAnnouncementBgColor = styleBrandColor | color_mix: '#ffffff', 35 -%}
	{%- else -%}
		{%- assign styleAnnouncementBgColor = styleBrandColor | color_darken: 10 -%}
	{%- endif -%}
{%- endif -%}
{%- assign styleAnnouncementTextColor = settings.style_announcement_text_color -%}
{%- if styleAnnouncementTextColor == blank and styleAnnouncementBgColor != blank -%}
	{%- assign styleAnnouncementBgBrightness = styleAnnouncementBgColor | color_brightness -%}
	{%- if styleAnnouncementBgBrightness > 190 -%}
		{%- assign styleAnnouncementTextColor = '#000000' | color_min_contrast: styleAnnouncementBgColor -%}
	{%- else -%}
		{%- assign styleAnnouncementTextColor = '#ffffff' | color_min_contrast: styleAnnouncementBgColor -%}
	{%- endif -%}
{%- endif -%}

{%- assign styleFormBgColorBrightness = settings.style_form_bg_color | color_brightness -%}
{%- assign styleFormBorderColorBrightness = settings.style_form_border_color | color_brightness -%}
{%- assign styleTextColorBrightness = settings.style_text_color | color_brightness -%}
{%- assign styleTableBgColorBrightness = settings.style_table_bg_color | color_brightness -%}
{%- assign styleBgColorBrightness = settings.style_bg_color | color_brightness -%}
{%- assign styleBorderColorBrightness = settings.style_border_color | color_brightness -%}
{%- assign styleButtonBgColorColorBrightness = styleBtnBgColor | color_brightness -%}
{%- assign styleBtnSecondaryBg = settings.style_btn_secondary_bg_color -%}
{%- if styleBtnSecondaryBg == blank -%}
	{%- if styleButtonBgColorColorBrightness > 190 -%}
		{%- assign styleBtnSecondaryBg = styleBtnBgColor | color_darken: 28 -%}
	{%- else -%}
		{%- assign styleBtnSecondaryBg = styleBtnBgColor | color_lighten: 42 -%}
	{%- endif -%}
{%- endif -%}
{%- assign styleBtnSecondaryText = settings.style_btn_secondary_text_color -%}
{%- if styleBtnSecondaryText == blank -%}
	{%- assign styleBtnSecondaryText = '#ffffff' | color_min_contrast: styleBtnSecondaryBg -%}
{%- endif -%}
{%- assign styleButtonSecondaryBgColorBrightness = styleBtnSecondaryBg | color_brightness -%}
{%- assign styleAccentColorBrightness = styleAccentColor | color_brightness -%}
{%- assign bodySecondaryBg = settings.style_bg_color | color_darken: 30 -%}
{%- assign bodyTertiaryBg = settings.style_bg_color | color_darken: 10 -%}

{%- assign styleStoreMaxWidth = settings.styleGridContainerMaxWidthXxl -%}
{%- if settings.styleGridContainerMaxWidthPreset == 's' -%}
	{%- assign styleStoreMaxWidth = 960 -%}
{%- elsif settings.styleGridContainerMaxWidthPreset == 'm' -%}
	{%- assign styleStoreMaxWidth = 1320 -%}
{%- elsif settings.styleGridContainerMaxWidthPreset == 'l' -%}
	{%- assign styleStoreMaxWidth = 1600 -%}
{%- elsif settings.styleGridContainerMaxWidthPreset == 'edit' -%}
	{%- assign styleStoreMaxWidth = settings.styleGridContainerMaxWidthXxl -%}
{%- endif -%}
{%- if styleStoreMaxWidth == blank -%}
	{%- assign styleStoreMaxWidth = 1320 -%}
{%- endif -%}
{%- unless styleStoreMaxWidth contains 'px' -%}{%- assign styleStoreMaxWidth = styleStoreMaxWidth | append: 'px' -%}{%- endunless -%}

{%- assign styleBorderRadiusGlobal = settings.styleBorderRadius -%}
{%- if settings.styleBorderRadiusPreset == 'none' or settings.styleBorderRadiusPreset == 's' -%}
	{%- assign styleBorderRadiusGlobal = 0 -%}
{%- elsif settings.styleBorderRadiusPreset == 'small' -%}
	{%- assign styleBorderRadiusGlobal = 8 -%}
{%- elsif settings.styleBorderRadiusPreset == 'medium' or settings.styleBorderRadiusPreset == 'm' -%}
	{%- assign styleBorderRadiusGlobal = 12 -%}
{%- elsif settings.styleBorderRadiusPreset == 'pill' or settings.styleBorderRadiusPreset == 'l' -%}
	{%- assign styleBorderRadiusGlobal = 50 -%}
{%- elsif settings.styleBorderRadiusPreset == 'custom' or settings.styleBorderRadiusPreset == 'edit' -%}
	{%- assign styleBorderRadiusGlobal = settings.styleBorderRadius | default: 12 -%}
{%- endif -%}
{%- unless styleBorderRadiusGlobal contains 'px' or styleBorderRadiusGlobal contains 'rem' -%}{%- assign styleBorderRadiusGlobal = styleBorderRadiusGlobal | append: 'px' -%}{%- endunless -%}

{%- if settings.styleBorderRadiusFineTune -%}
	{%- assign styleImageBorderRadius = settings.styleImageBorderRadius -%}
	{%- assign styleInputBorderRadius = settings.styleInputBorderRadius -%}
{%- else -%}
	{%- assign styleImageBorderRadius = styleBorderRadiusGlobal -%}
	{%- assign styleInputBorderRadius = styleBorderRadiusGlobal -%}
{%- endif -%}

{%- assign styleButtonBorderRadiusValue = settings.styleButtonBorderRadius -%}
{%- if styleButtonBorderRadiusValue.apply_to_all_sides -%}
	{%- assign styleButtonBorderRadius = styleButtonBorderRadiusValue.border_radius | default: 0 | append: 'px' -%}
{%- else -%}
	{%- assign styleButtonBorderRadiusTl = styleButtonBorderRadiusValue.top_left | default: 0 | append: 'px' -%}
	{%- assign styleButtonBorderRadiusTr = styleButtonBorderRadiusValue.top_right | default: 0 | append: 'px' -%}
	{%- assign styleButtonBorderRadiusBr = styleButtonBorderRadiusValue.bottom_right | default: 0 | append: 'px' -%}
	{%- assign styleButtonBorderRadiusBl = styleButtonBorderRadiusValue.bottom_left | default: 0 | append: 'px' -%}
	{%- assign styleButtonBorderRadius = styleButtonBorderRadiusTl | append: ' ' | append: styleButtonBorderRadiusTr | append: ' ' | append: styleButtonBorderRadiusBr | append: ' ' | append: styleButtonBorderRadiusBl -%}
{%- endif -%}
{%- if styleButtonBorderRadius == blank -%}
	{%- assign styleButtonBorderRadius = styleBorderRadiusGlobal | default: '0px' -%}
{%- endif -%}

{%- unless styleImageBorderRadius contains 'px' or styleImageBorderRadius contains 'rem' -%}{%- assign styleImageBorderRadius = styleImageBorderRadius | append: 'px' -%}{%- endunless -%}
{%- unless styleInputBorderRadius contains 'px' or styleInputBorderRadius contains 'rem' -%}{%- assign styleInputBorderRadius = styleInputBorderRadius | append: 'px' -%}{%- endunless -%}

{%- comment -%} Heading fonts inherit bodyTextFont when left empty {%- endcomment -%}
{%- assign bodyTextFont = settings.bodyTextFont -%}
{%- assign headingFontFamily = settings.headingFont -%}
{%- if headingFontFamily == blank -%}
	{%- assign headingFontFamily = bodyTextFont -%}
{%- endif -%}
{%- assign h1FontFamily = settings.h1Font -%}
{%- if h1FontFamily == blank -%}
	{%- assign h1FontFamily = headingFontFamily -%}
{%- endif -%}
{%- assign h2FontFamily = settings.h2Font -%}
{%- if h2FontFamily == blank -%}
	{%- assign h2FontFamily = headingFontFamily -%}
{%- endif -%}
{%- assign h3FontFamily = settings.h3Font -%}
{%- if h3FontFamily == blank -%}
	{%- assign h3FontFamily = headingFontFamily -%}
{%- endif -%}
{%- assign displayFontFamily = settings.displayFont -%}
{%- if displayFontFamily == blank -%}
	{%- assign displayFontFamily = headingFontFamily -%}
{%- endif -%}

$font-size-base: {{- settings.bodyFontSize | default: '1' -}}rem * {{- settings.textScale -}};
$font-family-base: {{- bodyTextFont -}};
$font-style: {{- settings.bodyTextFontStyle -}};
$letter-spacing: {{- settings.bodyLetterSpacing -}};
$line-height-base: {{- settings.textLineHeight -}};

$h1-font-size: {{- settings.h1FontSize | default: '1.85' -}}rem * {{- settings.headingFontScale -}};
$h2-font-size: {{- settings.h2FontSize | default: '1.55' -}}rem * {{- settings.headingFontScale -}};
$h3-font-size: {{- settings.h3FontSize | default: '1.35' -}}rem * {{- settings.headingFontScale -}};
$h4-font-size: 1.15rem * {{- settings.headingFontScale -}};
$h5-font-size: 1.05rem * {{- settings.headingFontScale -}};
$h6-font-size: 0.82rem * {{- settings.headingFontScale -}};

$headings-font-family: {{- headingFontFamily -}};
$headings-font-weight: {{- settings.headingFontWeight -}};
$headings-font-style: {{- settings.headingFontStyle -}};
$headings-text-transform: {{- settings.headingTextTransform -}};
$headings-letter-spacing: {{- settings.headingLetterSpacing -}};

$h1-font-family: {{- h1FontFamily -}};
$h1-font-weight: {{- settings.h1FontWeight | default: 'inherit' -}};
$h2-font-family: {{- h2FontFamily -}};
$h2-font-weight: {{- settings.h2FontWeight | default: 'inherit' -}};
$h3-font-family: {{- h3FontFamily -}};
$h3-font-weight: {{- settings.h3FontWeight | default: 'inherit' -}};

$display-font-family: {{- displayFontFamily -}};
$display-font-size: {{- settings.displayFontSize | default: '3.5' -}}rem;
$display-font-weight: {{- settings.displayFontWeight | default: 'inherit' -}};
$display-font-style: {{- settings.displayFontStyle | default: 'normal' -}};
$display-text-transform: {{- settings.displayTextTransform | default: 'none' -}};

$subheadings-font-family: {{- settings.subheadingFont -}};
$subheadings-font-size: {{- settings.subheadingFontSize | default: '1' -}}rem;
$subheadings-font-weight: {{- settings.subheadingFontWeight -}};
$subheadings-font-style: {{- settings.subheadingFontStyle -}};
$subheadings-text-transform: {{- settings.subheadingTextTransform -}};
$subheadings-letter-spacing: {{- settings.subheadingLetterSpacing -}};

$overlines-font-family: {{- settings.overlineFont -}};
$overlines-font-weight: {{- settings.overlineFontWeight -}};
$overlines-font-style: {{- settings.overlineFontStyle -}};
$overlines-text-transform: {{- settings.overlineTextTransform -}};
$overlines-letter-spacing: {{- settings.overlineLetterSpacing -}};

$accent-font-family: {{- settings.accentFont -}};
$accent-font-weight: {{- settings.accentFontWeight -}};
$accent-font-style: {{- settings.accentFontStyle -}};
$accent-text-transform: {{- settings.accentTextTransform -}};

$navigation-font-size: 1rem * {{- settings.navigationFontScale -}};
$navigation-submenu-font-scale: {{- settings.navigationSubmenuFontScale | default: '1' -}};
$navigation-font-family: {{- settings.navigationFont -}};
$navigation-font-weight: {{- settings.navigationFontWeight -}};
$navigation-font-style: {{- settings.navigationFontStyle -}};
$navigation-text-transform: {{- settings.navigationTextTransform -}};
$navigation-letter-spacing: {{- settings.navigationLetterSpacing -}};

$btn-font-family: {{- settings.buttonFont -}};
$btn-font-weight: {{- settings.buttonFontWeight -}};
$btn-font-style: {{- settings.buttonFontStyle -}};
$btn-text-transform: {{- settings.buttonTextTransform -}};
$btn-letter-spacing: {{- settings.buttonLetterSpacing -}};
{%- assign btnPrimaryVariant = settings.styleButtonPrimaryVariant -%}
{%- if btnPrimaryVariant == blank -%}{%- assign btnPrimaryVariant = '1' -%}{%- endif -%}
{%- assign btnSecondaryVariant = settings.styleButtonSecondaryVariant -%}
{%- if btnSecondaryVariant == blank -%}{%- assign btnSecondaryVariant = '1' -%}{%- endif -%}
$btn-primary-variant: '{{ btnPrimaryVariant }}';
$btn-secondary-variant: '{{ btnSecondaryVariant }}';
$btn-padding-y: {{- settings.styleBtnPaddingY -}};
$btn-padding-x: {{- settings.styleBtnPaddingX -}};
$btn-border-width: {{- settings.styleBtnBorderWidth | default: 2 -}}px;

$input-btn-padding-y: {{- settings.styleInputBtnPaddingY -}};
$input-btn-padding-x: {{- settings.styleInputBtnPaddingX -}};

$form-floating-content-height: {{- settings.styleFormFloatingHeight }};
$form-floating-line-height: {{- settings.styleFormFloatingLineHeight -}};
$form-floating-padding-x: {{- settings.styleFormFloatingPaddingX -}};
$form-floating-padding-y: {{- settings.styleFormFloatingPaddingY -}};
$form-floating-input-padding-t: {{- settings.styleFormFloatingInputPaddingT -}};
$form-floating-input-padding-b: {{- settings.styleFormFloatingInputPaddingB -}};
$form-floating-label-height: {{- settings.styleFormFloatingLabelHeight -}};

$announcementFontScale: {{ settings.styleAnnouncementFontScale }};

$container-max-widths: (
	sm: {{ settings.styleGridContainerMaxWidthSm }},
	md: {{ settings.styleGridContainerMaxWidthMd }},
	lg: {{ settings.styleGridContainerMaxWidthLg }},
	xl: {{ styleStoreMaxWidth }},
	xxl: {{ styleStoreMaxWidth }}
);

$container-custom-max-widths: (
	tiny: {{ settings.styleGridContainerMaxWidthTiny }},
	compact: {{ settings.styleGridContainerMaxWidthCompact }},
	fair: {{ settings.styleGridContainerMaxWidthFair }}
);

$container-padding-x: var(--style-grid-container-padding-x);

$grid-columns: 12;
$grid-gutter-width: var(--style-grid-gutter-width);
$grid-row-columns: 10;

$grid-breakpoints: (
	xs: 0,
	sm: {{ settings.styleGridBreakpointSm }},
	md: {{ settings.styleGridBreakpointMd }},
	lg: {{ settings.styleGridBreakpointLg }},
	xl: {{ settings.styleGridBreakpointXl }},
	xxl: {{ settings.styleGridBreakpointXxl }},
);

$aspect-ratios: (
	'21-9': '21:9',
	'16-10': '16:10',
	'16-9': '16:9',
	'9-13': '9:13',
	'9-12': '9:12',
	'9-11': '9:11',
	'4-5': '4:5',
	'4-3': '4:3',
	'3-5': '3:5',
	'3-4': '3:4',
	'2-1': '2:1',
	'1-1': '1:1',
	'product': '{{- settings.productImageAspectRatio -}}',
	'article': '{{- settings.articleImageAspectRatio -}}'
);

$product-image-aspect-ratio-fit: {{- settings.productImageAspectRatioFit -}};
$article-image-aspect-ratio-fit: {{- settings.articleImageAspectRatioFit -}};

$section-highlight-item-border: {%- if settings.sectionHighlightItemBorder -%}'true'{%- else -%}'false'{%- endif -%};
$section-text-align: {{- settings.sectionTextAlign -}};
{%- assign styleElevation = settings.styleElevation | default: 'soft' -%}
{%- if styleElevation == blank -%}{%- assign styleElevation = 'soft' -%}{%- endif -%}
$style-elevation: '{{ styleElevation }}';

$spacer: 1rem;
$spacers: (
	0: 0,
	1: ($spacer * .28569),
	2: ($spacer * .5),
	3: $spacer,
	4: ($spacer * 1.5),
	5: ($spacer * 2),
	6: ($spacer * 2.5715),
	7: ($spacer * 3.5),
	8: ($spacer * 4.5),
	9: ($spacer * 5),
	10: ($spacer * 6),
	11: ($spacer * 7),
	12: ($spacer * 8),
	'g': var(--style-grid-gutter-width),
	'c': var(--style-grid-container-padding-x)
);

$image-border-radius: {{ styleImageBorderRadius }};
$product-image-border-radius: {{ styleImageBorderRadius }};

$enable-input-borders: {%- if settings.styleInputBorder -%}'true'{%- else -%}'false'{%- endif -%};

$body-bg: {{ settings.style_bg_color }};
$body-color: {{ settings.style_text_color }};

$body-secondary-bg: {{ bodySecondaryBg }};
$body-secondary-color: {{ settings.style_text_color | color_modify: 'alpha', 0.75 | color_min_contrast: bodySecondaryBg }};

$body-tertiary-bg: {{ bodyTertiaryBg }};
$body-tertiary-color: {{ settings.style_text_color | color_modify: 'alpha', 0.5 | color_min_contrast: bodyTertiaryBg }};

$body-emphasis-color: {{ styleAccentColor }};

$link-color: {{ settings.style_link_color }};
$link-hover-color: {{ settings.style_link_color }};

$form-select-indicator: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'><path fill='none' stroke='{{ settings.style_form_text_color }}' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/></svg>");

{%- if styleElevation == 'hard' -%}
	{%- assign formInputActiveColor = styleBtnTextColor | default: settings.style_text_color -%}
{%- elsif styleAccentColorBrightness > 190 -%}
	{%- assign formInputActiveColor = settings.style_form_text_color | color_min_contrast: styleAccentColor -%}
{%- else -%}
	{%- assign formInputActiveColor = '#ffffff' | color_min_contrast: styleAccentColor -%}
{%- endif -%}

{%- if styleFormBgColorBrightness > 190 -%}
	{%- assign formInputColor = settings.style_form_text_color | color_min_contrast: styleAccentColor -%}
{%- else -%}
	{%- assign formInputColor = '#ffffff' | color_min_contrast: styleAccentColor -%}
{%- endif -%}

$form-check-input-checked-bg-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path fill='none' stroke='{{ formInputActiveColor }}' stroke-linecap='round' stroke-linejoin='round' stroke-width='3' d='m6 10 3 3 6-6'/></svg>");
$form-check-radio-checked-bg-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'><circle r='2' fill='{{ formInputActiveColor }}'/></svg>");
$form-check-input-indeterminate-bg-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 20 20'><path fill='none' stroke='{{ formInputActiveColor }}' stroke-linecap='round' stroke-linejoin='round' stroke-width='3' d='M6 10h8'/></svg>");

$form-switch-bg-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'><circle r='3' fill='{{ formInputColor }}'/></svg>");
$form-switch-focus-bg-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'><circle r='3' fill='{{ formInputColor }}'/></svg>");
$form-switch-checked-bg-image: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='-4 -4 8 8'><circle r='3' fill='{{ formInputActiveColor }}'/></svg>");

:root {
	--style-brand-color: {{ styleBrandColor | default: styleAccentColor | default: settings.style_text_color }};
	--style-accent-color: {{ styleAccentColor }};
    --style-heading-color: {{ settings.style_heading_color }};
    --style-subheading-color: {{ settings.style_subheading_color }};
    --style-overline-color: {{ settings.style_overline_color }};
    --style-text-color: {{ settings.style_text_color }};
    --style-link-color: {{ settings.style_link_color }};
    --style-icon-color: {{ settings.style_icon_color }};
    --style-border-color: {{ settings.style_border_color }};
    --style-btn-bg-color: {{ styleBtnBgColor }};
    --style-btn-text-color: {{ styleBtnTextColor }};
    --style-btn-secondary-bg-color: {{ styleBtnSecondaryBg }};
    --style-btn-secondary-text-color: {{ styleBtnSecondaryText }};
    --style-bg-color: {{ settings.style_bg_color }};
    --style-secondary-bg-color: {{ settings.style_secondary_bg_color }};
    --style-product-title-color: {{ settings.style_product_title_color }};
    --style-price-color: {{ settings.style_price_color }};
    --style-sale-price-color: {{ settings.style_sale_price_color }};
    --style-badge-bg-color: {{ settings.style_badge_bg_color }};
    --style-badge-text-color: {{ settings.style_badge_text_color | color_min_contrast: settings.style_badge_bg_color }};
    --style-new-badge-bg-color: {{ settings.style_new_badge_bg_color }};
    --style-new-badge-text-color: {{ settings.style_new_badge_text_color | color_min_contrast: settings.style_new_badge_bg_color }};
    --style-discount-badge-bg-color: {{ settings.style_discount_badge_bg_color }};
    --style-discount-badge-text-color: {{ settings.style_discount_badge_text_color | color_min_contrast: settings.style_discount_badge_bg_color }};
	--style-promotion-badge-bg-color: {{ settings.style_promotion_badge_bg_color }};
    --style-promotion-badge-text-color: {{ settings.style_promotion_badge_text_color | color_min_contrast: settings.style_promotion_badge_bg_color }};
	--style-review-icon-color: {{ settings.style_review_icon_color | default: settings.style_icon_color }};
    --style-table-bg-color: {{ settings.style_table_bg_color }};
    --style-table-text-color: {{ settings.style_table_text_color }};
    --style-table-border-color: {{ settings.style_table_border_color }};
	--style-form-bg-color: {{ settings.style_form_bg_color }};
    --style-form-text-color: {{ settings.style_form_text_color }};
    --style-form-border-color: {{ settings.style_form_border_color }};
	--style-form-surface-bg-color: {{ settings.style_form_bg_color }};
	--style-form-surface-text-color: {{ settings.style_form_text_color }};
	--style-form-surface-border-color: {{ settings.style_form_border_color }};

	{%- if styleElevation == 'hard' -%}
	--style-elevation-offset: 0.3125rem;
	--style-elevation-offset-hover: 0.375rem;
	--style-elevation-offset-pressed: 0.125rem;
	--style-elevation-press-translate: 0.125rem;
	--style-elevation-lift: -0.0625rem;
	--style-elevation-grid-size: 2rem;
	--style-elevation-motion-duration: 150ms;
	{%- endif -%}

	--style-header-bg-color: {{ settings.style_header_bg_color }};
	--style-header-text-color: {{ settings.style_header_text_color }};
	--style-header-accent-color: {{ styleHeaderAccentColor }};

	--style-announcement-bg-color: {{ styleAnnouncementBgColor }};
	--style-announcement-text-color: {{ styleAnnouncementTextColor }};

	--finqu-theme-svg-bg: {{ settings.style_bg_color }};
	--finqu-theme-svg-accent: {{ styleAccentColor }};
	{%- if styleBgColorBrightness > 128 -%}
	--finqu-theme-svg-fg: #EEEEEE;
	{%- else -%}
	--finqu-theme-svg-fg: #111111;
	{%- endif -%}
	--finqu-theme-svg-outline: {{ settings.style_text_color }};

	{%- if styleFormBgColorBrightness > 190 -%}
		--style-form-bg-hover-color: {{ settings.style_form_bg_color | color_darken: 5 }};
		--style-form-bg-disabled-color: {{ settings.style_form_bg_color | color_darken: 10 }};
	{%- else -%}
		--style-form-bg-hover-color: {{ settings.style_form_bg_color | color_lighten: 5 }};
		--style-form-bg-disabled-color: {{ settings.style_form_bg_color | color_lighten: 10 }};
	{%- endif -%}

	{%- if styleFormBorderColorBrightness > 190 -%}
		--style-form-border-focus-color: {{ settings.style_form_border_color | color_darken: 10 }};
		--style-form-border-disabled-color: {{ settings.style_form_border_color | color_darken: 10 }};
	{%- else -%}
		--style-form-border-focus-color: {{ settings.style_form_border_color | color_lighten: 10 }};
		--style-form-border-disabled-color: {{ settings.style_form_border_color | color_lighten: 10 }};
	{%- endif -%}

	{%- if styleTextColorBrightness > 190 -%}
		--style-text-accent-color: {{ settings.style_text_color | color_darken: 10 | color_min_contrast: settings.style_bg_color }};
		--style-text-muted-color: {{ settings.style_text_color | color_darken: 30 | color_min_contrast: settings.style_bg_color }};
	{%- else -%}
		--style-text-accent-color: {{ settings.style_text_color | color_lighten: 10 | color_min_contrast: settings.style_bg_color }};
		--style-text-muted-color: {{ settings.style_text_color | color_lighten: 30 | color_min_contrast: settings.style_bg_color }};
	{%- endif -%}

	{%- if styleTableBgColorBrightness > 190 -%}
		--style-table-bg-hover-color: {{ settings.style_table_bg_color | color_darken: 4 }};
	{%- else -%}
		--style-table-bg-hover-color: {{ settings.style_table_bg_color | color_lighten: 4 }};
	{%- endif -%}

	{%- if styleBgColorBrightness > 190 -%}
		--pswp-bg: #000;
		--pswp-placeholder-bg: #222;
		--pswp-icon-color: #fff;
		--swiper-theme-color: {{ styleAccentColor }};
		--swiper-btn-bg-color: {{ settings.style_bg_color }};
		--swiper-btn-color: {{ settings.style_icon_color }};
		--swiper-btn-border-color: {{ settings.style_bg_color | color_darken: 30 }};
		--swiper-pagination-bullet-color: {{ settings.style_bg_color | color_darken: 70 }};
        --swiper-pagination-bullet-active-color: {{ styleAccentColor }};
		--swiper-pagination-bullet-border-color: {{ settings.style_bg_color | color_darken: 70 }};
		--style-bg-hover-color: {{ settings.style_bg_color | color_darken: 5 }};
		--style-bg-accent-color: {{ settings.style_bg_color | color_darken: 7 }};
		--style-bg-disabled-color: {{ settings.style_bg_color | color_darken: 30 }};
	{%- else -%}
		--pswp-bg: #fff;
		--pswp-placeholder-bg: #222;
		--pswp-icon-color: #000;
		--swiper-theme-color: {{ styleAccentColor }};
		--swiper-btn-bg-color: {{ settings.style_bg_color }};
		--swiper-btn-color: {{ settings.style_icon_color }};
		--swiper-btn-border-color: {{ settings.style_bg_color | color_lighten: 30 }};
		--swiper-pagination-bullet-color: {{ settings.style_bg_color | color_lighten: 70 }};
        --swiper-pagination-bullet-active-color: {{ styleAccentColor }};
		--swiper-pagination-bullet-border-color: {{ settings.style_bg_color | color_lighten: 70 }};
		--style-bg-hover-color: {{ settings.style_bg_color | color_lighten: 5 }};
		--style-bg-accent-color: {{ settings.style_bg_color | color_lighten: 7 }};
		--style-bg-disabled-color: {{ settings.style_bg_color | color_lighten: 30 }};
	{%- endif -%}

	{%- if styleBorderColorBrightness > 190 -%}
		--style-border-accent-color: {{ settings.style_border_color | color_darken: 50 }};
	{%- else -%}
		--style-border-accent-color: {{ settings.style_border_color | color_lighten: 50 }};
	{%- endif -%}

	{%- if styleButtonBgColorColorBrightness > 190 -%}
		--style-btn-bg-active-color: {{ styleBtnBgColor | color_darken: 10 }};
		--style-btn-bg-hover-color: {{ styleBtnBgColor | color_darken: 8 }};
		--style-btn-border-hover-color: {{ styleBtnBgColor | color_darken: 8 }};
		--style-btn-border-active-color: {{ styleBtnBgColor | color_darken: 13 }};
	{%- else -%}
		--style-btn-bg-active-color: {{ styleBtnBgColor | color_lighten: 10 }};
		--style-btn-bg-hover-color: {{ styleBtnBgColor | color_lighten: 8 }};
		--style-btn-border-hover-color: {{ styleBtnBgColor | color_lighten: 8 }};
		--style-btn-border-active-color: {{ styleBtnBgColor | color_lighten: 13 }};
	{%- endif -%}

	{%- if styleButtonSecondaryBgColorBrightness > 190 -%}
		--style-btn-secondary-bg-active-color: {{ styleBtnSecondaryBg | color_darken: 10 }};
		--style-btn-secondary-bg-hover-color: {{ styleBtnSecondaryBg | color_darken: 8 }};
		--style-btn-secondary-border-hover-color: {{ styleBtnSecondaryBg | color_darken: 8 }};
		--style-btn-secondary-border-active-color: {{ styleBtnSecondaryBg | color_darken: 13 }};
	{%- else -%}
		--style-btn-secondary-bg-active-color: {{ styleBtnSecondaryBg | color_lighten: 10 }};
		--style-btn-secondary-bg-hover-color: {{ styleBtnSecondaryBg | color_lighten: 8 }};
		--style-btn-secondary-border-hover-color: {{ styleBtnSecondaryBg | color_lighten: 8 }};
		--style-btn-secondary-border-active-color: {{ styleBtnSecondaryBg | color_lighten: 13 }};
	{%- endif -%}

	{%- if styleAccentColorBrightness > 190 -%}
		--style-accent-text-color: {{ '#000000' | color_min_contrast: styleAccentColor }}
	{%- else -%}
		--style-accent-text-color: {{ '#ffffff' | color_min_contrast: styleAccentColor }}
	{%- endif -%}

	--pswp-icon-stroke-width: 0px;
	--pswp-icon-stroke-color: transparent;
	--pswp-preloader-color-secondary: transparent;
	--pswp-icon-color-secondary: transparent;

	--style-bg-light-color: {{ settings.style_bg_color | color_lighten: 35 }};
	--style-border-focus-color: {{ settings.style_border_color | color_lighten: 25 }};
	--style-btn-border-color: {{ styleBtnBgColor }};
	--style-btn-secondary-border-color: {{ styleBtnSecondaryBg }};

	--style-form-placeholder-color: {{ settings.style_form_text_color | color_lighten: 15 }};
	--style-form-bg-readonly-color: {{ settings.style_form_bg_color | color_lighten: 15 }};
	--style-text-darker-color: {{ settings.style_text_color | color_darken: 5 | color_min_contrast: settings.style_bg_color }};
	--style-accent-faded-color: {{ styleAccentColor | color_lighten: 30 }};

	{%- if settings.style_header_bg_color == settings.style_bg_color -%}
		--style-submenu-accent-color: {{ styleHeaderAccentColor }};
	{%- else -%}
		--style-submenu-accent-color: {{ styleAccentColor | color_min_contrast: settings.style_bg_color }};
	{%- endif -%}

	--style-loader-color: {{ settings.style_icon_color }};
	--style-loader-faded-color: {{ settings.style_icon_color | color_modify: 'alpha', 0.1 | color_min_contrast: settings.style_bg_color }};

	--style-border-radius: {{ styleBorderRadiusGlobal }};
	--style-btn-border-radius: {{ styleButtonBorderRadius }};
	--style-input-border-radius: {{ styleInputBorderRadius }};
	--style-component-border-radius: {{ styleBorderRadiusGlobal }};
	--style-image-border-radius: {{ styleImageBorderRadius }};
	--style-product-image-border-radius: {{ styleImageBorderRadius }};

	--style-announcement-height: {{ settings.styleAnnouncementHeight }};
	--style-announcement-font-scale: {{ settings.styleAnnouncementFontScale }};

	--style-grid-container-padding-x: {{ settings.styleGridContainerPaddingX }};
	--style-grid-gutter-width: {{ settings.styleGridGutterWidth }};
	--style-grid-gutter-width-mobile: {{ settings.styleGridGutterWidth | replace: 'rem', '' | times: 0.5 | append: 'rem' }};

	{%- assign iconStrokeWidthValue = settings.styleIconStrokeWidth | replace: 'px', '' -%}
	{%- if styleElevation == 'hard' -%}
		--style-icon-stroke-width: {{ iconStrokeWidthValue | times: 1.5 | append: 'px' }};
		--style-underline-indicator-height: 3px;
	{%- else -%}
		--style-icon-stroke-width: {{ settings.styleIconStrokeWidth }};
		--style-underline-indicator-height: 2px;
	{%- endif -%}

	{%- if settings.navigationFontWeight > 400 or styleElevation == 'hard' -%}
		{%- assign navIconStrokeMultiplier = 1.5 -%}
		{%- if styleElevation == 'hard' -%}
			{%- assign navIconStrokeMultiplier = 1.85 -%}
		{%- endif -%}
		--style-navigation-icon-stroke-width: {{ iconStrokeWidthValue | times: navIconStrokeMultiplier | append: 'px' -}};
	{%- else -%}
		--style-navigation-icon-stroke-width: var(--style-icon-stroke-width);
	{%- endif -%}

	--style-navigation-submenu-font-scale: {{ settings.navigationSubmenuFontScale | default: '1' }};

	@each $key, $val in $spacers {
		--style-spacer-#{$key}: #{$val};
	}

	@each $key, $val in $container-max-widths {
		--style-container-max-width-#{$key}: #{$val};
	}

	@each $key, $val in $container-custom-max-widths {
		--style-container-max-width-#{$key}: #{$val};
	}

	@each $key, $val in $grid-breakpoints {
		--style-grid-breakpoint-#{$key}: #{$val};
	}
}

@import "scss/theme";