{%- assign truncateLength = block.settings.truncateLength | default: 140 -%}

<div class="article-content">

	{%- if article and article.summary -%}

		<p class="article-content-text mb-0">
			{{- article.summary -}}
		</p>

	{%- else -%}

		<p class="article-content-text mb-0">

			{%- if article and article.content -%}
				{{- article.content | strip_html | truncate: truncateLength -}}
			{%- elsif request.design_mode -%}
				{{- 'placeholder.article_summary' | t -}}
			{%- endif -%}

		</p>

	{%- endif -%}

</div>

{% schema %}
{
    "name": "t:blocks.article-excerpt.name",
    "tag": "div",
    "class": "block block-article-excerpt",
    "category": "basic",
    "private": true,
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.style.title",
                "id": "style",
                "settings": [
                    {
                        "id": "truncateLength",
                        "type": "range",
                        "label": "t:blocks.article-excerpt.settings.truncateLength.label",
                        "min": 40,
                        "max": 300,
                        "step": 10,
                        "default": 140,
                        "unit": " "
                    }
                ]
            }
        ]
    }
}
{% endschema %}
