{%- assign buttonGap = block.settings.buttonGap -%}
{%- if buttonGap == 'nil' -%}
    {%- assign buttonGap = '1rem' -%}
{%- endif -%}

{%- capture blockStyle -%}
    #finqu-block-{{ block.id }} .block-inner {
        display: flex;
        justify-content: {%- if block.settings.contentAlign == 'nil' -%}var(--section-text-align){%- else -%}{{ block.settings.contentAlign }}{%- endif -%};
    }
    #finqu-block-{{ block.id }} .button-group-items {
        display: flex;
        flex-flow: column wrap;
        gap: {{ buttonGap }};
        justify-content: inherit;
        width: 100%;
    }
    @media screen and (min-width: {{ settings.styleGridBreakpointMd }}) {
        #finqu-block-{{ block.id }} .button-group-items {
            flex-direction: row;
            align-items: center;
        }
    }
{%- endcapture -%}

<style>{{ blockStyle | strip | replace: '  ', '' | strip_newlines }}</style>

<div class="block-inner">

    <div class="button-group-items">

        {%- for button in block.settings.setting_blocks.buttons -%}

            {%- assign btnLabel = button.settings.btnLink.text -%}
            {%- if btnLabel == blank and request.design_mode == 'edit' -%}
                {%- assign btnLabel = 'placeholder.label' | t -%}
            {%- endif -%}

            {%- render 'section-quick-link', theme: button.settings.btnTheme, variant: button.settings.btnVariant, size: button.settings.btnSize, text: btnLabel, url: button.settings.btnLink.url, target: button.settings.btnLink.target  -%}

        {%- endfor -%}

    </div>

</div>

