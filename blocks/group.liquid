{%- capture blockStyle -%}
    #finqu-block-{{ block.id }} .block-inner {
        container-type: inline-size;
    }
    #finqu-block-{{ block.id }} .block-grid {
        display: grid;
        {%- if block.settings.columns == '2' -%}
            grid-template-columns: {{ block.settings.columnLeftWidth }}fr {{ block.settings.columnRightWidth }}fr;
        {%- else -%}
            grid-template-columns: repeat({{ block.settings.columns }}, 1fr);
        {%- endif -%}
        gap: {{ block.settings.gap }}rem;
        align-items: {{ block.settings.verticalAlign }};
    }
    @container (max-width: 768px) {
        #finqu-block-{{ block.id }} .block-grid {
            grid-template-columns: repeat({{ block.settings.columnsMobile }}, 1fr);
        }
    }
    {%- if block.settings.columns == '2' and block.settings.reverseOrder -%}
        #finqu-block-{{ block.id }} .block-grid {
            direction: rtl;
        }
        #finqu-block-{{ block.id }} .block-grid > * {
            direction: ltr;
        }
    {%- endif -%}
{%- endcapture -%}

<style>{{ blockStyle | strip | replace: '  ', '' | strip_newlines }}</style>

<div class="block-inner">

    <div class="block-grid">

        <div class="block-grid-col">
            {% container 'column-1' %}
        </div>

        <div class="block-grid-col">
            {% container 'column-2' %}
        </div>

        {%- if block.settings.columns >= '3' -%}
            <div class="block-grid-col">
                {% container 'column-3' %}
            </div>
        {%- endif -%}

        {%- if block.settings.columns >= '4' -%}
            <div class="block-grid-col">
                {% container 'column-4' %}
            </div>
        {%- endif -%}

    </div>

</div>

