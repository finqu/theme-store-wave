{%- assign title = block.settings.title -%}

{%- assign headingTitleClass = nil -%}
{%- case block.settings.titleStyle -%}
    {%- when 'h1' -%}
        {%- assign headingTitleClass = 'h1' -%}
    {%- when 'h2' -%}
        {%- assign headingTitleClass = 'h2' -%}
    {%- when 'h3' -%}
        {%- assign headingTitleClass = 'h3' -%}
    {%- when 'display' -%}
        {%- assign headingTitleClass = 'display-4' -%}
    {%- when 'display-1' -%}
        {%- assign headingTitleClass = 'display-1' -%}
    {%- when 'display-2' -%}
        {%- assign headingTitleClass = 'display-2' -%}
    {%- when 'display-3' -%}
        {%- assign headingTitleClass = 'display-3' -%}
    {%- when 'display-4' -%}
        {%- assign headingTitleClass = 'display-4' -%}
    {%- when 'display-5' -%}
        {%- assign headingTitleClass = 'display-5' -%}
    {%- when 'display-6' -%}
        {%- assign headingTitleClass = 'display-6' -%}
    {%- when 'text' -%}
        {%- assign headingTitleClass = 'fs-reset' -%}
{%- endcase -%}

{%- assign headingOverlineClass = nil -%}
{%- case block.settings.overlineStyle -%}
    {%- when 'h1' -%}
        {%- assign headingOverlineClass = 'h1' -%}
    {%- when 'h2' -%}
        {%- assign headingOverlineClass = 'h2' -%}
    {%- when 'h3' -%}
        {%- assign headingOverlineClass = 'h3' -%}
    {%- when 'display' -%}
        {%- assign headingOverlineClass = 'display-4' -%}
    {%- when 'display-1' -%}
        {%- assign headingOverlineClass = 'display-1' -%}
    {%- when 'display-2' -%}
        {%- assign headingOverlineClass = 'display-2' -%}
    {%- when 'display-3' -%}
        {%- assign headingOverlineClass = 'display-3' -%}
    {%- when 'display-4' -%}
        {%- assign headingOverlineClass = 'display-4' -%}
    {%- when 'display-5' -%}
        {%- assign headingOverlineClass = 'display-5' -%}
    {%- when 'display-6' -%}
        {%- assign headingOverlineClass = 'display-6' -%}
    {%- when 'text' -%}
        {%- assign headingOverlineClass = 'fs-reset' -%}
{%- endcase -%}

{%- assign headingSubtitleClass = nil -%}
{%- case block.settings.subtitleStyle -%}
    {%- when 'h1' -%}
        {%- assign headingSubtitleClass = 'h1' -%}
    {%- when 'h2' -%}
        {%- assign headingSubtitleClass = 'h2' -%}
    {%- when 'h3' -%}
        {%- assign headingSubtitleClass = 'h3' -%}
    {%- when 'display' -%}
        {%- assign headingSubtitleClass = 'display-4' -%}
    {%- when 'display-1' -%}
        {%- assign headingSubtitleClass = 'display-1' -%}
    {%- when 'display-2' -%}
        {%- assign headingSubtitleClass = 'display-2' -%}
    {%- when 'display-3' -%}
        {%- assign headingSubtitleClass = 'display-3' -%}
    {%- when 'display-4' -%}
        {%- assign headingSubtitleClass = 'display-4' -%}
    {%- when 'display-5' -%}
        {%- assign headingSubtitleClass = 'display-5' -%}
    {%- when 'display-6' -%}
        {%- assign headingSubtitleClass = 'display-6' -%}
    {%- when 'text' -%}
        {%- assign headingSubtitleClass = 'fs-reset' -%}
{%- endcase -%}

{%- assign titleEscaped = title | escape -%}
{%- assign emphasisText = block.settings.emphasisText | strip -%}

{%- if emphasisText != blank -%}
    {%- assign emphasisTextEscaped = emphasisText | escape -%}
    {%- assign emphasisDecoration = block.settings.emphasisStyle -%}
    {%- if emphasisDecoration == 'accent' or emphasisDecoration == 'underline-thick' or emphasisDecoration == 'underline-wavy' -%}
        {%- assign emphasisDecoration = 'nil' -%}
    {%- endif -%}
    {%- assign emphasisColorSetting = block.settings.emphasisColor -%}
    {%- assign emphasisIsGradient = false -%}
    {%- if emphasisColorSetting.mode and emphasisColorSetting.mode != 'solid' -%}
        {%- assign emphasisIsGradient = true -%}
    {%- endif -%}
    {%- capture emphasisClass -%}title-emphasis{%- if block.settings.emphasisLayout == 'new-line' %} title-emphasis--block{% endif -%}{%- endcapture -%}
    {%- capture emphasisTextClass -%}title-emphasis__text{%- if emphasisDecoration != blank and emphasisDecoration != 'nil' %} title-emphasis--{{ emphasisDecoration }}{% endif -%}{%- endcapture -%}
    {%- capture emphasisPaintClass -%}title-emphasis__paint{%- unless block.settings.emphasisAccentFont == false %} text-style-accent{% endunless %}{%- if emphasisIsGradient %} title-emphasis--gradient{% endif -%}{%- endcapture -%}
    {%- capture emphasisMarkup -%}<span class="{{ emphasisClass }}"><span class="{{ emphasisTextClass }}"><span class="{{ emphasisPaintClass }}">{{ emphasisTextEscaped }}</span></span></span>{%- endcapture -%}
    {%- assign titleEscaped = titleEscaped | replace_first: emphasisTextEscaped, emphasisMarkup -%}
{%- endif -%}

{%- capture blockStyle -%}
    #finqu-block-{{ block.id }} .block-inner {
        --section-header-text-align: {%- if block.settings.textAlign == 'nil' -%}var(--section-text-align){%- else -%}{{ block.settings.textAlign }}{%- endif -%};
    }
    {%- if block.settings.overlineColor -%}
        #finqu-block-{{ block.id }} .overline {
            --style-overline-color: {{ block.settings.overlineColor }};
        }
    {%- endif -%}
    {%- if block.settings.subtitleColor -%}
        #finqu-block-{{ block.id }} .subtitle {
            --style-subheading-color: {{ block.settings.subtitleColor }};
        }
    {%- endif -%}
    {%- if block.settings.emphasisColor -%}
        {%- assign emphasisColorSetting = block.settings.emphasisColor -%}
        {%- assign emphasisColorPaint = emphasisColorSetting.string_value | default: emphasisColorSetting -%}
        #finqu-block-{{ block.id }} .title-emphasis {
            --style-heading-emphasis-color: {{ emphasisColorPaint }};
            {%- if emphasisColorSetting.mode and emphasisColorSetting.mode != 'solid' -%}
                --style-heading-emphasis-paint: {{ emphasisColorPaint }};
                {%- assign emphasisColorFirstStop = emphasisColorSetting.stops | first -%}
                {%- if emphasisColorFirstStop.color -%}
                    {%- assign emphasisColorSolid = emphasisColorFirstStop.color -%}
                    {%- if emphasisColorFirstStop.alpha -%}
                        {%- assign emphasisColorSolid = emphasisColorSolid | color_modify: 'alpha', emphasisColorFirstStop.alpha -%}
                    {%- endif -%}
                    --style-heading-emphasis-solid: {{ emphasisColorSolid }};
                {%- endif -%}
            {%- else -%}
                --style-heading-emphasis-solid: {{ emphasisColorPaint }};
            {%- endif -%}
        }
    {%- endif -%}
    {%- if block.settings.emphasisBgColor -%}
        {%- assign emphasisBgColorSetting = block.settings.emphasisBgColor -%}
        {%- assign emphasisBgColorPaint = emphasisBgColorSetting.string_value | default: emphasisBgColorSetting -%}
        #finqu-block-{{ block.id }} .title-emphasis {
            {%- if emphasisBgColorSetting.mode and emphasisBgColorSetting.mode != 'solid' -%}
                --style-heading-emphasis-bg-paint: {{ emphasisBgColorPaint }};
                {%- assign emphasisBgColorFirstStop = emphasisBgColorSetting.stops | first -%}
                {%- if emphasisBgColorFirstStop.color -%}
                    {%- assign emphasisBgColorSolid = emphasisBgColorFirstStop.color -%}
                    {%- if emphasisBgColorFirstStop.alpha -%}
                        {%- assign emphasisBgColorSolid = emphasisBgColorSolid | color_modify: 'alpha', emphasisBgColorFirstStop.alpha -%}
                    {%- endif -%}
                    --style-heading-emphasis-bg: {{ emphasisBgColorSolid }};
                {%- endif -%}
            {%- else -%}
                --style-heading-emphasis-bg: {{ emphasisBgColorPaint }};
            {%- endif -%}
        }
    {%- endif -%}
    {%- assign headingLineHeight = block.settings.titleLineHeight -%}
    {%- if headingLineHeight == 'custom' -%}
        {%- assign headingLineHeight = block.settings.titleLineHeightCustom -%}
    {%- endif -%}
    {%- if headingLineHeight and headingLineHeight != 'nil' -%}
        #finqu-block-{{ block.id }} .title {
            line-height: {{ headingLineHeight }};
        }
    {%- endif -%}
{%- endcapture -%}

<style>{{ blockStyle | strip | replace: '  ', '' | strip_newlines }}</style>

<div class="block-inner">

    {%- render 'section-header', sectionOverline: block.settings.overline, sectionOverlineTag: block.settings.overlineTag, sectionOverlineClass: headingOverlineClass, sectionTitle: titleEscaped, sectionTitleTag: block.settings.titleTag, sectionTitleClass: headingTitleClass, sectionSubtitle: block.settings.subtitle, sectionSubtitleTag: block.settings.subtitleTag, sectionSubtitleClass: headingSubtitleClass, sectionHeaderContainer: 'none', sectionHeaderFontSizeScale: block.settings.sectionHeaderFontSizeScale -%}

