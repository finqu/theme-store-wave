
{%- if product -%}
    {%- if store.customer_has_purchase_right == false or product.default_or_selected_variant.in_preview -%}
        {%- assign showStockBalance = false -%}
    {%- else -%}
        {%- assign showStockBalance = true -%}
    {%- endif -%}
{%- else -%}
    {%- assign showStockBalance = false -%}
{%- endif -%}

{%- if product and showStockBalance -%}

    <div class="product-stock-balance{% if block.settings.style == 'badge' %} product-stock-balance--badge{% endif %}">

        {%- if product.default_or_selected_variant.is_out_of_stock -%}

            <span class="product-stock-balance-out-of-stock">
                {{- 'product.out_of_stock' | t -}}
            </span>

        {%- elsif product.default_or_selected_variant.is_low_on_stock and product.default_or_selected_variant.stock and product.default_or_selected_variant.inventory_policy == 'deny' -%}

            <span class="product-stock-balance-low-on-stock">
                {{- 'product.low_on_stock_dynamic' | t: amount: product.default_or_selected_variant.stock -}}
            </span>

        {%- elsif product.default_or_selected_variant.stock < 1 and product.default_or_selected_variant.inventory_policy == 'continue' -%}

            <span class="product-stock-balance-backorder">
                {{- 'product.backorder' | t -}}
            </span>

        {%- else -%}

            <span class="product-stock-balance-in-stock">

                {%- if block.settings.showAsNumber and product.default_or_selected_variant.stock -%}
                    {{- 'product.in_stock_dynamic' | t: amount: product.default_or_selected_variant.stock, unit: product.default_or_selected_variant.unit -}}
                {%- else -%}
                    {{- 'product.in_stock' | t -}}
                {%- endif -%}

            </span>

        {%- endif -%}

    </div>

{%- endif -%}

{% schema %}
{
    "name": "t:blocks.product-inventory.name",
    "tag": "div",
    "class": "block block-product-inventory",
    "category": "commerce",
    "private": true,
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.style.title",
                "settings": [
                    {
                        "id": "showAsNumber",
                        "type": "checkbox",
                        "label": "t:blocks.product-inventory.settings.showAsNumber.label",
                        "default": false
                    },
                    {
                        "id": "style",
                        "type": "radio-pill",
                        "label": "t:blocks.product-inventory.settings.style.label",
                        "default": "text",
                        "options": [
                            {
                                "value": "text",
                                "label": "t:blocks.product-inventory.settings.style.options.text.label"
                            },
                            {
                                "value": "badge",
                                "label": "t:blocks.product-inventory.settings.style.options.badge.label"
                            }
                        ]
                    }
                ],
                "id": "style"
            }
        ]
    }
}
{% endschema %}
