{%- assign showStockBalanceAsNumber = block.settings.showAsNumber -%}

{%- comment -%}
    Label rows pair availability with an "Availability:" column — used when this
    block sits in the product form's details container rather than on its own in
    the info column.
{%- endcomment -%}
{%- assign useLabel = block.settings.showLabel -%}

{% if store.customer_has_purchase_right %}

    <div class="mb-4{% if useLabel %} product-stock-balance{% endif %}">

        {% if useLabel %}

            <label class="form-label fw-bold me-2 d-block d-md-inline-block min-w-px-100">
                {{- 'product.stock_balance_available' | t -}}:
            </label>

        {% endif %}

        {%- if product.default_or_selected_variant.is_out_of_stock -%}

            <span class="product-stock-balance-out-of-stock">
                {{- 'product.out_of_stock' | t -}}
            </span>

        {%- elsif product.default_or_selected_variant.is_low_on_stock and product.default_or_selected_variant.stock and product.default_or_selected_variant.inventory_policy == 'deny' -%}

            <span class="product-stock-balance-low-on-stock">
                {{- 'product.low_on_stock_dynamic' | t: amount: product.default_or_selected_variant.stock -}}
            </span>

        {%- elsif product.default_or_selected_variant.stock < 1 and product.default_or_selected_variant.inventory_policy == 'continue' -%}

            <span class="product-stock-balance-backorder">
                {{- 'product.backorder' | t -}}
            </span>

        {%- else -%}

            <span class="product-stock-balance-in-stock">

                {%- if showStockBalanceAsNumber and product.default_or_selected_variant.stock -%}
                    {{- 'product.in_stock_dynamic' | t: amount: product.default_or_selected_variant.stock, unit: product.default_or_selected_variant.unit -}}
                {%- else -%}
                    {{- 'product.in_stock' | t -}}
                {%- endif -%}

            </span>

        {%- endif -%}

    </div>

{% endif %}

{% schema %}
{
    "name": "t:blocks.product-page-inventory.name",
    "tag": "div",
    "class": "block block-product-page-inventory",
    "category": "commerce",
    "private": true,
    "templates": [
        "product"
    ],
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.style.title",
                "settings": [
                    {
                        "id": "showAsNumber",
                        "type": "checkbox",
                        "label": "t:blocks.product-page-inventory.settings.showAsNumber.label",
                        "default": false
                    },
                    {
                        "id": "showLabel",
                        "type": "checkbox",
                        "label": "t:all.settings.showLabel.label",
                        "default": false
                    }
                ],
                "id": "style"
            }
        ]
    }
}
{% endschema %}
