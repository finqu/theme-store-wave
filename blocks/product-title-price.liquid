{%- assign showPrice = block.settings.showPrice -%}

{%- assign truncateName = productCardTruncateName | default: block.settings.truncateName | default: true -%}
{%- assign linkToProduct = productCardLinkToProduct | default: block.settings.linkToProduct | default: true -%}

{%- assign productName = product.title | default: '' -%}

{%- unless product -%}
    {%- assign productName = 'placeholder.product' | t -%}
{%- endunless -%}

{%- if product -%}
    {%- if store.customer_has_purchase_right == false or product.default_or_selected_variant.in_preview -%}
        {%- assign showPrice = false -%}
    {%- endif -%}
{%- endif -%}

{%- capture productUrl -%}
    {%- assign resolvedUrl = product | link | default: '' -%}
    {%- if resolvedUrl contains 'section=' -%}
        {%- assign urlParts = resolvedUrl | split: '?' -%}
        {%- if urlParts[1] -%}
            {%- assign basePath = urlParts[0] -%}
            {%- assign newUrl = basePath | append: '?' -%}
            {%- assign queryParams = resolvedUrl | query_params -%}
            {%- for param in queryParams -%}
                {%- if param[0] != 'section' -%}
                    {%- if forloop.first -%}
                        {%- assign newUrl = newUrl | append: param[0] | append: '=' | append: param[1] -%}
                    {%- else -%}
                        {%- assign newUrl = newUrl | append: '&' | append: param[0] | append: '=' | append: param[1] -%}
                    {%- endif -%}
                {%- endif -%}
            {%- endfor -%}
            {%- assign resolvedUrl = newUrl -%}
        {%- endif -%}
    {%- endif -%}
    {{- resolvedUrl -}}
{%- endcapture -%}

{%- capture titleMarkup -%}

    {%- if block.settings.showTitle -%}

        <div class="product-name">

            <h3 class="product-name-text text-product-title{% if truncateName %} text-truncate{% endif %}">
                {{- productName -}}
            </h3>

        </div>

    {%- endif -%}

{%- endcapture -%}

{%- capture priceMarkup -%}

    {%- if showPrice -%}

        {%- assign productPrice = product.default_or_selected_variant.price | default: '' -%}
        {%- assign productNetPrice = product.default_or_selected_variant.net_price | default: '' -%}
        {%- assign productOriginalNetPrice = product.default_or_selected_variant.original_net_price | default: '' -%}
        {%- assign productOriginalPrice = product.default_or_selected_variant.original_price | default: '' -%}
        {%- assign productHasDiscount = false -%}

        {%- if product and product.default_or_selected_variant.discount_information != nil -%}
            {%- assign productHasDiscount = true -%}
        {%- endif -%}

        {%- unless product -%}
            {%- assign productHasDiscount = 'true,false' | split: ',' | random -%}
            {%- assign productPriceValues = '4.90,10.50,24.90,39.90,54.90,74.90,80.90,99.90,124.90' | split: ',' -%}

            {%- if productHasDiscount == 'true' -%}
                {%- assign productHasDiscount = true -%}
                {%- assign productOriginalPrice = productPriceValues | random -%}
                {%- assign productOriginalNetPrice = productOriginalPrice -%}
                {%- assign productPrice = productOriginalPrice | times: 0.75 -%}
                {%- assign productNetPrice = productPrice -%}
            {%- else -%}
                {%- assign productHasDiscount = false -%}
                {%- assign productPrice = productPriceValues | random -%}
                {%- assign productNetPrice = productPrice -%}
            {%- endif -%}
        {%- endunless -%}

        <div class="product-price">

            {%- if productHasDiscount -%}

                <span class="text-sale-price me-2">
                    {{- settings.taxFreeShopping | yepnope: productNetPrice, productPrice | money_with_currency -}}
                </span>

                <span class="text-decoration-line-through text-muted">
                    {{- settings.taxFreeShopping | yepnope: productOriginalNetPrice, productOriginalPrice | money_with_currency -}}
                </span>

            {%- else -%}

                <span class="text-price">
                    {{- settings.taxFreeShopping | yepnope: productNetPrice, productPrice | money_with_currency -}}
                </span>

            {%- endif -%}

            {%- if block.settings.showPromotion and product.default_or_selected_variant.promotion -%}

                <div class="product-promotion mt-1">

                    <span class="text-sale-price small">
                        {{- product.default_or_selected_variant.promotion.title | strip -}}{% if product.default_or_selected_variant.promotion.description %}: {{ product.default_or_selected_variant.promotion.description -}}{%- endif -%}
                    </span>

                </div>

            {%- endif -%}

        </div>

    {%- endif -%}

{%- endcapture -%}

{%- if block.settings.showTitle or showPrice -%}

    <div class="product-title-price{% if block.settings.layout == 'same-line' %} product-title-price--inline{% endif %}">

        {%- if block.settings.layout == 'same-line' -%}

            <div class="product-title-price-start">
                {%- if linkToProduct and product and productUrl != blank and block.settings.showTitle -%}
                    <a href="{{ productUrl | strip }}" aria-label="{{ productName }}">{{ titleMarkup }}</a>
                {%- else -%}
                    {{- titleMarkup -}}
                {%- endif -%}
            </div>

            <div class="product-title-price-end">
                {{- priceMarkup -}}
            </div>

        {%- else -%}

            {%- if linkToProduct and product and productUrl != blank and block.settings.showTitle -%}
                <a href="{{ productUrl | strip }}" aria-label="{{ productName }}">{{ titleMarkup }}</a>
            {%- else -%}
                {{- titleMarkup -}}
            {%- endif -%}

            {{- priceMarkup -}}

        {%- endif -%}

    </div>

{%- endif -%}

{% schema %}
{
    "name": "t:blocks.product-title-price.name",
    "tag": "div",
    "class": "block block-product-title-price",
    "category": "commerce",
    "private": true,
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.content.title",
                "settings": [
                    {
                        "id": "showTitle",
                        "type": "checkbox",
                        "label": "t:blocks.product-title-price.settings.showTitle.label",
                        "default": true
                    },
                    {
                        "id": "showPrice",
                        "type": "checkbox",
                        "label": "t:blocks.product-title-price.settings.showPrice.label",
                        "default": true
                    },
                    {
                        "id": "layout",
                        "type": "radio-pill",
                        "label": "t:blocks.product-title-price.settings.layout.label",
                        "default": "stacked",
                        "info": "t:blocks.product-title-price.settings.layout.info",
                        "options": [
                            {
                                "value": "stacked",
                                "label": "t:blocks.product-title-price.settings.layout.options.stacked.label"
                            },
                            {
                                "value": "same-line",
                                "label": "t:blocks.product-title-price.settings.layout.options.same-line.label"
                            }
                        ]
                    }
                ],
                "id": "content"
            },
            {
                "title": "t:all.groups.style.title",
                "settings": [
                    {
                        "id": "truncateName",
                        "type": "checkbox",
                        "label": "t:all.settings.truncateName.label",
                        "default": true,
                        "conditions": [
                            "!showTitle eq false"
                        ]
                    },
                    {
                        "id": "linkToProduct",
                        "type": "checkbox",
                        "label": "t:blocks.product-title-price.settings.linkToProduct.label",
                        "default": true,
                        "conditions": [
                            "!showTitle eq false"
                        ]
                    },
                    {
                        "id": "showPromotion",
                        "type": "checkbox",
                        "label": "t:all.settings.showPromotion.label",
                        "default": false,
                        "conditions": [
                            "!showPrice eq false"
                        ]
                    }
                ],
                "id": "style"
            }
        ]
    }
}
{% endschema %}
