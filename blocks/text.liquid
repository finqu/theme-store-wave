{%- capture blockStyle -%}
    #finqu-block-{{ block.id }} img {
        border-radius: var(--style-image-border-radius);
    }
{%- endcapture -%}

<style>{{ blockStyle | strip | replace: '  ', '' | strip_newlines }}</style>

<div class="block-inner text-break text-richtext">{{ block.settings.richtext }}</div>

{% schema %}
{
    "name": "t:blocks.text.name",
    "tag": "div",
    "class": "block block-text",
    "category": "basic",
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.content.title",
                "settings": [
                    {
                        "id": "richtext",
                        "type": "richtext",
                        "label": "t:blocks.text.settings.richtext.label",
                        "size": "lg"
                    }
                ],
                "id": "content"
            }
        ]
    }
}
{% endschema %}
