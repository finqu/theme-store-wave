{%- if section.settings.announcementVisibility == 'frontpage' and request.page_type == 'frontpage' -%}
    {%- assign announcementIsVisible = true -%}
{% elsif section.settings.announcementVisibility == 'all' %}
    {%- assign announcementIsVisible = true -%}
{%- else -%}
    {%- assign announcementIsVisible = false -%}
{%- endif -%}

{%- capture sectionStyle -%}
    #finqu-section-{{ section.id }} {
        --style-announcement-align: {%- if section.settings.announcementTextAlign == 'nil' -%}{{ settings.sectionTextAlign }}{%- else -%}{{ section.settings.announcementTextAlign }}{%- endif -%};
        {%- render 'header-bar-bg', barBgColor: section.settings.barBgColor -%}
    }
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{% if announcementIsVisible or request.design_mode == 'edit' -%}

    {%- capture slides -%}

        {%- for item in section.settings.setting_blocks.items -%}

            {%- assign announcement_link_text = item.settings.announcementLink.text -%}
            {%- assign announcement_text = '' -%}

            {%- if announcement_link_text.key != blank -%}
                {%- assign announcement_text = announcement_link_text.key | t -%}
                {%- if announcement_text == blank or announcement_text == announcement_link_text.key -%}
                    {%- if announcement_link_text.string_value != blank -%}
                        {%- assign announcement_text = announcement_link_text.string_value -%}
                    {%- endif -%}
                {%- endif -%}
            {%- elsif announcement_link_text.string_value != blank -%}
                {%- assign announcement_text = announcement_link_text.string_value -%}
            {%- elsif announcement_link_text contains 'frontpage_presets.' -%}
                {%- assign announcement_text = announcement_link_text | t -%}
            {%- elsif announcement_link_text != blank -%}
                {%- assign announcement_text = announcement_link_text -%}
            {%- endif -%}

            {%- if announcement_text != blank -%}

            <div class="swiper-slide">

                <div class="swiper-slide-inner container">

                    {% if item.settings.announcementLink.url %}

                        <a
                            href="{{- item.settings.announcementLink.url -}}"
                            class="site-announcement-text"
                            target="{{- item.settings.announcementLink.target -}}">

                            {{ announcement_text }}

                        </a>

                    {% else %}

                        <span class="site-announcement-text">

                            {{ announcement_text }}

                        </span>

                    {% endif %}

                </div>

            </div>

            {%- endif -%}

        {%- endfor -%}

    {%- endcapture -%}
    {%- assign slides = slides | strip -%}

    {%- if section.settings.setting_blocks.items.size > 1 -%}
        {%- assign autoplaySpeed = section.settings.carouselAutoplaySpeed -%}
    {%- else -%}
        {%- assign autoplaySpeed = 0 -%}
    {%- endif -%}

    {%- if slides != blank -%}

        <div class="site-header-bar site-announcement-container">

            <div class="site-announcement">

                {%- render 'swiper', slides: slides, slidesPerView: 1, style: 1, evenHeightSlides: true, standalone: true, class: 'w-100', noSwiping: true, autoplaySpeed: autoplaySpeed, loop: true, speed: 700, slidesGap: '0' -%}

            </div>

        </div>

    {%- endif -%}

{% endif %}

{% schema %}
{
