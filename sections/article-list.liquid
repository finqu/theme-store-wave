{%- unless section.settings.sectionQuickLinkResource.url -%}
    {%- assign quickLinkUrl = routes.blog_url -%}
{%- endunless -%}

{%- capture sectionAction -%}
    {% render 'section-quick-link', section: section, url: quickLinkUrl %}
{%- endcapture -%}
{%- assign sectionAction = sectionAction | strip -%}

{%- capture sectionHeaderBlocks -%}
    {% container 'header' %}
{%- endcapture -%}
{%- assign sectionHeaderBlocks = sectionHeaderBlocks | strip -%}

{%- capture sectionHeaderContent -%}
    {%- if sectionHeaderBlocks != blank or sectionAction != blank -%}
        <div class="section-header">
            <div class="container">
                <div class="d-flex align-items-end justify-content-between gap-g flex-wrap">
                    <div class="flex-grow-1 min-w-0">
                        {{- sectionHeaderBlocks -}}
                    </div>
                    {%- if sectionAction != blank -%}
                        <div class="section-action">
                            {{- sectionAction -}}
                        </div>
                    {%- endif -%}
                </div>
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture sectionContent -%}

    {%- case section.settings.listType -%}
        {% when 'recent' %}
            {%- assign items = blog.recent -%}
        {% when 'last-updated' %}
            {%- assign items = blog.last_updated -%}
        {% when 'all' %}
            {%- assign items = blog.articles -%}
    {%- endcase -%}

    {%- assign items = items | slice: 0, section.settings.itemAmount -%}

    {% render 'article-list-grid', items: items, item_amount: section.settings.itemAmount, article_per_row: section.settings.articlePerRow, section_id: section.id, section: section %}

{%- endcapture -%}

{% render 'section', section: section, sectionHeaderContent: sectionHeaderContent, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false %}

