{%- assign sectionTitle = 'general.product_catalog' | t -%}
{%- assign activeSortOption = catalog.sort_by | default: catalog.default_sort_by -%}
{%- assign animatedItemsCount = section.settings.productPerRow | times: 2 -%}
{%- assign sidebarMenu = linklists[section.settings.sidebarMenu] -%}

{%- if sidebarMenu and section.settings.productPerRow > 3 -%}
    {%- assign productPerRow = section.settings.productPerRow | minus: 1 -%}
{%- else -%}
    {%- assign productPerRow = section.settings.productPerRow -%}
{%- endif -%}

{% if catalog.products.size == 0 and request.design_mode == 'edit' %}
    {%- assign itemCount = productPerRow | times: 3 -%}
{% else %}
    {%- assign itemCount = catalog.products.size -%}
{% endif %}

{%- assign usableFiltersCount = 0 -%}
{%- for filter in catalog.filters -%}
    {%- if filter.param_name != blank -%}
        {%- if filter.type == 'range' or filter.values.size > 0 -%}
            {%- assign usableFiltersCount = usableFiltersCount | plus: 1 -%}
        {%- endif -%}
    {%- endif -%}
{%- endfor -%}

{%- capture catalogContent -%}

    {%- paginate catalog.products by 100 -%}

        {% if usableFiltersCount > 0 and itemCount > 0 or catalog.active_filters.size > 0 %}

            <form id="catalog-filters-form" class="catalog-filters mb-2 d-none d-lg-block">

                {% for filter in catalog.filters %}
                {% if filter.param_name != blank %}
                    {% if filter.type == 'range' or filter.values.size > 0 %}

                    <div class="catalog-filter-dropdown dropdown" data-bs-display="static" data-aos="animation-fadeIn" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ forloop.index }}">

                        <button class="catalog-filter-btn btn{% if settings.sectionHighlightItems %} border{% endif %}" type="button" data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-haspopup="true" aria-expanded="false">

                            <span class="catalog-filter-btn-text">

                                {% if filter.param_name contains 'filter.attribute.' or filter.param_name contains 'filter.taxonomy.' %}

                                    <span>{{ filter.label }}</span>

                                {% else %}

                                    {%- capture paramTranslationKey -%}
                                        filters.{{- filter.param_name | replace: '-', '_' -}}.title
                                    {%- endcapture -%}

                                    <span>{{ paramTranslationKey | strip | t: default:filter.label }}</span>

                                {% endif %}

                            </span>

                            {%- render 'icon', icon: 'angle-down' -%}

                        </button>

                        <div class="catalog-filter-dropdown-menu dropdown-menu p-4">

                            {% if filter.type == 'list' %}

                                {% if filter.param_name contains 'filter.taxonomy.' %}

                                    {% if filter.taxonomy_attribute.type == 'color' %}
                                        <div class="form-check-color-swatches-container form-check-color-swatches-gap-lg">
                                    {% endif %}

                                    {% for value in filter.values %}

                                        {% if filter.taxonomy_attribute.type == 'color' %}

                                            {%- capture swatchColor -%}
                                                {%- if value.taxonomy_value.colors.size == 1 -%}
                                                    {{- value.taxonomy_value.colors[0] -}}
                                                {%- elsif value.taxonomy_value.colors.size == 2 -%}
                                                    linear-gradient(45deg, {{ value.taxonomy_value.colors[0] }} 50%, {{ value.taxonomy_value.colors[1] }} 50%)
                                                {%- elsif value.taxonomy_value.colors.size == 3 -%}
                                                    linear-gradient(45deg, {{ value.taxonomy_value.colors[0] }} 33.33333333%, {{ value.taxonomy_value.colors[1] }} 33.33333333% 66.66666666%, {{ value.taxonomy_value.colors[2] }} 66.66666666%)
                                                {%- endif -%}
                                            {%- endcapture -%}

                                            <div class="{% if swatchColor or value.taxonomy_value.is_transparent or value.taxonomy_value.is_multicolor %}form-check-color-swatch form-check-color-swatch-sm{% if value.taxonomy_value.is_transparent %} form-check-color-swatch-transparent{% elsif value.taxonomy_value.is_multicolor %} form-check-color-swatch-multicolor{% endif %}{% else %}form-check-badge{% endif %}"{% if swatchColor %} style="--swatch-color: {{ swatchColor | strip }}"{% endif %}>

                                                <input type="checkbox" id="input-{{ value.param_name }}-{{ value.value }}" class="input-{{ value.param_name | replace: '.', '-' | handle }} form-check-input" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked="true"{% endif %}>

                                                <label for="input-{{ value.param_name }}-{{ value.value }}" class="form-check-label"></label>

                                                <label for="input-{{ value.param_name }}-{{ value.value }}" class="form-check-label">

                                                    <span>{{ value.label }}</span>

                                                    <span data-facet-result-count="{{ value.param_name }}-{{ value.value }}">({{ value.count }})</span>

                                                </label>

                                            </div>

                                        {% else %}

                                            <div class="form-check{% unless forloop.last == true %} mb-4{% endunless %}">

                                                <input type="checkbox" id="input-{{ value.param_name }}-{{ value.value }}" class="input-{{ value.param_name | replace: '.', '-' | handle }} form-check-input" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked="true"{% endif %}>

                                                <label for="input-{{ value.param_name }}-{{ value.value }}" class="form-check-label">

                                                    <span>{{ value.label }}</span>

                                                    <span data-facet-result-count="{{ value.param_name }}-{{ value.value }}">({{ value.count }})</span>

                                                </label>

                                            </div>

                                        {% endif %}

                                    {% endfor %}

                                    {% if filter.taxonomy_attribute.type == 'color' %}
                                        </div>
                                    {% endif %}

                                {% elsif filter.param_name == 'filter.availability' %}

                                    {% for value in filter.values %}

                                        <div class="form-check{% unless forloop.last == true %} mb-4{% endunless %}">

                                            <input type="radio" id="input-{{ value.param_name }}-{{ value.value }}" class="input-{{ value.param_name | replace: '.', '-' | handle }} form-check-input" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked="true"{% endif %}>

                                            <label for="input-{{ value.param_name }}-{{ value.value }}" class="form-check-label">

                                                {%- capture paramTranslationKey -%}
                                                    filters.{{- value.param_name -}}.values.{%- if value.value > 0 -%}in_stock{%- else -%}out_of_stock{%- endif -%}
                                                {%- endcapture -%}

                                                <span>{{ paramTranslationKey | strip | t: default:value.label }}</span>

                                                <span data-facet-result-count="{{ value.param_name }}-{{ value.value }}">({{ value.count }})</span>

                                            </label>

                                        </div>

                                    {% endfor %}

                                {% else %}

                                    {% for value in filter.values %}

                                        <div class="form-check{% unless forloop.last == true %} mb-4{% endunless %}">

                                            <input type="checkbox" id="input-{{ value.param_name }}-{{ value.value }}" class="input-{{ value.param_name | replace: '.', '-' | handle }} form-check-input" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked="true"{% endif %}>

                                            <label for="input-{{ value.param_name }}-{{ value.value }}" class="form-check-label">

                                                 {% if filter.param_name contains 'filter.attribute.' or filter.param_name contains 'filter.manufacturer' %}

                                                    <span>{{ value.label }}</span>

                                                {% else %}

                                                    {%- capture paramTranslationKey -%}
                                                        filters.{{- value.param_name -}}.values.{{- value.value | handle | replace: '-', '_' -}}
                                                    {%- endcapture -%}

                                                    <span>{{ paramTranslationKey | strip | t: default:value.label }}</span>

                                                {% endif %}

                                                <span data-facet-result-count="{{ value.param_name }}-{{ value.value }}">({{ value.count }})</span>

                                            </label>

                                        </div>

                                    {% endfor %}

                                {% endif %}

                            {% elsif filter.type == 'range' %}

                                <div class="range-filter">

                                    <div class="text-start mb-2">

                                        <span data-range-slider-min-text>

                                            {% if filter.param_name == 'filter.price' %}
                                                {{ filter.min_value.value | default: filter.min_value | money_with_currency }}
                                            {% else %}
                                                {{ filter.min_value.value | default: filter.min_value }}
                                            {% endif %}

                                        </span>

                                        <span class="mx-1">-</span>

                                        <span data-range-slider-max-text>

                                            {% if filter.param_name == 'filter.price' %}
                                                {{ filter.max_value.value | default: filter.range_max | money_with_currency }}
                                            {% else %}
                                                {{ filter.max_value.value | default: filter.range_max }}
                                            {% endif %}

                                        </span>

                                    </div>

                                    <div class="range-slider-container">

                                        <input type="hidden" class="input-{{ filter.param_name | replace: '.', '-' | handle }}" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" data-is-range-filter>
                                        <input type="hidden" class="input-{{ filter.param_name | replace: '.', '-' | handle }}" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" data-is-range-filter>

                                        <div class="range-slider"
                                            data-range-slider-min-name="{{ filter.min_value.param_name }}"
                                            data-range-slider-min-default="{{ filter.min_value.value | default: filter.range_min }}"
                                            data-range-slider-min-value="{{ filter.range_min }}"
                                            data-range-slider-max-name="{{ filter.max_value.param_name }}"
                                            data-range-slider-max-default="{{ filter.max_value.value | default: filter.range_max }}"
                                            data-range-slider-max-value="{{ filter.range_max }}"
                                            data-range-slider-format="{% if filter.param_name == 'filter.price' %}currency{% else %}decimal{% endif %}">
                                        </div>

                                    </div>

                                </div>

                            {% endif %}

                        </div>

                    </div>

                    {% endif %}
                {% endif %}
                {% endfor %}

            </form>

        {% endif %}

        <div class="catalog-dynamic-content" data-aos="animation-fadeIn" data-aos-anchor="#finqu-section-{{ section.id }}">

            <div class="position-relative z-3 d-flex justify-content-between align-items-center mb-4 gap-g d-lg-none">

                {% if usableFiltersCount > 0 and itemCount > 0 or catalog.active_filters.size > 0 %}

                    <button type="button" name="filters-mobile-navigation-show" class="btn btn-text text-title">

                        {%- render 'icon', icon: 'filter', class: 'svg-icon-fw' -%}

                        <span class="fw-bold">
                            {{- 'filters.title' | t -}}
                        </span>

                    </button>

                {% endif %}

                {% if usableFiltersCount > 0 and itemCount > 0 %}

                    {% render 'product-sort-dropdown', sort_options: catalog.sort_options, active_sort: activeSortOption, button_class: 'btn btn-text text-title', label_class: 'svg-icon-spacer fw-bold', icon_class: 'svg-icon-fw' %}

                {% endif %}

            </div>

            {% if catalog.active_filters.size > 0 %}

                <div class="section-highlight-item mb-g">

                    <div class="catalog-activated-filters">

                        {% for filter in catalog.active_filters %}

                            <div class="item">

                                <button type="button" class="catalog-remove-filter" value="{{ filter.param_name | replace: '.', '-' | handle }}">

                                    <span class="catalog-activated-filter-text">

                                        {% if filter.param_name contains 'filter.attribute.' or filter.param_name contains 'filter.taxonomy.' %}

                                            <span>{{ filter.label }}</span>

                                        {% else %}

                                            {%- capture paramTranslationKey -%}
                                                filters.{{- filter.param_name | replace: '-', '_' -}}.title
                                            {%- endcapture -%}

                                            <span>{{ paramTranslationKey | strip | t: default:filter.label }}</span>

                                        {% endif %}

                                    </span>

                                    <span class="catalog-activated-filter-icon">
                                        {%- render 'icon', icon: 'close' -%}
                                    </span>

                                </button>

                            </div>

                        {% endfor %}

                        {% if catalog.products %}

                            <div class="item">

                                <button type="button" class="catalog-reset-filters">

                                    <span class="catalog-reset-filters-text">
                                        {{- 'filters.clear_filters' | t -}}
                                    </span>

                                </button>

                            </div>

                        {% endif %}

                    </div>

                </div>

            {% endif %}

            {% if itemCount < 1 and catalog.active_filters.size > 0 %}

                <div class="mt-6 text-center listing-empty">

                    {%- render 'icon', icon: 'filters', class: 'svg-icon-5x mb-3' -%}

                    <span class="h5 d-block mb-3 text-title">
                        {{- 'filters.title' | t -}}
                    </span>

                    <p class="mb-6">
                        {{- 'filters.no_results' | t -}}
                    </p>

                    <button type="button" class="btn btn-primary catalog-reset-filters">
                        {{- 'filters.clear_filters' | t -}}
                    </button>

                </div>

            {% elsif itemCount > 0 %}

                <div class="row mb-g">

                    <div class="col-auto">

                        <span class="text-muted">
                            {% if itemCount == 1 %}
                                {{- 'general.product_count' | t: amount: itemCount -}}
                            {% else %}
                                {{- 'general.product_plural_count' | t: amount: itemCount -}}
                            {% endif %}
                        </span>

                    </div>

                    <div class="col text-end{% if usableFiltersCount > 0 %} d-none d-lg-block{% endif %}">

                        {% render 'product-sort-dropdown', sort_options: catalog.sort_options, active_sort: activeSortOption, button_class: 'btn btn-text text-muted', label_class: 'svg-icon-spacer' %}

                    </div>

                </div>

                <div class="catalog-items row gy-g row-cols-2 row-cols-sm-3 row-cols-md-3 row-cols-lg-{{ productPerRow }}" data-catalog-items-count="{{ itemCount }}">

                    {% if catalog.products.size > 0 %}

                        {% for product in catalog.products %}

                            <div class="col"{% if forloop.index <= animatedItemsCount %} data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay{%- if rendered_partial != 'sections/catalog-template' -%} style="--aos-order: {{ forloop.index }}"{% endif %}{% endif %}>

                                {%- capture productCardShellClass -%}
                                    {%- render 'product-card-shell-class', product: product -%}
                                {%- endcapture -%}

                                <div class="product-card-grid-item section-highlight-item {{ productCardShellClass | strip }}">

                        {% block 'product-list-item' id:'section-product-card' %}

                    </div>

                            </div>

                        {% endfor %}

                    {% elsif request.design_mode %}

                        {% for num in (1..itemCount) %}

                            <div class="col"{% if forloop.index <= animatedItemsCount %} data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay{%- if rendered_partial != 'sections/catalog-template' -%} style="--aos-order: {{ forloop.index }}"{% endif %}{% endif %}>

                                {%- assign product = nil -%}

                                {%- capture productCardShellClass -%}
                                    {%- render 'product-card-shell-class', product: product -%}
                                {%- endcapture -%}

                                <div class="product-card-grid-item section-highlight-item {{ productCardShellClass | strip }}">

                        {% block 'product-list-item' id:'section-product-card' %}

                    </div>

                            </div>

                        {% endfor %}

                    {% endif %}

                </div>

                {% render 'pagination', paginate: paginate %}

                {%- if rendered_partial != 'sections/catalog-template' and settings.schemaItemList -%}
                    {% render 'schemas/itemlist', items: catalog.products, paginate: paginate %}
                {%- endif -%}

                <script type="application/javascript">
                    document.addEventListener('DOMContentLoaded', function() {
                        document.dispatchEvent(new CustomEvent('theme:catalog:view', {
                            detail: {
                                product_ids: {{ catalog.products | map: 'id' | json }}
                            }
                        }));
                    });
                </script>

            {% endif %}

        </div>

    {%- endpaginate -%}

    {% if usableFiltersCount > 0 and itemCount > 0 or catalog.active_filters.size > 0 %}

        <nav class="filters-mobile-navigation-container">

            <div class="filters-mobile-navigation">

                <div class="filters-mobile-navigation-header">

                    <div class="filters-mobile-navigation-header-inner">

                        <button type="button" name="filters-mobile-navigation-hide" class="btn btn-text">
                            {%- render 'icon', icon: 'close', class: 'svg-icon-fw' -%}
                        </button>

                        <span class="filters-mobile-navigation-header-text">
                            {{- 'filters.title' | t -}}
                        </span>

                    </div>

                </div>

                <div class="filters-mobile-navigation-menu-container">

                    <form id="catalog-filters-mobile-form" class="catalog-filters">

                        <ul class="filters-mobile-navigation-menu">

                            {% for filter in catalog.filters %}
                            {% if filter.param_name != blank %}
                                {% if filter.type == 'range' or filter.values.size > 0 %}

                                {%- assign hasActiveFilters = filter.values | where: 'active' -%}

                                <li class="filters-mobile-navigation-menu-item">

                                    <div class="filters-mobile-navigation-menu-item-header">

                                        <button type="button" class="filters-mobile-navigation-menu-item-collapse-toggle btn btn-text" data-bs-toggle="collapse" data-bs-target="#filters-mobile-navigation-menu-item-collapse-{{ filter.param_name | replace: '.', '-' | handle }}" aria-expanded="{% if hasActiveFilters %}true{% else %}false{% endif %}" aria-controls="filters-mobile-navigation-menu-item-collapse-{{ filter.param_name | replace: '.', '-' | handle }}">

                                            <span class="filters-mobile-navigation-menu-item-header-text">

                                                {% if filter.param_name contains 'filter.attribute.' or filter.param_name contains 'filter.taxonomy.' %}

                                                    <span>{{ filter.label }}</span>

                                                {% else %}

                                                    {%- capture paramTranslationKey -%}
                                                        filters.{{- filter.param_name | replace: '-', '_' -}}.title
                                                    {%- endcapture -%}

                                                    <span>{{ paramTranslationKey | strip | t: default:filter.label }}</span>

                                                {% endif %}

                                            </span>

                                            {%- render 'icon', icon: 'angle-down' -%}
                                            
                                        </button>

                                    </div>

                                    <div id="filters-mobile-navigation-menu-item-collapse-{{ filter.param_name | replace: '.', '-' | handle }}" class="filters-mobile-navigation-menu-item-content collapse{% if hasActiveFilters %} show{% endif %}">

                                        {% if filter.type == 'list' %}

                                            {% if filter.param_name contains 'filter.taxonomy.' %}

                                                {% if filter.taxonomy_attribute.type == 'color' %}
                                                    <div class="form-check-color-swatches-container form-check-color-swatches-gap-lg">
                                                {% endif %}

                                                {% for value in filter.values %}

                                                    {% if filter.taxonomy_attribute.type == 'color' %}

                                                        {%- capture swatchColor -%}
                                                            {%- if value.taxonomy_value.colors.size == 1 -%}
                                                                {{- value.taxonomy_value.colors[0] -}}
                                                            {%- elsif value.taxonomy_value.colors.size == 2 -%}
                                                                linear-gradient(45deg, {{ value.taxonomy_value.colors[0] }} 50%, {{ value.taxonomy_value.colors[1] }} 50%)
                                                            {%- elsif value.taxonomy_value.colors.size == 3 -%}
                                                                linear-gradient(45deg, {{ value.taxonomy_value.colors[0] }} 33.33333333%, {{ value.taxonomy_value.colors[1] }} 33.33333333% 66.66666666%, {{ value.taxonomy_value.colors[2] }} 66.66666666%)
                                                            {%- endif -%}
                                                        {%- endcapture -%}

                                                        <div class="{% if swatchColor or value.taxonomy_value.is_transparent or value.taxonomy_value.is_multicolor %}form-check-color-swatch form-check-color-swatch-sm{% if value.taxonomy_value.is_transparent %} form-check-color-swatch-transparent{% elsif value.taxonomy_value.is_multicolor %} form-check-color-swatch-multicolor{% endif %}{% else %}form-check-badge{% endif %}"{% if swatchColor %} style="--swatch-color: {{ swatchColor | strip }}"{% endif %}>

                                                            <input type="checkbox" id="input-mobile-{{ value.param_name }}-{{ value.value }}" class="input-mobile-{{ value.param_name | replace: '.', '-' | handle }} form-check-input" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked="true"{% endif %}>

                                                            <label for="input-mobile-{{ value.param_name }}-{{ value.value }}" class="form-check-label"></label>

                                                            <label for="input-mobile-{{ value.param_name }}-{{ value.value }}" class="form-check-label">

                                                                <span>{{ value.label }}</span>

                                                                <span data-facet-result-count="{{ value.param_name }}-{{ value.value }}">({{ value.count }})</span>

                                                            </label>

                                                        </div>

                                                    {% else %}

                                                        <div class="form-check{% unless forloop.last == true %} mb-4{% endunless %}">

                                                            <input type="checkbox" id="input-mobile-{{ value.param_name }}-{{ value.value }}" class="input-mobile-{{ value.param_name | replace: '.', '-' | handle }} form-check-input" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked="true"{% endif %}>

                                                            <label for="input-mobile-{{ value.param_name }}-{{ value.value }}" class="form-check-label">

                                                                <span>{{ value.label }}</span>

                                                                <span data-facet-result-count="{{ value.param_name }}-{{ value.value }}">({{ value.count }})</span>

                                                            </label>

                                                        </div>

                                                    {% endif %}

                                                {% endfor %}

                                                {% if filter.taxonomy_attribute.type == 'color' %}
                                                    </div>
                                                {% endif %}

                                            {% elsif filter.param_name == 'filter.availability' %}

                                                {% for value in filter.values %}

                                                    <div class="form-check{% unless forloop.last == true %} mb-4{% endunless %}">

                                                        <input type="radio" id="input-mobile-{{ value.param_name }}-{{ value.value }}" class="input-mobile-{{ value.param_name | replace: '.', '-' | handle }} form-check-input" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked="true"{% endif %}>

                                                        <label for="input-mobile-{{ value.param_name }}-{{ value.value }}" class="form-check-label">

                                                            {%- capture paramTranslationKey -%}
                                                                filters.{{- value.param_name -}}.values.{%- if value.value > 0 -%}in_stock{%- else -%}out_of_stock{%- endif -%}
                                                            {%- endcapture -%}

                                                            <span>{{ paramTranslationKey | strip | t: default:value.label }}</span>

                                                            <span data-facet-result-count="{{ value.param_name }}-{{ value.value }}">({{ value.count }})</span>

                                                        </label>

                                                    </div>

                                                {% endfor %}
                                                
                                            {% else %}

                                                {% for value in filter.values %}

                                                    <div class="form-check{% unless forloop.last == true %} mb-4{% endunless %}">

                                                        <input type="checkbox" id="input-mobile-{{ value.param_name }}-{{ value.value }}" class="input-mobile-{{ value.param_name | replace: '.', '-' | handle }} form-check-input" name="{{ value.param_name }}" value="{{ value.value }}"{% if value.active %} checked="true"{% endif %}>

                                                        <label for="input-mobile-{{ value.param_name }}-{{ value.value }}" class="form-check-label">

                                                            {% if filter.param_name contains 'filter.attribute.' or filter.param_name contains 'filter.manufacturer' %}

                                                                <span>{{ value.label }}</span>

                                                            {% else %}

                                                                {%- capture paramTranslationKey -%}
                                                                    filters.{{- value.param_name -}}.values.{{- value.value | handle | replace: '-', '_' -}}
                                                                {%- endcapture -%}

                                                                <span>{{ paramTranslationKey | strip | t: default:value.label }}</span>

                                                            {% endif %}

                                                            <span data-facet-result-count="{{ value.param_name }}-{{ value.value }}">({{ value.count }})</span>

                                                        </label>

                                                    </div>

                                                {% endfor %}

                                            {% endif %}

                                        {% elsif filter.type == 'range' %}

                                            <div class="range-filter">

                                                <div class="text-start mb-2">

                                                    <span data-range-slider-min-text>

                                                        {% if filter.param_name == 'filter.price' %}
                                                            {{ filter.min_value.value | default: filter.min_value | money_with_currency }}
                                                        {% else %}
                                                            {{ filter.min_value.value | default: filter.min_value }}
                                                        {% endif %}

                                                    </span>

                                                    <span class="mx-1">-</span>

                                                    <span data-range-slider-max-text>

                                                        {% if filter.param_name == 'filter.price' %}
                                                            {{ filter.max_value.value | default: filter.range_max | money_with_currency }}
                                                        {% else %}
                                                            {{ filter.max_value.value | default: filter.range_max }}
                                                        {% endif %}

                                                    </span>

                                                </div>

                                                <div class="range-slider-container">

                                                    <input type="hidden" class="input-mobile-{{ filter.param_name | replace: '.', '-' | handle }}" name="{{ filter.min_value.param_name }}" value="{{ filter.min_value.value }}" data-is-range-filter>
                                                    <input type="hidden" class="input-mobile-{{ filter.param_name | replace: '.', '-' | handle }}" name="{{ filter.max_value.param_name }}" value="{{ filter.max_value.value }}" data-is-range-filter>

                                                    <div class="range-slider"
                                                        data-range-slider-min-name="{{ filter.min_value.param_name }}"
                                                        data-range-slider-min-default="{{ filter.min_value.value | default: filter.range_min }}"
                                                        data-range-slider-min-value="{{ filter.range_min }}"
                                                        data-range-slider-max-name="{{ filter.max_value.param_name }}"
                                                        data-range-slider-max-default="{{ filter.max_value.value | default: filter.range_max }}"
                                                        data-range-slider-max-value="{{ filter.range_max }}"
                                                        data-range-slider-format="{% if filter.param_name == 'filter.price' %}currency{% else %}decimal{% endif %}">
                                                    </div>

                                                </div>

                                            </div>

                                        {% endif %}

                                    </div>

                                </li>

                                {% endif %}
                            {% endif %}
                            {% endfor %}

                        </ul>

                    </form>

                </div>

                <div class="filters-mobile-navigation-footer">

                    <div class="filters-mobile-navigation-footer-inner">

                        <button type="button" name="filters-mobile-navigation-hide" class="filters-mobile-navigation-footer-inner-cta btn btn-primary d-block w-100">

                            {% if itemCount == 1 %}
                                {{- 'filters.show_result' | t: amount: itemCount -}}
                            {% else %}
                                {{- 'filters.show_result_plural' | t: amount: itemCount -}}
                            {% endif %}

                        </button>

                    </div>

                </div>

            </div>

        </nav>

    {% endif %}

{%- endcapture -%}

{%- capture sectionContent -%}

    {% if rendered_partial != 'sections/catalog-template' and sidebarMenu %}

        <div class="row">

            <div class="col-lg-3 d-none d-lg-block pe-lg-6" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}">

                {%- assign hasActiveLink = false -%}

                {%- for item in sidebarMenu.links -%}

                    {%- if item.current and hasActiveLink == false and item.links.size == 0 -%}
                        {%- assign hasActiveLink = true -%}
                    {%- endif -%}

                {%- endfor -%}

                <ul class="sidebar-menu section-highlight-item{% if hasActiveLink %} no-active-child-links{% endif %}{% if section.settings.highlightActiveLink %} sidebar-menu-highlight-active-child-link{% endif %}">

                    {% for item in sidebarMenu.links %}

                        {% render 'sidebar-menu-item', link: item %}

                    {% endfor %}

                </ul>

            </div>

            <div class="col col-lg-9">

                {{ catalogContent }}

            </div>

        </div>

    {% else %}

        {{ catalogContent }}

    {% endif %}

{%- endcapture -%}

{% render 'section', section: section, sectionContent: sectionContent, sectionTitle: sectionTitle, sectionTitleTag: 'h1', sectionSubtitle: sectionSubtitle, sectionDescription: sectionDescription, sectionBreadcrumbs: sectionBreadcrumbs, sectionContentAnimation: false, sectionHeaderGapScale: 1, sectionInnerGap: '2rem', sectionDescriptionTruncate: true %}

{%- if rendered_partial != 'sections/catalog-template' and settings.schemaBreadcrumbList -%}
    {% render 'schemas/breadcrumblist', breadcrumbs: sectionBreadcrumbs, currentItem: catalog %}
{%- endif -%}

{% schema %}
{
    "name": "t:sections.catalog-template.name",
    "tag": "section",
    "class": "section section-catalog",
    "is_creatable": false,
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.layout.title",
                "settings": [
                    {
                        "id": "sidebarMenu",
                        "type": "menu",
                        "label": "t:sections.catalog-template.settings.sidebarMenu.label",
                        "allow_empty": true
                    },
                    {
                        "id": "highlightActiveLink",
                        "type": "checkbox",
                        "label": "t:sections.catalog-template.settings.highlightActiveLink.label",
                        "default": true,
                        "conditions": [
                            "!sidebarMenu eq blank"
                        ]
                    },
                    {
                        "default": 5,
                        "id": "productPerRow",
                        "label": "t:all.settings.productPerRow.label",
                        "options": [
                            {
                                "label": "2",
                                "value": 2
                            },
                            {
                                "label": "3",
                                "value": 3
                            },
                            {
                                "label": "4",
                                "value": 4
                            },
                            {
                                "label": "5",
                                "value": 5
                            },
                            {
                                "label": "6",
                                "value": 6
                            }
                        ],
                        "type": "radio-pill"
                    }
                ],
                "id": "layout"
            }
        ]
    }
}
{% endschema %}