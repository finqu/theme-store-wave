{%- capture sectionAction -%}
    {% render 'section-quick-link', section: section %}
{%- endcapture -%}
{%- assign sectionAction = sectionAction | strip -%}

{%- capture sectionHeaderBlocks -%}
    {% container 'header' %}
{%- endcapture -%}
{%- assign sectionHeaderBlocks = sectionHeaderBlocks | strip -%}

{%- capture sectionHeaderContent -%}
    {%- if sectionHeaderBlocks != blank or sectionAction != blank -%}
        <div class="section-header">
            <div class="container">
                <div class="d-flex align-items-end justify-content-between gap-g flex-wrap">
                    <div class="flex-grow-1 min-w-0">
                        {{- sectionHeaderBlocks -}}
                    </div>
                    {%- if sectionAction != blank -%}
                        <div class="section-action">
                            {{- sectionAction -}}
                        </div>
                    {%- endif -%}
                </div>
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture sectionContent -%}

    {%- assign sectionHandle = '#finqu-section-' | append: section.id -%}

    {%- if section.settings.setting_blocks.items.size > 0 -%}
        {%- assign items = section.settings.setting_blocks.items -%}
    {%- else -%}
        {%- assign items = categories.root -%}
    {%- endif -%}

    {% render 'category-carousel', items: items, sectionHandle: sectionHandle, carouselPagination: section.settings.carouselPagination, carouselNavigation: section.settings.carouselNavigation, carouselStyle: section.settings.carouselStyle, categoryPerView: section.settings.carouselItemsPerView, categoryTextPosition: section.settings.textPosition, categoryTextColor: section.settings.textColor, categoryImgDimming: section.settings.imgDimming, categoryImgAspectRatio: section.settings.imgAspectRatio, categoryImgFit: section.settings.imgFit, categoryImgShape: section.settings.imgShape, carouselFreemode: true, carouselAutoplaySpeed: section.settings.carouselAutoplaySpeed %}

{%- endcapture -%}

{% render 'section', section: section, sectionHeaderContent: sectionHeaderContent, sectionContent: sectionContent, sectionContentOverflow: 'hidden', sectionContentAnimation: false, sectionHeader: false %}

