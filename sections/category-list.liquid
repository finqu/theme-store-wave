
{%- capture sectionStyle -%}
    #finqu-section-{{ section.id }} {
        --style-grid-gutter-width: {{ settings.styleGridGutterWidth }};
    }
    {% if section.settings.textPosition == 'over' and section.settings.textColor %}
        #finqu-section-{{ section.id }} .category-items-container {
            --style-text-color: {{ section.settings.textColor }};
            --style-link-color: {{ section.settings.textColor }};
        }
        #finqu-section-{{ section.id }} .category-item-text-container {
            display: flex;
            align-items: center;
            justify-content: center;
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            height: 100%;
            width: 100%;
            z-index: 2;
            overflow: hidden;
            padding: var(--style-spacer-4);
        }
        #finqu-section-{{ section.id }} .category-item-text {
            overflow: hidden;
            text-overflow: ellipsis;
            margin-bottom: 0;
            text-shadow: 1px 1px 0px rgb(0 0 0 / 10%);
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
        }
    {% endif %}
    {%- if section.settings.imgDimming and section.settings.textPosition == 'over' -%}
        #finqu-section-{{ section.id }} .category-items-container .aspect-ratio-container::after {
            content: '';
            position: absolute;
            left: 0;
            top: 0;
            right: 0;
            bottom: 0;
            z-index: 1;
            background: linear-gradient(0deg, rgb(0,0,0, {{ section.settings.imgDimming }}%), rgb(0,0,0, {{ section.settings.imgDimming }}%))
        }
    {%- endif -%}
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- capture sectionAction -%}
    {% render 'section-quick-link', section: section %}
{%- endcapture -%}
{%- assign sectionAction = sectionAction | strip -%}

{%- capture sectionHeaderBlocks -%}
    {% container 'header' %}
{%- endcapture -%}
{%- assign sectionHeaderBlocks = sectionHeaderBlocks | strip -%}

{%- capture sectionHeaderContent -%}
    {%- if sectionHeaderBlocks != blank or sectionAction != blank -%}
        <div class="section-header">
            <div class="container">
                <div class="d-flex align-items-end justify-content-between gap-g flex-wrap">
                    <div class="flex-grow-1 min-w-0">
                        {{- sectionHeaderBlocks -}}
                    </div>
                    {%- if sectionAction != blank -%}
                        <div class="section-action">
                            {{- sectionAction -}}
                        </div>
                    {%- endif -%}
                </div>
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture sectionContent -%}

    {% if section.settings.imgAspectRatio == '16:9' %}

        {%- assign imgSizeSm = '175,103' -%}
        {%- assign imgSizeMd = '206,220' -%}

        {%- case section.settings.categoryPerRow -%}
            {% when '3' %}
                {%- assign imgSizeLg = '430,246' -%}
            {% when '4' %}
                {%- assign imgSizeLg = '320,184' -%}
            {% when '5' %}
                {%- assign imgSizeLg = '254,147' -%}
            {% when '6' %}
                {%- assign imgSizeLg = '210,122' -%}
            {% when '7' %}
                {%- assign imgSizeLg = '178,104' -%}
            {% when '8' %}
                {%- assign imgSizeLg = '155,91' -%}
        {%- endcase -%}

    {% elsif section.settings.imgAspectRatio == '9:13' %}

        {%- assign imgSizeSm = '175,248' -%}
        {%- assign imgSizeMd = '206,293' -%}

        {%- case section.settings.categoryPerRow -%}
            {% when '3' %}
                {%- assign imgSizeLg = '430,616' -%}
            {% when '4' %}
                {%- assign imgSizeLg = '320,457' -%}
            {% when '5' %}
                {%- assign imgSizeLg = '254,362' -%}
            {% when '6' %}
                {%- assign imgSizeLg = '210,298' -%}
            {% when '7' %}
                {%- assign imgSizeLg = '178,253' -%}
            {% when '8' %}
                {%- assign imgSizeLg = '155,219' -%}
        {%- endcase -%}

    {% elsif section.settings.imgAspectRatio == '4:3' %}

        {%- assign imgSizeSm = '175,134' -%}
        {%- assign imgSizeMd = '206,157' -%}

        {%- case section.settings.categoryPerRow -%}
            {% when '3' %}
                {%- assign imgSizeLg = '430,325' -%}
            {% when '4' %}
                {%- assign imgSizeLg = '320,242' -%}
            {% when '5' %}
                {%- assign imgSizeLg = '254,193' -%}
            {% when '6' %}
                {%- assign imgSizeLg = '210,160' -%}
            {% when '7' %}
                {%- assign imgSizeLg = '178,136' -%}
            {% when '8' %}
                {%- assign imgSizeLg = '155,118' -%}
        {%- endcase -%}

    {% elsif section.settings.imgAspectRatio == '1:1' %}

        {%- assign imgSizeSm = '175,175' -%}
        {%- assign imgSizeMd = '206,206' -%}

        {%- case section.settings.categoryPerRow -%}
            {% when '3' %}
                {%- assign imgSizeLg = '430,430' -%}
            {% when '4' %}
                {%- assign imgSizeLg = '320,320' -%}
            {% when '5' %}
                {%- assign imgSizeLg = '254,254' -%}
            {% when '6' %}
                {%- assign imgSizeLg = '210,210' -%}
            {% when '7' %}
                {%- assign imgSizeLg = '178,178' -%}
            {% when '8' %}
                {%- assign imgSizeLg = '155,155' -%}
        {%- endcase -%}

    {% endif %}

    {%- if section.settings.setting_blocks.items.size > 0 -%}
        {%- assign items = section.settings.setting_blocks.items -%}
    {%- else -%}
        {%- assign items = categories.root -%}
    {%- endif -%}

    {% if section.settings.setting_blocks.items.size == 0 and request.design_mode %}

        <div class="category-items-container category-items-position-{{ section.settings.textPosition }} row gy-g row-scroll-cols-2 row-scroll-cols-md-3 row-cols-lg-{{ section.settings.categoryPerRow }}">

            {% for num in (1..section.settings.categoryPerRow) %}

                <div class="col position-relative" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ forloop.index }}">

                    {% if section.settings.textPosition == 'over' %}

                        <div class="category-item-text-container">

                            <div class="text-icon-indicator-container text-center">

                                <span class="category-item-text fs-2">
                                    {{- 'placeholder.category' | t -}}
                                </span>

                            </div>

                        </div>

                    {% endif %}

                    <div class="aspect-ratio-{% if section.settings.imgShape == 'circle' %}1-1{% else %}{{ section.settings.imgAspectRatio | replace: ':', '-' }}{% endif %}{% if section.settings.imgShape == 'circle' %} rounded-circle{% endif %}">

                        <div class="aspect-ratio-container">

                             {%- capture class -%}
                                aspect-ratio-item{% if section.settings.imgFit or section.settings.imgShape == 'circle' %} aspect-ratio-item-cover{% endif %}
                            {%- endcapture -%}

                            {% render 'placeholder-svg', type: 'category', class: class %}

                        </div>

                    </div>

                    {% if section.settings.textPosition == 'below' %}

                        <div class="category-item-text-container mt-g">

                            <div class="text-icon-with-underline-indicator text-center">

                                <span class="category-item-text text-icon-with-underline-indicator fw-bold">

                                    {{- 'placeholder.category' | t -}}
                                    {%- render 'icon', icon: 'arrow-right' -%}

                                </span>

                            </div>

                        </div>

                    {% endif %}

                </div>

            {% endfor %}

        </div>

    {% else %}

        <div class="category-items-container category-items-position-{{ section.settings.textPosition }} row gy-g row-scroll-cols-2 row-scroll-cols-md-3 row-cols-lg-{{ section.settings.categoryPerRow }}">

            {% for item in items %}

                {%- if section.settings.setting_blocks.items.size > 0 -%}
                    {%- assign itemCategory = item.settings.category -%}
                {%- else -%}
                    {%- assign itemCategory = item -%}
                {%- endif -%}

                {%- if itemCategory -%}

                    {%- if item.settings.img -%}
                        {%- assign img = item.settings.img -%}
                        {%- assign imgAlt = item.settings.img.alt -%}
                    {%- else -%}
                        {%- assign img = itemCategory.image -%}
                        {%- assign imgAlt = itemCategory.title -%}
                    {%- endif -%}
                    
                    {%- assign resourceUrl = item.settings.resource.url | default: itemCategory | link -%}
                    {%- assign resourceTarget = item.settings.resource.target | default: '_self' -%}
                    {%- assign text = item.settings.resource.text | default: itemCategory.title -%}

                {%- else -%}

                    {%- assign img = item.settings.img -%}
                    {%- assign imgAlt = item.settings.img.alt -%}
                    {%- assign resourceUrl = item.settings.resource.url -%}
                    {%- assign resourceTarget = item.settings.resource.target | default: '_self' -%}
                    {%- assign text = item.settings.resource.text -%}

                {%- endif -%}

                {%- if text == blank and request.design_mode -%}
                    {%- assign text = 'placeholder.category' | t -%}
                {%- endif -%}

                {%- capture categoryItemContent -%}

                    {% if section.settings.textPosition == 'over' %}

                        <div class="category-item-text-container">

                            <span class="category-item-text fs-2">
                                {{- text -}}
                            </span>

                        </div>

                    {% endif %}

                    <div class="aspect-ratio-{% if section.settings.imgShape == 'circle' %}1-1{% else %}{{ section.settings.imgAspectRatio | replace: ':', '-' }}{% endif %}{% if section.settings.imgShape == 'circle' %} rounded-circle{% endif %}">

                        <div class="aspect-ratio-container">

                            {% if img %}

                                 <picture>
                                    <source media="(min-width: {{ settings.styleGridBreakpointLg }})" data-srcset="
                                        {{- img | thumb: imgSizeLg }} 1x,
                                        {{- img | thumb: imgSizeLg | thumb:'@2x' }} 2x">

                                    <source media="(min-width: {{ settings.styleGridBreakpointSm }})" data-srcset="
                                        {{- img | thumb: imgSizeMd }} 1x,
                                        {{- img | thumb: imgSizeMd | thumb:'@2x' }} 2x">

                                    <source data-srcset="
                                        {{- img | thumb: imgSizeSm }} 1x,
                                        {{- img | thumb: imgSizeSm | thumb:'@2x' }} 2x">

                                    <img
                                        alt="{{ imgAlt }}" 
                                        data-src="{{ img | thumb: imgSizeSm }}"
                                        data-srcset="{{ img | thumb: imgSizeSm }} 1x, {{ img | thumb: imgSizeSm | thumb:'@2x' }} 2x"
                                        class="lazy aspect-ratio-item{% if section.settings.imgFit or section.settings.imgShape == 'circle' %} aspect-ratio-item-cover{% endif %}"{% if img.offset_left or img.offset_top %} style="--object-position: {{ img.offset_left }}% {{ img.offset_top }}%"{% endif %}>
                                </picture>

                            {% else %}

                                {%- capture class -%}
                                    aspect-ratio-item{% if section.settings.imgFit or section.settings.imgShape == 'circle' %} aspect-ratio-item-cover{% endif %}
                                {%- endcapture -%}

                                {% render 'placeholder-svg', type: 'category', class: class %}

                            {% endif %}

                        </div>

                    </div>

                    {% if section.settings.textPosition == 'below' %}

                        <div class="category-item-text-container mt-g">

                            <div class="text-icon-with-underline-indicator-container text-center">

                                <span class="category-item-text text-icon-with-underline-indicator fw-bold">

                                    {{- text -}}
                                    {%- render 'icon', icon: 'arrow-right' -%}

                                </span>

                            </div>

                        </div>

                    {% endif %}

                {%- endcapture -%}

                <div class="col position-relative" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ forloop.index }}">

                    {% if resourceUrl %}

                        <a href="{{- resourceUrl -}}" class="img-indicator-zoom" target="{{ resourceTarget }}">

                            {{ categoryItemContent }}

                        </a>

                    {% else %}

                        {{ categoryItemContent }}

                    {% endif %}

                </div>

            {% endfor %}

        </div>

    {% endif %}

{%- endcapture -%}

{% render 'section', section: section, sectionHeaderContent: sectionHeaderContent, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false %}

{% schema %}
{
    "name": "t:sections.category-list.name",
    "tag": "section",
    "class": "section section-category-list",
    "category": "theme-product-group",
    "keywords": [
        "Product group",
        "List"
    ],
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.content.title",
                "settings": [
                    {
                        "id": "sectionQuickLinkResource",
                        "type": "url",
                        "label": "t:all.settings.sectionQuickLinkResource.label",
                        "include_text": true
                    }
                ],
                "id": "content"
            },
            {
                "title": "t:sections.category-list.groups.items.title",
                "id": "items",
                "call_to_action": "t:sections.category-list.groups.items.call_to_action",
                "is_sortable": true,
                "setting_blocks": [
                    {
                        "type": "category",
                        "title": "t:sections.category-list.setting_blocks.category.title",
                        "settings": [
                            {
                                "id": "category",
                                "type": "category",
                                "label": "t:sections.category-list.setting_blocks.category.settings.category.label",
                                "info": "t:sections.category-list.setting_blocks.category.settings.category.info"
                            },
                            {
                                "id": "img",
                                "type": "image-picker",
                                "label": "t:sections.category-list.setting_blocks.category.settings.img.label",
                                "adjustments": true,
                                "info": "t:sections.category-list.setting_blocks.category.settings.img.info"
                            },
                            {
                                "id": "resource",
                                "type": "url",
                                "label": "t:sections.category-list.setting_blocks.category.settings.resource.label",
                                "include_target": true,
                                "include_text": true,
                                "info": "t:sections.category-list.setting_blocks.category.settings.resource.info"
                            }
                        ]
                    }
                ]
            },
            {
                "title": "t:all.groups.settings.title",
                "settings": {
                    "list_type": "list",
                    "groups": [
                        {
                            "title": "t:all.groups.style.title",
                            "settings": [
                                {
                                    "id": "sectionColorScheme",
                                    "type": "select",
                                    "label": "t:all.settings.sectionColorScheme.label",
                                    "default": false,
                                    "options": [
                                        {
                                            "value": false,
                                            "label": "t:all.settings.sectionColorScheme.options.false.label"
                                        },
                                        {
                                            "value": "secondary",
                                            "label": "t:all.settings.sectionColorScheme.options.secondary.label"
                                        },
                                        {
                                            "value": "light",
                                            "label": "t:all.settings.sectionColorScheme.options.light.label"
                                        },
                                        {
                                            "value": "dark",
                                            "label": "t:all.settings.sectionColorScheme.options.dark.label"
                                        },
                                        {
                                            "value": "accent",
                                            "label": "t:all.settings.sectionColorScheme.options.accent.label"
                                        },
                                        {
                                            "value": "custom",
                                            "label": "t:all.settings.sectionColorScheme.options.custom.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "style_custom_color",
                                    "type": "color",
                                    "alpha": true,
                                    "gradient": true,
                                    "label": "t:all.settings.style_custom_color.label",
                                    "default": "#f3f5f6",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_color",
                                    "type": "color",
                                    "alpha": true,
                                    "label": "t:all.settings.style_custom_content_color.label",
                                    "default": "#ffffff",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_content_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionPaddingMode",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionPaddingMode.label",
                                    "default": "auto",
                                    "options": [
                                        {
                                            "value": "auto",
                                            "label": "t:all.settings.sectionPaddingMode.options.auto.label"
                                        },
                                        {
                                            "value": "custom",
                                            "label": "t:all.settings.sectionPaddingMode.options.custom.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "sectionPadding",
                                    "type": "padding",
                                    "label": "t:all.settings.sectionPadding.label",
                                    "padding": {
                                        "top": 0,
                                        "right": 0,
                                        "bottom": 0,
                                        "left": 0
                                    },
                                    "min": 0,
                                    "max": 15,
                                    "step": 0.5,
                                    "apply_to_all_sides": false,
                                    "conditions": [
                                        "sectionPaddingMode eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionBorderRadius",
                                    "label": "t:all.settings.sectionBorderRadius.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 50,
                                    "step": 1,
                                    "default": "0",
                                    "unit": "px",
                                    "conditions": [
                                        "sectionPaddingMode eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionBgImg",
                                    "type": "image-picker",
                                    "label": "t:all.settings.sectionBgImg.label",
                                    "adjustments": true
                                },
                                {
                                    "id": "sectionBgImgFit",
                                    "type": "select",
                                    "label": "t:all.settings.sectionBgImgFit.label",
                                    "default": "cover",
                                    "options": [
                                        {
                                            "value": "cover",
                                            "label": "t:all.settings.sectionBgImgFit.options.cover.label"
                                        },
                                        {
                                            "value": "contain",
                                            "label": "t:all.settings.sectionBgImgFit.options.contain.label"
                                        },
                                        {
                                            "value": "auto",
                                            "label": "t:all.settings.sectionBgImgFit.options.auto.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgPosHorizontal",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionBgImgPosHorizontal.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "left",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.left.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.center.label"
                                        },
                                        {
                                            "value": "right",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.right.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgPosVertical",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionBgImgPosVertical.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "top",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.top.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.center.label"
                                        },
                                        {
                                            "value": "bottom",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.bottom.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgDimming",
                                    "label": "t:all.settings.sectionBgImgDimming.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 90,
                                    "step": 5,
                                    "default": "0",
                                    "unit": "%",
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgBlur",
                                    "label": "t:all.settings.sectionBgImgBlur.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 10,
                                    "step": 1,
                                    "default": "0",
                                    "unit": " ",
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                }
                            ],
                            "id": "style"
                        },
                        {
                            "title": "t:all.groups.layout.title",
                            "settings": [
                                {
                                    "id": "sectionTextAlign",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionTextAlign.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.sectionTextAlign.options.nil.label"
                                        },
                                        {
                                            "value": "start",
                                            "label": "t:all.settings.sectionTextAlign.options.start.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionTextAlign.options.center.label"
                                        },
                                        {
                                            "value": "end",
                                            "label": "t:all.settings.sectionTextAlign.options.end.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "sectionQuickLinkTheme",
                                    "type": "select",
                                    "label": "t:all.settings.sectionQuickLinkTheme.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.sectionQuickLinkTheme.options.nil.label"
                                        },
                                        {
                                            "value": "primary",
                                            "label": "t:all.settings.sectionQuickLinkTheme.options.primary.label"
                                        },
                                        {
                                            "value": "secondary",
                                            "label": "t:all.settings.sectionQuickLinkTheme.options.secondary.label"
                                        },
                                        {
                                            "value": "contrast",
                                            "label": "t:all.settings.sectionQuickLinkTheme.options.contrast.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionQuickLinkResource eq blank"
                                    ]
                                },
                                {
                                    "id": "sectionQuickLinkVariant",
                                    "type": "select",
                                    "label": "t:all.settings.sectionQuickLinkVariant.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.sectionQuickLinkVariant.options.nil.label"
                                        },
                                        {
                                            "value": "filled",
                                            "label": "t:all.settings.sectionQuickLinkVariant.options.filled.label"
                                        },
                                        {
                                            "value": "outline",
                                            "label": "t:all.settings.sectionQuickLinkVariant.options.outline.label"
                                        },
                                        {
                                            "value": "ghost",
                                            "label": "t:all.settings.sectionQuickLinkVariant.options.ghost.label"
                                        },
                                        {
                                            "value": "text",
                                            "label": "t:all.settings.sectionQuickLinkVariant.options.text.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionQuickLinkResource eq blank"
                                    ]
                                },
                                {
                                    "id": "sectionQuickLinkSize",
                                    "type": "select",
                                    "label": "t:all.settings.sectionQuickLinkSize.label",
                                    "default": "sm",
                                    "options": [
                                        {
                                            "value": "sm",
                                            "label": "t:all.settings.sectionQuickLinkSize.options.sm.label"
                                        },
                                        {
                                            "value": "md",
                                            "label": "t:all.settings.sectionQuickLinkSize.options.md.label"
                                        },
