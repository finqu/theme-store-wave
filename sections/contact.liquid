{%- capture sectionContent -%}

    <div class="contact-stack" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: 1">

        <div class="contact-intro">
            {% container 'intro' %}
        </div>

        {% if section.settings.contactLayout == 2 %}

            <div class="row align-items-center gy-5">

                <div class="col-12 col-md">
                    <div class="contact-aside">
                        {% container 'aside' %}
                    </div>
                </div>

                <div class="col-12 col-md">
                    <div class="contact-form">
                        {% block 'contact-form' id:'section-contact-form' %}
                    </div>
                </div>

            </div>

        {% else %}

            <div class="contact-aside">
                {% container 'aside' %}
            </div>

            <div class="contact-form">
                {% block 'contact-form' id:'section-contact-form' %}
            </div>

        {% endif %}

        <div class="contact-below">
            {% container 'below' %}
        </div>

    </div>

{%- endcapture -%}

{% render 'section', section: section, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false, sectionInnerGap: '2rem' %}

{% schema %}
