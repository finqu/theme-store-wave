{%- if section.settings.barVisibility == 'frontpage' and request.page_type == 'frontpage' -%}
    {%- assign barIsVisible = true -%}
{% elsif section.settings.barVisibility == 'all' %}
    {%- assign barIsVisible = true -%}
{%- else -%}
    {%- assign barIsVisible = false -%}
{%- endif -%}

{%- if section.settings.barTextAlign == 'nil' -%}
    {%- assign barTextAlign = settings.sectionTextAlign -%}
{%- else -%}
    {%- assign barTextAlign = section.settings.barTextAlign -%}
{%- endif -%}

{%- capture sectionStyle -%}
    #finqu-section-{{ section.id }} {
        --style-announcement-align: {{ barTextAlign }};
        {%- render 'header-bar-bg', barBgColor: section.settings.barBgColor -%}
    }
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{% if barIsVisible or request.design_mode == 'edit' -%}

    {%- capture countdownBarTitle -%}

        {%- if section.settings.title -%}

            <span class="site-countdown-bar-title">
                {{- section.settings.title -}}
            </span>

        {%- endif -%}

    {%- endcapture -%}

    {%- capture countdownBarTimer -%}

        {% block 'countdown' id:'section-countdown', display: 'inline' %}

    {%- endcapture -%}

    {%- capture countdownBarCta -%}

        <div class="site-countdown-bar-cta">

            {% block 'button' id:'section-countdown-button', display: 'inline' %}

        </div>

    {%- endcapture -%}

    {%- capture countdownBarContent -%}
        {{- countdownBarTitle -}}
        {{- countdownBarTimer -}}
    {%- endcapture -%}

    <div class="site-header-bar">

        <div class="site-countdown-bar container">

            <div class="site-countdown-bar-inner site-countdown-bar-inner--btn-{{ section.settings.btnPosition }} site-countdown-bar-inner--btn-{{ section.settings.btnSpacing }}">

                {%- if section.settings.btnSpacing == 'spaced' -%}

                    {%- if section.settings.btnPosition == 'start' -%}
                        {{- countdownBarCta -}}
                        <div class="site-countdown-bar-content">{{ countdownBarContent }}</div>
                    {%- else -%}
                        <div class="site-countdown-bar-content">{{ countdownBarContent }}</div>
                        {{- countdownBarCta -}}
                    {%- endif -%}

                {%- else -%}

                    {%- if section.settings.btnPosition == 'start' -%}
                        {{- countdownBarCta -}}
                        {{- countdownBarContent -}}
                    {%- else -%}
                        {{- countdownBarContent -}}
                        {{- countdownBarCta -}}
                    {%- endif -%}

                {%- endif -%}

            </div>

        </div>

    </div>

{% endif %}

