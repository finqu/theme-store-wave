{%- assign sectionMinHeight = section.settings.sectionMinHeight | append: 'vh' -%}
{%- assign sectionMinHeightMobile = section.settings.sectionMinHeightMobile | append: 'vh' -%}
{%- assign sectionAnimationOrder = 1 -%}
{%- assign contentMaxWidth = section.settings.contentMaxWidth | default: '60' -%}
{%- if section.settings.contentPaddingX != nil and section.settings.contentPaddingX != blank -%}
    {%- assign contentPaddingX = section.settings.contentPaddingX -%}
{%- else -%}
    {%- assign contentPaddingX = 2 -%}
{%- endif -%}

{%- if contentMaxWidth == '100' -%}
    {%- assign contentMaxWidthClass = 'w-100' -%}
    {%- assign contentMaxWidthClassFluid = 'container-fluid' -%}
{%- else -%}
    {%- assign contentMaxWidthClass = 'w-100 max-w-lg-' | append: contentMaxWidth -%}
    {%- assign contentMaxWidthClassFluid = 'container-fluid max-w-lg-' | append: contentMaxWidth -%}
{%- endif -%}

{%- assign sectionContainerPaddingX = contentPaddingX | append: 'rem' -%}

{%- if section.settings.imgBlur != '0' -%}

    {%- capture sectionStyle -%}
        #finqu-section-{{ section.id }} .lazy {
            transform: scale(1.0{{ section.settings.imgBlur | divided_by: 2 | plus: 2 }});
            filter: blur({{ section.settings.imgBlur }}px);
        }
    {%- endcapture -%}

    <style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- endif -%}

{%- assign textHorizontalAlignSetting = section.settings.textHorizontalAlign -%}
{%- if textHorizontalAlignSetting == 'nil' -%}
    {%- assign textHorizontalAlign = settings.sectionTextAlign -%}
{%- else -%}
    {%- assign textHorizontalAlign = textHorizontalAlignSetting -%}
{%- endif -%}


{%- capture imgContent -%}

     {%- capture imgSrc -%}

        {%- capture placeholderSvg -%}
            {%- render 'placeholder-svg', type: 'background', base64: true -%}
        {%- endcapture -%}

        {%- if section.settings.img -%}
            {% if section.settings.imgDimming > 0 %}linear-gradient(0deg, rgb(0,0,0, {{- section.settings.imgDimming -}}%), rgb(0,0,0, {{- section.settings.imgDimming -}}%)) | {% endif %}url('{{- section.settings.img | thumb: '1920,1080' -}}') 1x, url('{{- section.settings.img | thumb: '1920,1080' | thumb: '@2x' -}}') 2x
        {%- else -%}
            {% if section.settings.imgDimming > 0 %}linear-gradient(0deg, rgb(0,0,0, {{- section.settings.imgDimming -}}%), rgb(0,0,0, {{- section.settings.imgDimming -}}%)) | {% endif %}url('{{ placeholderSvg | strip }}') 1x
        {%- endif -%}

    {%- endcapture -%}

    <div class="lazy position-absolute top-0 start-0 w-100 h-100 bg-position-center{% if section.settings.img %} bg-size-cover{% endif %}" data-bg-set="{{- imgSrc | strip -}}"{% if section.settings.img.offset_left or section.settings.img.offset_top %} style="--bg-position: {{ section.settings.img.offset_left }}% {{ section.settings.img.offset_top }}%"{% endif %}></div>

{%- endcapture -%}

{%- capture sectionContent -%}

    {%- if section.settings.countdownPosition == 'below' -%}

        {%- assign sectionBgImg = section.settings.img -%}
        {%- assign sectionBgImgDimming = section.settings.imgDimming -%}
        {%- assign sectionBgImgBlur = section.settings.imgBlur -%}

        <div class="row gy-5 justify-content-{{ textHorizontalAlign }}">

            <div class="text-container col align-self-center {{ contentMaxWidthClass }}">

                {% render 'hero-content', section: section, textHorizontalAlign: textHorizontalAlign, sectionAnimationOrder: sectionAnimationOrder %}

            </div>

        </div>

    {%- elsif section.settings.countdownPosition == 'side' -%}

        {%- assign sectionContainer = 'none' -%}

        <div class="d-flex flex-column flex-md-row">

            <div class="flex-grow-1 position-relative overflow-hidden min-h" style="--min-height: {{ section.settings.sectionMinHeightMobile }}vh; --min-height-lg: {{ section.settings.sectionMinHeight }}vh">

                <div class="d-flex align-items-{{ section.settings.textVerticalAlign }} position-md-absolute top-0 start-0 w-100 h-100">

                    <div class="d-flex flex-grow-1 justify-content-{{ textHorizontalAlign }} py-4">

                        <div class="text-container {{ contentMaxWidthClassFluid }}">

                            {% render 'hero-content', section: section, textHorizontalAlign: textHorizontalAlign, sectionAnimationOrder: sectionAnimationOrder %}

                        </div>

                    </div>

                </div>

            </div>

            <div class="flex-grow-1 position-relative overflow-hidden min-h" style="--min-height: {{ section.settings.sectionMinHeightMobile }}vh; --min-height-lg: {{ section.settings.sectionMinHeight }}vh">

                {{- imgContent -}}

            </div>

        </div>

    {%- endif -%}

{%- endcapture -%}

{% render 'section', section: section, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false, sectionTextAlign: textHorizontalAlign, sectionHeaderTextAlign: textHorizontalAlign, sectionMinHeight: sectionMinHeight, sectionMinHeightMobile: sectionMinHeightMobile, sectionBgImg: sectionBgImg, sectionBgImgDimming: sectionBgImgDimming, sectionBgImgBlur: sectionBgImgBlur, sectionContainer: sectionContainer, sectionContainerPaddingX: sectionContainerPaddingX %}

