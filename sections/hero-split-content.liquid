                        "step": 5,
                        "default": "0",
                        "unit": "%"
                    },
                    {
                        "id": "imgBlur",
                        "label": "t:all.settings.imgBlur.label",
                        "type": "range",
                        "min": 0,
                        "max": 10,
                        "step": 1,
                        "default": "0",
                        "unit": " "
                    },
                    {
                        "id": "imgMaxSize",
                        "label": "t:sections.hero-split-content.settings.imgMaxSize.label",
                        "type": "range",
                        "min": 25,
                        "max": 100,
                        "step": 5,
                        "default": "100",
                        "unit": "%",
                        "conditions": [
                            "imgFit eq contain"
                        ]
                    }
                ],
                "id": "content"
            },
            {
                "title": "t:all.groups.settings.title",
                "settings": {
                    "list_type": "list",
                    "groups": [
                        {
                            "title": "t:all.groups.style.title",
                            "id": "style",
                            "settings": [
                                {
                                    "id": "sectionColorScheme",
                                    "type": "select",
                                    "label": "t:all.settings.sectionColorScheme.label",
                                    "default": false,
                                    "options": [
                                        {
                                            "value": false,
                                            "label": "t:all.settings.sectionColorScheme.options.false.label"
                                        },
                                        {
                                            "value": "secondary",
                                            "label": "t:all.settings.sectionColorScheme.options.secondary.label"
                                        },
                                        {
                                            "value": "light",
                                            "label": "t:all.settings.sectionColorScheme.options.light.label"
                                        },
                                        {
                                            "value": "dark",
                                            "label": "t:all.settings.sectionColorScheme.options.dark.label"
                                        },
                                        {
                                            "value": "accent",
                                            "label": "t:all.settings.sectionColorScheme.options.accent.label"
                                        },
                                        {
                                            "value": "custom",
                                            "label": "t:all.settings.sectionColorScheme.options.custom.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "style_custom_color",
                                    "type": "color",
                                    "alpha": true,
                                    "gradient": true,
                                    "label": "t:all.settings.style_custom_color.label",
                                    "default": "#f3f5f6",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_color",
                                    "type": "color",
                                    "alpha": true,
                                    "label": "t:all.settings.style_custom_content_color.label",
                                    "default": "#ffffff",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_content_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "contentBlockSpacing",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.contentBlockSpacing.label",
                                    "default": "1rem",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.contentBlockSpacing.options.nil.label"
                                        },
                                        {
                                            "value": "0.5rem",
                                            "label": "t:all.settings.contentBlockSpacing.options.0_5rem.label"
                                        },
                                        {
                                            "value": "1rem",
                                            "label": "t:all.settings.contentBlockSpacing.options.1rem.label"
                                        },
                                        {
                                            "value": "1.5rem",
                                            "label": "t:all.settings.contentBlockSpacing.options.1_5rem.label"
                                        },
                                        {
                                            "value": "2rem",
                                            "label": "t:all.settings.contentBlockSpacing.options.2rem.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "sectionMinHeight",
                                    "type": "range",
                                    "label": "t:all.settings.sectionMinHeight.label",
                                    "min": 40,
                                    "max": 100,
                                    "step": 5,
                                    "default": "60",
                                    "unit": "vh"
                                },
                                {
                                    "id": "sectionMinHeightMobile",
                                    "type": "range",
                                    "label": "t:all.settings.sectionMinHeightMobile.label",
                                    "min": 40,
                                    "max": 100,
                                    "step": 5,
                                    "default": "60",
                                    "unit": "vh"
                                }
                            ]
                        },
                        {
                            "title": "t:all.groups.layout.title",
                            "id": "layout",
                            "settings": [
                                {
                                    "id": "contentPaddingX",
                                    "label": "t:all.settings.contentPaddingX.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 8,
                                    "step": 0.5,
                                    "default": "2",
                                    "unit": "rem"
                                },
                                {
                                    "id": "contentMaxWidth",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.contentMaxWidth.label",
                                    "default": "80",
                                    "options": [
                                        {
                                            "value": "40",
                                            "label": "t:all.settings.contentMaxWidth.options.40.label"
                                        },
                                        {
                                            "value": "50",
                                            "label": "t:all.settings.contentMaxWidth.options.50.label"
                                        },
                                        {
                                            "value": "60",
                                            "label": "t:all.settings.contentMaxWidth.options.60.label"
                                        },
                                        {
                                            "value": "80",
                                            "label": "t:all.settings.contentMaxWidth.options.80.label"
                                        },
                                        {
                                            "value": "100",
                                            "label": "t:all.settings.contentMaxWidth.options.100.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "imgFit",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.imgFit.label",
                                    "default": "cover",
                                    "options": [
                                        {
                                            "value": "cover",
                                            "label": "t:all.settings.imgFit.options.cover.label"
                                        },
                                        {
                                            "value": "contain",
                                            "label": "t:all.settings.imgFit.options.contain.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "textHorizontalAlign",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.textHorizontalAlign.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.textHorizontalAlign.options.nil.label"
                                        },
                                        {
                                            "value": "start",
                                            "label": "t:all.settings.textHorizontalAlign.options.start.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.textHorizontalAlign.options.center.label"
                                        },
                                        {
                                            "value": "end",
                                            "label": "t:all.settings.textHorizontalAlign.options.end.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "textVerticalAlign",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.textVerticalAlign.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "start",
                                            "label": "t:all.settings.textVerticalAlign.options.start.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.textVerticalAlign.options.center.label"
                                        },
                                        {
                                            "value": "end",
                                            "label": "t:all.settings.textVerticalAlign.options.end.label"
                                        }
                                    ]
                                }
                            ]
                        }
                    ]
                },
                "id": "settings"
            }
        ]
    },
    "containers": [
        {
            "id": "hero-title",
            "title": "t:sections.hero-split-content.containers.hero-title.title",
            "allowed_blocks": [
                "badge",
                "heading",
                "text",
                "countdown",
                "spacer",
                "separator"
