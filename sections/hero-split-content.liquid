{%- assign sectionMinHeight = section.settings.sectionMinHeight | append: 'vh' -%}
{%- assign sectionMinHeightMobile = section.settings.sectionMinHeightMobile | append: 'vh' -%}
{%- assign sectionAnimationOrder = 1 -%}
{%- assign contentMaxWidth = section.settings.contentMaxWidth | default: '80' -%}
{%- if section.settings.contentPaddingX != nil and section.settings.contentPaddingX != blank -%}
    {%- assign contentPaddingX = section.settings.contentPaddingX -%}
{%- else -%}
    {%- assign contentPaddingX = 2 -%}
{%- endif -%}

{%- if contentMaxWidth == '100' -%}
    {%- assign contentMaxWidthClass = 'container-fluid' -%}
{%- else -%}
    {%- assign contentMaxWidthClass = 'container-fluid max-w-lg-' | append: contentMaxWidth -%}
{%- endif -%}

{%- assign sectionContainerPaddingX = contentPaddingX | append: 'rem' -%}

{%- if section.settings.imgBlur != '0' -%}

    {%- capture sectionStyle -%}
        #finqu-section-{{ section.id }} .lazy {
            transform: scale(1.0{{ section.settings.imgBlur | divided_by: 2 | plus: 2 }});
            filter: blur({{ section.settings.imgBlur }}px);
        }
    {%- endcapture -%}

    <style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- endif -%}

{%- capture imgContent -%}

    {%- capture imgSrc -%}

        {%- capture placeholderSvg -%}
            {%- render 'placeholder-svg', type: 'background', base64: true -%}
        {%- endcapture -%}

        {%- if section.settings.img -%}
            {% if section.settings.imgDimming > 0 %}linear-gradient(0deg, rgb(0,0,0, {{- section.settings.imgDimming -}}%), rgb(0,0,0, {{- section.settings.imgDimming -}}%)) | {% endif %}url('{{- section.settings.img | thumb: '1920,1080' -}}') 1x, url('{{- section.settings.img | thumb: '1920,1080' | thumb: '@2x' -}}') 2x
        {%- else -%}
            {% if section.settings.imgDimming > 0 %}linear-gradient(0deg, rgb(0,0,0, {{- section.settings.imgDimming -}}%), rgb(0,0,0, {{- section.settings.imgDimming -}}%)) | {% endif %}url('{{ placeholderSvg | strip }}') 1x
        {%- endif -%}

    {%- endcapture -%}

    {%- assign imgFit = section.settings.imgFit | default: 'cover' -%}
    {%- assign imgMaxSize = section.settings.imgMaxSize | default: 100 -%}

    {%- capture imgStyle -%}
        {%- if section.settings.img.offset_left or section.settings.img.offset_top -%}--bg-position: {{ section.settings.img.offset_left }}% {{ section.settings.img.offset_top }}%;{%- endif -%}
        {%- if imgFit == 'contain' -%}width: {{ imgMaxSize }}%; height: {{ imgMaxSize }}%;{%- endif -%}
    {%- endcapture -%}

    {%- if imgFit == 'contain' -%}

        <div class="position-absolute top-0 start-0 w-100 h-100 d-flex align-items-center justify-content-center">

            <div class="lazy bg-position-center bg-size-contain" data-bg-set="{{- imgSrc | strip -}}"{% if imgStyle != blank %} style="{{ imgStyle | strip }}"{% endif %}></div>

        </div>

    {%- else -%}

        <div class="lazy position-absolute top-0 start-0 w-100 h-100 bg-position-center{% if section.settings.img %} bg-size-cover{% endif %}" data-bg-set="{{- imgSrc | strip -}}"{% if section.settings.img.offset_left or section.settings.img.offset_top %} style="--bg-position: {{ section.settings.img.offset_left }}% {{ section.settings.img.offset_top }}%"{% endif %}></div>

    {%- endif -%}

{%- endcapture -%}

{%- capture textContent -%}

    {%- if section.settings.textHorizontalAlign == 'nil' -%}
        {%- assign textHorizontalAlign = settings.sectionTextAlign -%}
    {%- else -%}
        {%- assign textHorizontalAlign = section.settings.textHorizontalAlign -%}
    {%- endif -%}

    <div class="d-flex align-items-{{ section.settings.textVerticalAlign }} position-absolute top-0 start-0 w-100 h-100">

        <div class="d-flex flex-grow-1 justify-content-{{ textHorizontalAlign }} py-6">

            <div class="text-container {{ contentMaxWidthClass }}">

                {% render 'hero-content', section: section, textHorizontalAlign: textHorizontalAlign, sectionAnimationOrder: sectionAnimationOrder %}

            </div>

        </div>

    </div>

{%- endcapture -%}

{%- capture sectionContent -%}

    <div class="d-flex flex-column flex-md-row">

        <div class="flex-grow-1 position-relative overflow-hidden min-h" style="--min-height: {{ section.settings.sectionMinHeightMobile }}vh; --min-height-lg: {{ section.settings.sectionMinHeight }}vh">

            {{- textContent -}}

        </div>

        <div class="flex-grow-1 position-relative overflow-hidden min-h" style="--min-height: {{ section.settings.sectionMinHeightMobile }}vh; --min-height-lg: {{ section.settings.sectionMinHeight }}vh">

            {{- imgContent -}}

        </div>

    </div>

{%- endcapture -%}

{% render 'section', section: section, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false, sectionTextAlign: textHorizontalAlign, sectionHeaderTextAlign: textHorizontalAlign, sectionMinHeight: sectionMinHeight, sectionMinHeightMobile: sectionMinHeightMobile, sectionContainer: 'none', sectionPaddingMode: 'custom', sectionPaddingTop: 0, sectionPaddingBottom: 0, sectionContainerPaddingX: sectionContainerPaddingX, sectionContainerPaddingY: sectionContainerPaddingX %}

{% schema %}
{
    "name": "t:sections.hero-split-content.name",
    "tag": "section",
    "class": "section section-hero-split-content",
    "category": "theme-hero",
    "keywords": [
        "Lander"
    ],
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.content.title",
