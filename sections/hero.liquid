{%- assign sectionMinHeight = section.settings.sectionHeight | default: 60 | append: 'dvh' -%}
{%- assign sectionMinHeightMobile = section.settings.sectionHeightMobile | default: 60 | append: 'dvh' -%}
{%- assign sectionAnimationOrder = 1 -%}
{%- assign contentMaxWidth = section.settings.contentMaxWidth | default: '60' -%}
{%- if section.settings.contentPaddingX != nil and section.settings.contentPaddingX != blank -%}
    {%- assign contentPaddingX = section.settings.contentPaddingX -%}
{%- else -%}
    {%- assign contentPaddingX = 2 -%}
{%- endif -%}

{%- if contentMaxWidth == '100' -%}
    {%- assign contentMaxWidthClass = 'w-100' -%}
{%- else -%}
    {%- assign contentMaxWidthClass = 'w-100 max-w-lg-' | append: contentMaxWidth -%}
{%- endif -%}

{%- assign sectionContainerPaddingX = contentPaddingX | append: 'rem' -%}

{%- if section.settings.textHorizontalAlign == 'nil' -%}
    {%- assign textHorizontalAlign = settings.sectionTextAlign -%}
{%- else -%}
    {%- assign textHorizontalAlign = section.settings.textHorizontalAlign -%}
{%- endif -%}

{%- capture sectionContent -%}

    <style>
        .section-site-header { anchor-name: --site-header; }
        #finqu-section-{{ section.id }} > .section-inner { height: auto; }
        #finqu-section-{{ section.id }} .hero-content-viewport {
            display: flex;
            flex: 1 0 auto;
            width: 100%;
            position: relative;
            z-index: 1;
            align-items: {{ section.settings.textVerticalAlign | default: 'center' }};
            align-items: safe {{ section.settings.textVerticalAlign | default: 'center' }};
        }
        .template-frontpage .section-site-header + #finqu-section-{{ section.id }} > .section-inner {
            padding-top: max(var(--section-padding-top, 0px), 74px);
        }
        @media screen and (min-width: {{ settings.styleGridBreakpointMd }}) {
            .template-frontpage .section-site-header + #finqu-section-{{ section.id }} > .section-inner {
                padding-top: max(var(--section-padding-top, 0px), 165px);
            }
        }
        @supports (padding-top: anchor-size(--site-header height)) {
            .template-frontpage .section-site-header + #finqu-section-{{ section.id }} > .section-inner {
                padding-top: max(var(--section-padding-top, 0px), anchor-size(--site-header height, 74px));
            }
            @media screen and (min-width: {{ settings.styleGridBreakpointMd }}) {
                .template-frontpage .section-site-header + #finqu-section-{{ section.id }} > .section-inner {
                    padding-top: max(var(--section-padding-top, 0px), anchor-size(--site-header height, 165px));
                }
            }
        }
    </style>

    <div class="hero-content-viewport d-flex" style="--hero-content-align-y: {{ section.settings.textVerticalAlign | default: 'center' }}">

        <div class="container d-flex justify-content-{{ textHorizontalAlign }}">

            <div class="text-container {{ contentMaxWidthClass }}">

                {% render 'hero-content', section: section, textHorizontalAlign: textHorizontalAlign, sectionAnimationOrder: sectionAnimationOrder %}

            </div>

        </div>

    </div>

{%- endcapture -%}

{% render 'section', section: section, sectionCustomContent: sectionContent, sectionContentAnimation: false, sectionHeader: false, sectionTextAlign: textHorizontalAlign, sectionHeaderTextAlign: textHorizontalAlign, sectionHeight: 'auto', sectionHeightMobile: 'auto', sectionMinHeight: sectionMinHeight, sectionMinHeightMobile: sectionMinHeightMobile, sectionContainer: 'none', sectionContainerPaddingX: sectionContainerPaddingX, sectionContainerPaddingY: sectionContainerPaddingX %}

