{% assign textAlign = section.settings.sectionTextAlign %}

{% if textAlign == 'nil' %}
    {% assign textAlign = settings.sectionTextAlign %}
{% endif %}

{%- capture slides -%}

    {%- for item in section.settings.setting_blocks.items -%}

        {%- assign item_show_icon = false -%}
        {%- assign item_icon_svg = false -%}
        {%- if item.settings.iconFormat == 'svg' -%}
            {%- if item.settings.svgContent != blank -%}
                {%- assign item_show_icon = true -%}
                {%- assign item_icon_svg = true -%}
            {%- elsif request.design_mode -%}
                {%- assign item_show_icon = true -%}
                {%- assign item_icon_svg = true -%}
            {%- endif -%}
        {%- elsif item.settings.img != blank -%}
            {%- assign item_show_icon = true -%}
        {%- elsif request.design_mode -%}
            {%- assign item_show_icon = true -%}
        {%- endif -%}

        <div class="swiper-slide">

            <div class="swiper-slide-inner icons-with-text-item icons-with-text-item-{{ section.settings.orientation }}">

                {%- if section.settings.orientation == 'horizontal' -%}

                    <div class="d-flex flex-column">

                        {%- if item_show_icon -%}

                            {% if item_icon_svg %}

                                {% if item.settings.svgContent %}

                                    <div class="icons-with-text-icon text-{{ textAlign }}">

                                        {{- item.settings.svgContent | replace: '<svg ', '<svg class="svg-icon svg-icon-3x" ' -}}

                                    </div>

                                {% else %}

                                    <div class="icons-with-text-icon aspect-ratio-1-1 align-self-{{ textAlign }}">

                                        <div class="aspect-ratio-container max-w-px-40">

                                            {%- capture imgSrc -%}
                                                {% render 'placeholder-svg', type: 'image', base64: true %}
                                            {%- endcapture -%}

                                            <img class="lazy lazy-disable-transition aspect-ratio-item svg-placeholder" alt="{{ item.settings.title }}" data-src="{{ imgSrc | strip }}">

                                        </div>

                                    </div>

                                {% endif %}
                            
                            {% else %}

                                <div class="icons-with-text-icon aspect-ratio-1-1 align-self-{{ textAlign }}">

                                    <div class="aspect-ratio-container max-w-px-40">

                                        {% if item.settings.img %}

                                            <img
                                                alt="{{ item.settings.img.alt }}"
                                                data-src="{{ item.settings.img | thumb: '40,40' }}"
                                                data-srcset="{{ item.settings.img | thumb: '40,40' }} 1x,{{ item.settings.img | thumb: '40,40' | thumb:'@2x' }} 2x"
                                                class="lazy aspect-ratio-item"{% if item.settings.img.offset_left or item.settings.img.offset_top %} style="--object-position: {{ item.settings.img.offset_left }}% {{ item.settings.img.offset_top }}%"{% endif %}>

                                        {% else %}

                                            {%- capture imgSrc -%}
                                                {% render 'placeholder-svg', type: 'image', base64: true %}
                                            {%- endcapture -%}

                                            <img class="lazy lazy-disable-transition aspect-ratio-item svg-placeholder" alt="{{ item.settings.title }}" data-src="{{ imgSrc | strip }}">

                                        {% endif %}

                                    </div>

                                </div>

                            {% endif %}

                        {%- endif -%}

                        <div class="d-grid gap-2{% if item_show_icon %} mt-g{% endif %} text-{{ textAlign }}">

                            {% if item.settings.title %}

                                <span class="text-title d-block fw-medium">
                                    {{ item.settings.title }}
                                </span>

                            {% endif %}

                            {{ item.settings.richtext }}

                        </div>

                    </div>

                {%- else -%}

                    <div class="d-flex justify-content-{{ textAlign }}">

                        {%- if item_show_icon -%}

                            <div class="icons-with-text-icon me-g">

                                {% if item_icon_svg %}

                                    {% if item.settings.svgContent %}

                                        <div>

                                            {{- item.settings.svgContent | replace: '<svg ', '<svg class="svg-icon svg-icon-3x" ' -}}

                                        </div>

                                    {% else %}

                                        <div class="aspect-ratio-1-1">

                                            <div class="aspect-ratio-container max-w-px-40">

                                                {%- capture imgSrc -%}
                                                    {% render 'placeholder-svg', type: 'image', base64: true %}
                                                {%- endcapture -%}

                                                <img class="lazy lazy-disable-transition aspect-ratio-item svg-placeholder" alt="{{ item.settings.title }}" data-src="{{ imgSrc | strip }}">

                                            </div>

                                        </div>

                                    {% endif %}
                                
                                {% else %}

                                    <div class="aspect-ratio-1-1">

                                        <div class="aspect-ratio-container max-w-px-40">

                                            {% if item.settings.img %}

                                                <img
                                                    alt="{{ item.settings.img.alt }}"
                                                    data-src="{{ item.settings.img | thumb: '40,40' }}"
                                                    data-srcset="{{ item.settings.img | thumb: '40,40' }} 1x,{{ item.settings.img | thumb: '40,40' | thumb:'@2x' }} 2x"
                                                    class="lazy aspect-ratio-item"{% if item.settings.img.offset_left or item.settings.img.offset_top %} style="--object-position: {{ item.settings.img.offset_left }}% {{ item.settings.img.offset_top }}%"{% endif %}>

                                            {% else %}

                                                {%- capture imgSrc -%}
                                                    {% render 'placeholder-svg', type: 'image', base64: true %}
                                                {%- endcapture -%}

                                                <img class="lazy lazy-disable-transition aspect-ratio-item svg-placeholder" alt="{{ item.settings.title }}" data-src="{{ imgSrc | strip }}">

                                            {% endif %}

                                        </div>

                                    </div>

                                {% endif %}

                            </div>

                        {%- endif -%}

                        <div class="d-grid gap-2 text-start">

                            {% if item.settings.title %}

                                <span class="text-title d-block fw-medium">
                                    {{ item.settings.title }}
                                </span>

                            {% endif %}

                            {{ item.settings.richtext }}

                        </div>

                    </div>

                {%- endif -%}

            </div>

        </div>

    {%- endfor -%}

{%- endcapture -%}

{%- capture sectionHeaderBlocks -%}
    {% container 'header' %}
{%- endcapture -%}

{%- capture sectionHeaderContent -%}
    {%- if sectionHeaderBlocks != blank -%}
        <div class="section-header">
            <div class="container">
                {{- sectionHeaderBlocks -}}
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture sectionContent -%}

    {%- render 'swiper', slides: slides, pagination: 'on', slidesPerView: section.settings.setting_blocks.items.size, slidesPerViewMobile: 2, style: 2, paginationPosition: 'relative', evenHeightSlides: true, standalone: true, freemode: true, class: 'icons-with-text-carousel swiper-navigation-hide-on-desktop' -%}

{%- endcapture -%}

{% render 'section', section: section, sectionHeaderContent: sectionHeaderContent, sectionContent: sectionContent, sectionHeader: false %}

{% schema %}
{
    "name": "t:sections.icons-with-text.name",
