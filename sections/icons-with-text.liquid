    "class": "section section-icons-with-text",
    "category": "theme-icon",
    "keywords": [
        "Image",
        "Icon",
        "Svg"
    ],
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:sections.icons-with-text.groups.items.title",
