                            },
                            {
                                "id": "svgContent",
                                "type": "text",
                                "label": "t:sections.icons-with-text.setting_blocks.text.settings.svgContent.label",
                                "conditions": [
                                    "iconFormat eq svg"
                                ]
                            },
                            {
                                "id": "title",
