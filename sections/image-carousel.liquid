{%- if section.settings.sectionMinHeight == blank -%}
    {%- assign sectionMinHeightValue = '60' -%}
{%- else -%}
    {%- assign sectionMinHeightValue = section.settings.sectionMinHeight -%}
{%- endif -%}

{%- if section.settings.sectionMinHeightMobile == blank -%}
    {%- assign sectionMinHeightMobileValue = '60' -%}
{%- else -%}
    {%- assign sectionMinHeightMobileValue = section.settings.sectionMinHeightMobile -%}
{%- endif -%}

{%- assign sectionMinHeight = sectionMinHeightValue | append: 'vh' -%}
{%- assign sectionMinHeightMobile = sectionMinHeightMobileValue | append: 'vh' -%}
{%- assign sectionHandle = '#finqu-section-' | append: section.id -%}

{%- if section.settings.textHorizontalAlign == 'nil' -%}
    {%- assign textHorizontalAlign = settings.sectionTextAlign -%}
{%- else -%}
    {%- assign textHorizontalAlign = section.settings.textHorizontalAlign -%}
{%- endif -%}

{%- capture sectionStyle -%}
    #finqu-section-{{ section.id }} .swiper {
        --style-grid-container-padding-y: var(--style-grid-container-padding-x);
    }
    @media screen and (min-width: {{ settings.styleGridBreakpointMd }}) {
        #finqu-section-{{ section.id }} .swiper {
            --style-grid-container-padding-x: 4rem;
        }
    }
    #finqu-section-{{ section.id }} .swiper {
        --style-grid-gutter-width: 0;
    }
    {%- for item in section.settings.setting_blocks.items -%}
        #finqu-section-{{ section.id }} .section-content .swiper-wrapper > div:nth-child({{ forloop.index}}) {
            {%- render 'section-color-scheme' colorScheme: item.settings.colorScheme, customColor: item.settings.colorSchemeCustomColor -%}
        }
    {%- endfor -%}
    {%- if section.settings.imgBlur != '0' -%}
        #finqu-section-{{ section.id }} .lazy {
            transform: scale(1.0{{ section.settings.imgBlur | divided_by: 2 | plus: 2 }});
            filter: blur({{ section.settings.imgBlur }}px);
        }
    {%- endif -%}
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- capture sectionContent -%}

    {%- capture carouselSlides -%}

        {% if section.settings.setting_blocks.items.size > 0 %}

            {% for item in section.settings.setting_blocks.items %}

                {%- capture imgSrc -%}

                    {%- capture placeholderSvg -%}
                        {%- render 'placeholder-svg', type: 'background', base64: true -%}
                    {%- endcapture -%}

                    {%- if item.settings.img -%}
                        {% if section.settings.imgDimming > 0 %}linear-gradient(0deg, rgb(0,0,0, {{- section.settings.imgDimming > 0 -}}%), rgb(0,0,0, {{- section.settings.imgDimming > 0 -}}%)) | {% endif %}url('{{- item.settings.img | thumb: '1920,1080' -}}') 1x, url('{{- item.settings.img | thumb: '1920,1080' | thumb: '@2x' -}}') 2x
                    {%- else -%}
                        {% if section.settings.imgDimming > 0 %}linear-gradient(0deg, rgb(0,0,0, {{- section.settings.imgDimming > 0 -}}%), rgb(0,0,0, {{- section.settings.imgDimming > 0 -}}%)) | {% endif %}url('{{ placeholderSvg | strip }}') 1x
                    {%- endif -%}

                {%- endcapture -%}

                <div class="swiper-slide">

                   <div class="swiper-slide-inner position-relative min-h" style="--min-height: {{ sectionMinHeightMobileValue }}vh; --min-height-lg: {{ sectionMinHeightValue }}vh">

                        <div class="lazy position-absolute top-0 start-0 w-100 h-100{% if item.settings.img %} bg-size-cover{% endif %}" data-bg-set="{{- imgSrc | strip -}}"{% if item.settings.img.offset_left or item.settings.img.offset_top %} style="--bg-position: {{ item.settings.img.offset_left }}% {{ item.settings.img.offset_top }}%"{% endif %}></div>

                        <div class="d-flex position-absolute top-0 start-0 w-100 h-100">

                            <div class="container-fluid align-self-{{ section.settings.textVerticalAlign }}">

                                <div class="text-{{ textHorizontalAlign }}{% if section.settings.carouselEffect == 'slide' %} animation-animated animation-fadeInUp animation-delay animation-slow{% endif %}">

                                    {% render 'section-header', sectionTitle: item.settings.title, sectionTitleTag: section.settings.sectionTitleTag, sectionSubtitle: item.settings.subtitle, sectionSubtitleTag: section.settings.sectionSubtitleTag, sectionOverline: item.settings.overline, sectionOverlineTag: section.settings.sectionOverlineTag, sectionHeaderContainer: 'none', sectionAnimation: false, sectionHeaderFontSizeScale: section.settings.sectionHeaderFontSizeScale %}

                                    {% if item.settings.btnLink.text %}

                                        <div class="mt-7">

                                            {%- render 'section-quick-link', theme: section.settings.btnTheme, variant: section.settings.btnVariant, size: section.settings.btnSize, text: item.settings.btnLink.text, url: item.settings.btnLink.url, target: item.settings.btnLink.target  -%}

                                        </div>

                                    {% endif %}

                                </div>

                            </div>

                        </div>

                    </div>

                </div>

            {% endfor %}

        {% elsif request.design_mode %}

            {%- capture imgSrc -%}

                {%- capture placeholderSvg -%}
                    {%- render 'placeholder-svg', type: 'background', base64: true -%}
                {%- endcapture -%}

                {% if section.settings.imgDimming > 0 %}linear-gradient(0deg, rgb(0,0,0, {{- section.settings.imgDimming -}}%), rgb(0,0,0, {{- section.settings.imgDimming -}}%)) | {% endif %}url('{{ placeholderSvg | strip }}') 1x

            {%- endcapture -%}

            {% for num in (1..2) %}

                <div class="swiper-slide">

                    <div class="swiper-slide-inner position-relative min-h" style="--min-height: {{ sectionMinHeightMobileValue }}vh">

                        <div class="lazy position-absolute top-0 start-0 w-100 h-100 bg-position-center" data-bg-set="{{- imgSrc | strip -}}"></div>

                    </div>

                </div>

            {% endfor %}

        {% endif %}

    {%- endcapture -%}

    {%- render 'swiper', slides: carouselSlides, pagination: section.settings.carouselPagination, navigation: section.settings.carouselNavigation, slidesPerView: 1, style: 2, paginationPosition: 'fixed', loop: section.settings.carouselLoop == 'on', evenHeightSlides: true, standalone: true, autoplaySpeed: section.settings.carouselAutoplaySpeed, effect: section.settings.carouselEffect, colorScheme: section.settings.carouselColorScheme, customColor: section.settings.carouselColorSchemeCustomColor, containerHandle: sectionHandle -%}

{%- endcapture -%}

{% render 'section', section: section, sectionAction: sectionAction, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false, sectionHeaderTextAlign: textHorizontalAlign, sectionMinHeight: sectionMinHeight, sectionMinHeightMobile: sectionMinHeightMobile %}

