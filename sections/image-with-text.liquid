{%- assign cols = section.settings.rowLayout | split: ',' -%}
{%- assign leftColSize = cols[0] -%}
{%- assign rightColSize = cols[1] -%}
{%- assign sectionAnimationOrder = 0 -%}

{%- if section.settings.sectionHighlightItems == 'nil' and settings.sectionHighlightItems == true or section.settings.sectionHighlightItems == true -%}
    {%- assign sectionHighlightItems = true -%}
{%- endif -%}

{%- assign textVerticalAlign = section.settings.textVerticalAlign | default: 'center' -%}
{%- assign imgVerticalAlign = section.settings.imgVerticalAlign | default: 'center' -%}

{%- if sectionHighlightItems and section.settings.imgEffect -%}

    {%- capture sectionStyle -%}
        #finqu-section-{{ section.id }} .text-container {
            z-index: 1;
            {%- if section.settings.imgPosition == 'start' -%}
                transform: translateX(-10%);
                padding-inline-start: var(--style-grid-gutter-width);
            {%- elsif section.settings.imgPosition == 'end' -%}
                transform: translateX(10%);
                padding-inline-end: var(--style-grid-gutter-width);
            {%- endif -%}
        }
    {%- endcapture -%}

    <style media="screen and (min-width: {{ settings.styleGridBreakpointLg }})">{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- endif -%}

{%- capture imgColContent -%}

    {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

    <div class="section-media" data-aos="{% if section.settings.imgPosition == 'start' %}animation-fadeInLeft{% else %}animation-fadeInRight{% endif %}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">
        {% block 'image' id:'section-image' %}
    </div>

{%- endcapture -%}

{%- capture textColContent -%}

    {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

    {%- if section.settings.textHorizontalAlign == 'nil' -%}
        {%- assign textHorizontalAlign = settings.sectionTextAlign -%}
    {%- else -%}
        {%- assign textHorizontalAlign = section.settings.textHorizontalAlign -%}
    {%- endif -%}

    <div class="section-highlight-item section-highlight-item-md text-{{ textHorizontalAlign }}" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">
        {% container 'content' %}
    </div>

{%- endcapture -%}

{%- capture sectionContent -%}

    <div class="row gy-5 gx-lg-10">

        {%- if section.settings.imgPosition == 'start' -%}

            <div class="img-container col-12 col-md-6 col-lg-{{ leftColSize }} align-self-{{ imgVerticalAlign }}">
                {{- imgColContent -}}
            </div>

            <div class="text-container col-12 col-md-6 col-lg-{{ rightColSize }} align-self-{{ textVerticalAlign }}">
                {{- textColContent -}}
            </div>

        {%- elsif section.settings.imgPosition == 'end' -%}

            <div class="text-container col-12 col-md-6 col-lg-{{ leftColSize }} align-self-{{ textVerticalAlign }} order-2 order-md-1 z-2">
                {{- textColContent -}}
            </div>

            <div class="img-container col-12 col-md-6 col-lg-{{ rightColSize }} align-self-{{ imgVerticalAlign }} order-1 order-md-2">
                {{- imgColContent -}}
            </div>

        {%- endif -%}

    </div>

{%- endcapture -%}

{% render 'section', section: section, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false %}

