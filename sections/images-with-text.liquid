{%- if section.settings.sectionHighlightItems == 'nil' and settings.sectionHighlightItems == true or section.settings.sectionHighlightItems == true -%}
    {%- assign sectionHighlightItems = true -%}
{%- endif -%}

{%- assign imagesLayout = section.settings.imagesLayout | default: 1 -%}

{%- capture sectionContent -%}

    {%- if imagesLayout == 1 -%}

        {%- capture col1Content -%}

            <div class="col-12 col-md-6 d-flex flex-column">

                <div class="section-highlight-item p-md-8 d-flex flex-column my-auto">

                    {% container 'intro' %}

                </div>

                {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

                <div class="section-media {% if sectionHighlightItems %}mt-10{% else %}mt-6{% endif %}" data-aos="{%- if section.settings.swapColPositions -%}animation-fadeInRight{%- else -%}animation-fadeInLeft{%- endif -%}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">
                    {% block 'image' id:'section-image-1' %}
                </div>

            </div>

        {%- endcapture -%}

        {%- capture col2Content -%}

            <div class="col-12 col-md-6 d-flex flex-column gap-6">

                {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

                <div class="section-media" data-aos="{%- if section.settings.swapColPositions -%}animation-fadeInLeft{%- else -%}animation-fadeInRight{%- endif -%}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">
                    {% block 'image' id:'section-image-2' %}
                </div>

                {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

                <div class="section-highlight-item p-md-8 d-flex flex-column my-auto" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}"  data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                    {% container 'body' %}

                </div>

            </div>

        {%- endcapture -%}

        <div class="row gy-g gy-sm-5 gx-lg-10">

            {%- if section.settings.swapColPositions -%}

                {{- col2Content -}}
                {{- col1Content -}}

            {%- else -%}

                {{- col1Content -}}
                {{- col2Content -}}

            {%- endif -%}

        </div>

    {%- elsif imagesLayout == 2 -%}

        {%- capture imgColContent -%}

            <div class="grid gap-3 gap-md-5 gap-lg-7 align-items-center">

                <div class="g-col-5{% if section.settings.imgPosition == 'end' %} order-2{% endif %}">

                    {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

                    <div class="section-media" data-aos="{%- if section.settings.imgPosition == 'start' -%}animation-fadeInLeft{%- else -%}animation-fadeInRight{%- endif -%}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">
                        {% block 'image' id:'section-image-2' %}
                    </div>

                </div>

                <div class="g-col-7{% if section.settings.imgPosition == 'end' %} order-1{% endif %}">

                    {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

                    <div class="section-media" data-aos="{%- if section.settings.imgPosition == 'start' -%}animation-fadeInLeft{%- else -%}animation-fadeInRight{%- endif -%}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">
                        {% block 'image' id:'section-image-1' %}
                    </div>

                </div>

            </div>

        {%- endcapture -%}

        {%- capture textColContent -%}

            <div class="section-highlight-item p-md-5 p-lg-8 d-flex flex-column my-auto">

                {% container 'intro' %}
                {% container 'body' %}

            </div>

        {%- endcapture -%}

        <div class="row gy-g gy-sm-5 gx-md-5 gx-lg-5">

            {%- if section.settings.imgPosition == 'start' -%}

                <div class="col-12 col-md-7 d-flex flex-column justify-content-center">
                    {{- imgColContent -}}
                </div>

                <div class="col-12 col-md-5 d-flex flex-column justify-content-center mt-6 mt-md-0">
                    {{- textColContent -}}
                </div>

            {%- elsif section.settings.imgPosition == 'end' -%}

                <div class="col-12 col-md-5 d-flex flex-column justify-content-center">
                    {{- textColContent -}}
                </div>

                <div class="col-12 col-md-7 d-flex flex-column justify-content-center mt-6 mt-md-0">
                    {{- imgColContent -}}
                </div>

            {%- endif -%}

        </div>

    {%- endif -%}

{%- endcapture -%}

