                                        },
                                        {
                                            "value": false,
                                            "label": "t:all.settings.sectionHighlightItems.options.false.label"
                                        },
                                        {
                                            "value": true,
                                            "label": "t:all.settings.sectionHighlightItems.options.true.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "sectionContainer",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionContainer.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
