{%- assign menu = linklists[section.settings.menu] -%}

{%- capture sectionStyle -%}
    #finqu-section-{{ section.id }} .grid {
        --bs-gap: 1rem;
        --bs-columns: {{ section.settings.colsPerRow }};
    }
    {%- if section.settings.colsPerRow == 3 -%}
        @media screen and (max-width: calc({{ settings.styleGridBreakpointMd }}) - 0.1px) {
            #finqu-section-{{ section.id }} .grid {
                --bs-columns: 2;
            }
        }
    {%- elsif section.settings.colsPerRow == 4 -%}
        @media screen and (max-width: calc({{ settings.styleGridBreakpointLg }} - 0.1px)) {
            #finqu-section-{{ section.id }} .grid {
                --bs-columns: 3;
            }
        }
        @media screen and (max-width: calc({{ settings.styleGridBreakpointMd }}) - 0.1px) {
            #finqu-section-{{ section.id }} .grid {
                --bs-columns: 2;
            }
        }
    {%- elsif section.settings.colsPerRow == 5 -%}
        @media screen and (max-width: calc({{ settings.styleGridBreakpointXl }}) - 0.1px) {
            #finqu-section-{{ section.id }} .grid {
                --bs-columns: 4;
            }
        }
        @media screen and (max-width: calc({{ settings.styleGridBreakpointLg }} - 0.1px)) {
            #finqu-section-{{ section.id }} .grid {
                --bs-columns: 3;
            }
        }
        @media screen and (max-width: calc({{ settings.styleGridBreakpointMd }}) - 0.1px) {
            #finqu-section-{{ section.id }} .grid {
                --bs-columns: 2;
            }
        }
    {%- endif -%}
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- capture sectionHeaderBlocks -%}
    {% container 'header' %}
{%- endcapture -%}

{%- capture sectionHeaderContent -%}
    {%- if sectionHeaderBlocks != blank -%}
        <div class="section-header">
            <div class="container">
                {{- sectionHeaderBlocks -}}
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture sectionContent -%}

    {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

    <div class="grid" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

        {% if menu.links %}

            {% for item in menu.links %}

                <div class="link-list-item">

                    {%- if item.url -%}

                        <a href="{{ item.url }}" target="{{ item.target | default: '_self' }}" class="link-list-link">
                            {{ item.title }}
                        </a>

                    {%- else -%}

                        <span class="link-list-label">
                            {{ item.title }}
                        </span>

                    {%- endif -%}

                </div>

                {% if item.links %}

                    {% for item in item.links %}

                        <div class="link-list-item">

                            {%- if item.url -%}

                                <a href="{{ item.url }}" target="{{ item.target | default: '_self' }}" class="link-list-link">
                                    {{ item.title }}
                                </a>

                            {%- else -%}

                                <span class="link-list-label">
                                    {{ item.title }}
                                </span>

                            {%- endif -%}

                        </div>

                    {% endfor %}

                {% endif %}

            {% endfor %}

        {% elsif request.design_mode %}

            {% for num in (1..10) %}

                <div class="link-list-item">

                    <span class="link-list-label">
                        {{- 'placeholder.link' | t }} {{ num -}}
                    </span>

                </div>

            {% endfor %}

        {% endif %}

    </div>

{%- endcapture -%}

{% render 'section', section: section, sectionHeaderContent: sectionHeaderContent, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false %}

{% schema %}
{
    "name": "t:sections.link-list.name",
    "tag": "section",
    "class": "section section-link-list",
    "category": "theme-featured",
    "keywords": [
        "Link",
        "Lista"
    ],
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.content.title",
