                                },
                                {
                                    "id": "sectionBgImgDimming",
                                    "label": "t:all.settings.sectionBgImgDimming.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 90,
                                    "step": 5,
                                    "default": "0",
                                    "unit": "%",
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgBlur",
                                    "label": "t:all.settings.sectionBgImgBlur.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 10,
                                    "step": 1,
                                    "default": "0",
                                    "unit": " ",
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                }
                            ],
                            "id": "style"
                        },
                        {
                            "title": "t:all.groups.layout.title",
                            "settings": [
                                {
                                    "id": "sectionTextAlign",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionTextAlign.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.sectionTextAlign.options.nil.label"
                                        },
                                        {
                                            "value": "start",
                                            "label": "t:all.settings.sectionTextAlign.options.start.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionTextAlign.options.center.label"
                                        },
                                        {
                                            "value": "end",
                                            "label": "t:all.settings.sectionTextAlign.options.end.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "iframeFullscreen",
                                    "type": "radio-pill",
                                    "label": "t:sections.location.settings.iframeFullscreen.label",
                                    "default": true,
                                    "options": [
                                        {
                                            "value": false,
                                            "label": "t:sections.location.settings.iframeFullscreen.options.false.label"
                                        },
                                        {
                                            "value": true,
                                            "label": "t:sections.location.settings.iframeFullscreen.options.true.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "iframeHeight",
                                    "type": "range",
                                    "label": "t:sections.location.settings.iframeHeight.label",
