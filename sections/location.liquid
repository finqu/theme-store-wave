                                    "max": 100,
                                    "step": 5,
                                    "default": "50",
                                    "unit": "vh"
                                }
                            ],
                            "id": "layout"
                        }
                    ]
                },
                "id": "settings"
            }
        ]
    },
    "presets": [
        {
            "settings": {
                "sectionPaddingMode": "custom",
                "sectionPadding": {
                    "apply_to_all_sides": false,
                    "padding": {
                        "top": 0,
                        "right": 0,
                        "bottom": 0,
                        "left": 0
