{% assign sectionAnimationOrder = 0 %}

{%- capture sectionStyle -%}
    #finqu-section-{{ section.id }} iframe {
        aspect-ratio: 16 / 9;
        width: 100% !important;
        height: 100% !important;
        flex: 1 1 auto;
    }
    #finqu-section-{{ section.id }} .iframe-container {
        position: relative;
        display: flex;
        height: {{ section.settings.iframeHeight | append: 'vh'}};
    }
    @media screen and (max-width: {{ settings.styleGridBreakpointLg }}) {
        #finqu-section-{{ section.id }} .iframe-container {
           height: {{ section.settings.iframeHeight | divided_by: 2 | append: 'vh' }};
        }
    }
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- capture sectionCustomContent -%}

    {%- capture sectionHeaderContent -%}
        {% container 'header' %}
    {%- endcapture -%}

    {%- if sectionHeaderContent != blank -%}

        <div class="container mb-g mb-lg-6">

            {{- sectionHeaderContent -}}

        </div>

    {%- endif -%}

    {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

    <div class="iframe-container{% unless section.settings.iframeFullscreen %} container{% endunless %}" data-aos="animation-zoomFade" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

        {%- if section.settings.iframe -%}

            {{- section.settings.iframe -}}

        {%- else -%}

            <div class="lazy position-absolute top-0 start-0 w-100 h-100 bg-position-center bg-accent" data-bg-set="url('https://images.unsplash.com/photo-1524661135-423995f22d0b?w=1920&h=1080&auto=enhance&dpr=1') 1x, url('https://images.unsplash.com/photo-1524661135-423995f22d0b?w=1920&h=1080&auto=enhance&dpr=2') 2x"></div>

        {%- endif -%}

    </div>

{%- endcapture -%}

{% render 'section', section: section, sectionCustomContent: sectionCustomContent, sectionHeader: false, sectionOverflow: 'hidden' %}

{% schema %}
{
    "name": "t:sections.location.name",
    "tag": "section",
    "class": "section section-location",
    "category": "theme-contact",
    "keywords": [
        "Location",
        "Google maps",
        "Map"
    ],
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.content.title",
                "settings": [
                    {
                        "id": "iframe",
                        "type": "text",
                        "label": "t:sections.location.settings.iframe.label"
                    },
                    {
                        "type": "label",
                        "label": "Copy iframe code from Google Maps by following these steps:"
                    },
                    {
                        "type": "label",
                        "label": "1. Go to the Google Maps website (https://www.google.com/maps)."
                    },
                    {
                        "type": "label",
                        "label": "2. Search for the location you want to feature in your embedded map."
                    },
                    {
                        "type": "label",
                        "label": "3. Click Share button."
                    },
                    {
                        "type": "label",
                        "label": "4. Click Embed a map button."
                    },
                    {
                        "type": "label",
                        "label": "5. Click Copy HTML button and paste the HTML code to the iframe field."
                    }
                ],
                "id": "content"
            },
            {
                "title": "t:all.groups.settings.title",
                "settings": {
                    "list_type": "list",
                    "groups": [
                        {
                            "title": "t:all.groups.style.title",
                            "settings": [
                                {
                                    "id": "sectionColorScheme",
                                    "type": "select",
                                    "label": "t:all.settings.sectionColorScheme.label",
                                    "default": false,
                                    "options": [
                                        {
                                            "value": false,
                                            "label": "t:all.settings.sectionColorScheme.options.false.label"
                                        },
                                        {
                                            "value": "secondary",
                                            "label": "t:all.settings.sectionColorScheme.options.secondary.label"
                                        },
                                        {
                                            "value": "light",
                                            "label": "t:all.settings.sectionColorScheme.options.light.label"
                                        },
                                        {
                                            "value": "dark",
                                            "label": "t:all.settings.sectionColorScheme.options.dark.label"
                                        },
                                        {
                                            "value": "accent",
                                            "label": "t:all.settings.sectionColorScheme.options.accent.label"
                                        },
                                        {
                                            "value": "custom",
                                            "label": "t:all.settings.sectionColorScheme.options.custom.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "style_custom_color",
                                    "type": "color",
                                    "alpha": true,
                                    "gradient": true,
                                    "label": "t:all.settings.style_custom_color.label",
                                    "default": "#f3f5f6",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_color",
                                    "type": "color",
                                    "alpha": true,
                                    "label": "t:all.settings.style_custom_content_color.label",
                                    "default": "#ffffff",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_content_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionPaddingMode",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionPaddingMode.label",
                                    "default": "auto",
                                    "options": [
                                        {
                                            "value": "auto",
                                            "label": "t:all.settings.sectionPaddingMode.options.auto.label"
                                        },
                                        {
                                            "value": "custom",
                                            "label": "t:all.settings.sectionPaddingMode.options.custom.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "sectionPadding",
                                    "type": "padding",
                                    "label": "t:all.settings.sectionPadding.label",
                                    "padding": {
                                        "top": 0,
                                        "right": 0,
                                        "bottom": 0,
                                        "left": 0
                                    },
                                    "min": 0,
                                    "max": 15,
                                    "step": 0.5,
                                    "apply_to_all_sides": false,
                                    "conditions": [
                                        "sectionPaddingMode eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionBorderRadius",
                                    "label": "t:all.settings.sectionBorderRadius.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 50,
                                    "step": 1,
                                    "default": "0",
                                    "unit": "px",
                                    "conditions": [
                                        "sectionPaddingMode eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionBgImg",
                                    "type": "image-picker",
                                    "label": "t:all.settings.sectionBgImg.label",
                                    "adjustments": true
                                },
                                {
                                    "id": "sectionBgImgFit",
                                    "type": "select",
                                    "label": "t:all.settings.sectionBgImgFit.label",
                                    "default": "cover",
                                    "options": [
                                        {
                                            "value": "cover",
                                            "label": "t:all.settings.sectionBgImgFit.options.cover.label"
                                        },
                                        {
                                            "value": "contain",
                                            "label": "t:all.settings.sectionBgImgFit.options.contain.label"
                                        },
                                        {
                                            "value": "auto",
                                            "label": "t:all.settings.sectionBgImgFit.options.auto.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgPosHorizontal",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionBgImgPosHorizontal.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "left",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.left.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.center.label"
                                        },
                                        {
                                            "value": "right",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.right.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgPosVertical",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionBgImgPosVertical.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "top",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.top.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.center.label"
