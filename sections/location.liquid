                }
            },
            "id": "preset"
        }
    ],
    "containers": [
        {
            "id": "header",
            "title": "t:sections.location.containers.header.title",
            "allowed_blocks": [
                "badge",
                "heading",
                "text",
                "button",
                "button-group",
                "spacer",
