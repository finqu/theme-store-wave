            "id": "header",
            "title": "t:sections.logo-showcase.containers.header.title",
            "allowed_blocks": [
                "badge",
                "heading",
                "text",
                "button",
                "button-group",
                "spacer",
                "separator"
            ]
        }
    ]
}
{% endschema %}