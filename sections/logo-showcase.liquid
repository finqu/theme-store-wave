{%- if section.settings.logoAlign != 'nil' -%}
    {%- assign logoAlign = section.settings.logoAlign -%}
{%- else -%}
    {%- assign logoAlign = settings.sectionTextAlign -%}
{%- endif -%}

{%- capture sectionHeaderBlocks -%}
    {% container 'header' %}
{%- endcapture -%}

{%- capture sectionHeaderContent -%}
    {%- if sectionHeaderBlocks != blank -%}
        <div class="section-header">
            <div class="container">
                {{- sectionHeaderBlocks -}}
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture sectionContent -%}    

     <div class="row gy-g row-scroll-cols-3 row-cols-md-6 row-cols-lg-{{ section.settings.colPerRow }} justify-content-lg-{{ logoAlign }}">

        {% for item in section.settings.setting_blocks.items %}

            {%- assign imgSizeSm = '175,175' -%}
            {%- assign imgSizeMd = '118,118' -%}

            {%- case section.settings.colPerRow -%}
                {% when 3 %}
                    {%- assign imgSizeLg = '430,430' -%}
                {% when 4 %}
                    {%- assign imgSizeLg = '320,320' -%}
                {% when 5 %}
                    {%- assign imgSizeLg = '254,254' -%}
                {% when 6 %}
                    {%- assign imgSizeLg = '210,210' -%}
                {% when 7 %}
                    {%- assign imgSizeLg = '178,178' -%}
                {% when 8 %}
                    {%- assign imgSizeLg = '155,155' -%}
                {% when 9 %}
                    {%- assign imgSizeLg = '136,136' -%}
            {%- endcase -%}

            {%- if item.settings.imgScaleRatio < 1 -%}
                {%- capture imgSizeSm -%}{{- imgSizeSm | split: ',' | first | times: item.settings.imgScaleRatio | round -}},{{- imgSizeSm | split: ',' | last | times: item.settings.imgScaleRatio | round -}}{%- endcapture %}
                {%- capture imgSizeLg -%}{{- imgSizeLg | split: ',' | first | times: item.settings.imgScaleRatio | round -}},{{- imgSizeLg | split: ',' | last | times: item.settings.imgScaleRatio | round -}}{%- endcapture %}
                {%- capture imgSizeLg -%}{{- imgSizeLg | split: ',' | first | times: item.settings.imgScaleRatio | round -}},{{- imgSizeLg | split: ',' | last | times: item.settings.imgScaleRatio | round -}}{%- endcapture %}
                {%- assign imgSizeSm = imgSizeSm -%}
                {%- assign imgSizeMd = imgSizeMd -%}
                {%- assign imgSizeLg = imgSizeLg -%}
            {%- endif -%}

            {%- assign imgWidth = imgSizeLg | split: ',' | first -%}
            {%- assign imgHeight = imgSizeLg | split: ',' | last -%}

            <div class="col d-flex align-items-center justify-content-center">

                {% if item.settings.imgLink.url %}
                    <a href="{{- item.settings.imgLink.url -}}" target="{{- item.settings.imgLink.target -}}">
                {% endif %}

                <div class="aspect-ratio-auto" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ forloop.index }}"{% if item.settings.imgScaleRatio < 1 %} style="--img-scale-ratio: {{ item.settings.imgScaleRatio }}"{% endif %}>

                    <div class="aspect-ratio-container">

                        {% if item.settings.img %}

                             <picture>
                                <source media="(min-width: {{ settings.styleGridBreakpointLg }})" data-srcset="
                                    {{- item.settings.img | thumb: imgSizeLg }} 1x,
                                    {{- item.settings.img | thumb: imgSizeLg | thumb:'@2x' }} 2x">

                                <source media="(min-width: {{ settings.styleGridBreakpointSm }})" data-srcset="
                                    {{- item.settings.img | thumb: imgSizeMd }} 1x,
                                    {{- item.settings.img | thumb: imgSizeMd | thumb:'@2x' }} 2x">

                                <source data-srcset="
                                    {{- item.settings.img | thumb: imgSizeSm }} 1x,
                                    {{- item.settings.img | thumb: imgSizeSm | thumb:'@2x' }} 2x">

                                <img
                                    class="lazy d-block mx-auto img-fluid aspect-ratio-item"
                                    alt="{{ item.settings.img.alt }}"
                                    src="{{ item.settings.img | thumb: imgSizeSm }}"{% if item.settings.img.offset_left or item.settings.img.offset_top %} style="--object-position: {{ item.settings.img.offset_left }}% {{ item.settings.img.offset_top }}%"{% endif %}>
                            </picture>

                        {% else %}

                            {%- capture imgSrc -%}
                                {%- render 'placeholder-svg', type: 'image', base64: true, width: imgWidth, height: imgHeight -%}
                            {%- endcapture -%}

                            <img
                                class="lazy d-block mx-auto img-fluid aspect-ratio-item svg-placeholder"
                                alt=""
                                data-src="{{- imgSrc | strip_newlines -}}">

                        {% endif %}

                    </div>

                </div>

                {% if item.settings.imgLink.url %}
                    </a>
                {% endif %}

            </div>

        {% endfor %}

    </div>

{%- endcapture -%}

{% render 'section', section: section, sectionHeaderContent: sectionHeaderContent, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false %}

{% schema %}
{
    "name": "t:sections.logo-showcase.name",
    "tag": "section",
    "class": "section section-logo-showcase",
    "category": "theme-icon",
    "keywords": [
        "Logos",
        "Brands",
        "Partners",
        "Manufacturers",
        "List",
        "Image",
        "Icon"
    ],
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:sections.logo-showcase.groups.items.title",
                "id": "items",
                "call_to_action": "t:sections.logo-showcase.groups.items.call_to_action",
                "is_sortable": true,
                "display_icons": true,
                "setting_blocks": [
                    {
                        "type": "image",
                        "title": "t:sections.logo-showcase.setting_blocks.image.title",
                        "settings": [
                            {
                                "id": "img",
                                "type": "image-picker",
                                "label": "t:sections.logo-showcase.setting_blocks.image.settings.img.label",
                                "adjustments": true
                            },
                            {
                                "id": "imgScaleRatio",
                                "label": "t:sections.logo-showcase.setting_blocks.image.settings.imgScaleRatio.label",
                                "type": "range",
                                "min": 0.3,
                                "max": 1,
                                "step": 0.1,
                                "default": 1
                            },
                            {
                                "id": "imgLink",
                                "type": "url",
                                "label": "t:sections.logo-showcase.setting_blocks.image.settings.imgLink.label",
                                "include_target": true
                            }
                        ]
                    }
                ]
            },
            {
                "title": "t:all.groups.settings.title",
                "settings": {
                    "list_type": "list",
                    "groups": [
                        {
                            "title": "t:all.groups.style.title",
                            "settings": [
                                {
                                    "id": "sectionColorScheme",
                                    "type": "select",
                                    "label": "t:all.settings.sectionColorScheme.label",
                                    "default": false,
                                    "options": [
                                        {
                                            "value": false,
                                            "label": "t:all.settings.sectionColorScheme.options.false.label"
                                        },
                                        {
                                            "value": "secondary",
                                            "label": "t:all.settings.sectionColorScheme.options.secondary.label"
                                        },
                                        {
                                            "value": "light",
                                            "label": "t:all.settings.sectionColorScheme.options.light.label"
                                        },
                                        {
                                            "value": "dark",
                                            "label": "t:all.settings.sectionColorScheme.options.dark.label"
                                        },
                                        {
                                            "value": "accent",
                                            "label": "t:all.settings.sectionColorScheme.options.accent.label"
                                        },
                                        {
                                            "value": "custom",
                                            "label": "t:all.settings.sectionColorScheme.options.custom.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "style_custom_color",
                                    "type": "color",
                                    "alpha": true,
                                    "gradient": true,
                                    "label": "t:all.settings.style_custom_color.label",
                                    "default": "#f3f5f6",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_color",
                                    "type": "color",
                                    "alpha": true,
                                    "label": "t:all.settings.style_custom_content_color.label",
                                    "default": "#ffffff",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_content_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionPaddingMode",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionPaddingMode.label",
                                    "default": "auto",
                                    "options": [
                                        {
                                            "value": "auto",
                                            "label": "t:all.settings.sectionPaddingMode.options.auto.label"
                                        },
                                        {
                                            "value": "custom",
                                            "label": "t:all.settings.sectionPaddingMode.options.custom.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "sectionPadding",
                                    "type": "padding",
                                    "label": "t:all.settings.sectionPadding.label",
                                    "padding": {
                                        "top": 0,
                                        "right": 0,
                                        "bottom": 0,
                                        "left": 0
                                    },
                                    "min": 0,
                                    "max": 15,
                                    "step": 0.5,
                                    "apply_to_all_sides": false,
                                    "conditions": [
                                        "sectionPaddingMode eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionBorderRadius",
                                    "label": "t:all.settings.sectionBorderRadius.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 50,
                                    "step": 1,
                                    "default": "0",
                                    "unit": "px",
                                    "conditions": [
                                        "sectionPaddingMode eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionBgImg",
                                    "type": "image-picker",
                                    "label": "t:all.settings.sectionBgImg.label",
                                    "adjustments": true
                                },
                                {
                                    "id": "sectionBgImgFit",
                                    "type": "select",
                                    "label": "t:all.settings.sectionBgImgFit.label",
                                    "default": "cover",
                                    "options": [
                                        {
                                            "value": "cover",
                                            "label": "t:all.settings.sectionBgImgFit.options.cover.label"
                                        },
                                        {
                                            "value": "contain",
                                            "label": "t:all.settings.sectionBgImgFit.options.contain.label"
                                        },
                                        {
                                            "value": "auto",
                                            "label": "t:all.settings.sectionBgImgFit.options.auto.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgPosHorizontal",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionBgImgPosHorizontal.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "left",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.left.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.center.label"
                                        },
                                        {
                                            "value": "right",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.right.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgPosVertical",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionBgImgPosVertical.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "top",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.top.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.center.label"
                                        },
                                        {
                                            "value": "bottom",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.bottom.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgDimming",
                                    "label": "t:all.settings.sectionBgImgDimming.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 90,
                                    "step": 5,
                                    "default": "0",
                                    "unit": "%",
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgBlur",
                                    "label": "t:all.settings.sectionBgImgBlur.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 10,
                                    "step": 1,
                                    "default": "0",
                                    "unit": " ",
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                }
                            ],
                            "id": "style"
                        },
                        {
                            "title": "t:all.groups.layout.title",
                            "settings": [
                                {
                                    "id": "sectionHeaderTextAlign",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionHeaderTextAlign.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.sectionHeaderTextAlign.options.nil.label"
                                        },
                                        {
                                            "value": "start",
                                            "label": "t:all.settings.sectionHeaderTextAlign.options.start.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionHeaderTextAlign.options.center.label"
                                        },
                                        {
                                            "value": "end",
                                            "label": "t:all.settings.sectionHeaderTextAlign.options.end.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "logoAlign",
                                    "type": "radio-pill",
                                    "label": "t:sections.logo-showcase.settings.logoAlign.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:sections.logo-showcase.settings.logoAlign.options.nil.label"
                                        },
                                        {
                                            "value": "start",
                                            "label": "t:sections.logo-showcase.settings.logoAlign.options.start.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:sections.logo-showcase.settings.logoAlign.options.center.label"
                                        },
                                        {
                                            "value": "end",
                                            "label": "t:sections.logo-showcase.settings.logoAlign.options.end.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "colPerRow",
                                    "label": "t:sections.logo-showcase.settings.colPerRow.label",
                                    "type": "radio-pill",
                                    "default": 9,
                                    "options": [
                                        {
                                            "value": 3,
                                            "label": "3"
                                        },
                                        {
                                            "value": 4,
                                            "label": "4"
                                        },
                                        {
                                            "value": 5,
                                            "label": "5"
                                        },
                                        {
                                            "value": 6,
                                            "label": "6"
                                        },
                                        {
                                            "value": 7,
                                            "label": "7"
                                        },
                                        {
                                            "value": 8,
                                            "label": "8"
                                        },
                                        {
                                            "value": 9,
                                            "label": "9"
                                        }
                                    ]
                                }
                            ],
                            "id": "layout"
                        }
                    ]
                },
                "id": "settings"
            }
        ]
    },
    "presets": [
        {
            "settings": {
                "setting_blocks": {
                    "items": [
                        {
                            "type": "image"
                        },
                        {
                            "type": "image"
                        },
                        {
                            "type": "image"
                        },
                        {
                            "type": "image"
                        },
                        {
                            "type": "image"
                        },
                        {
                            "type": "image"
                        }
                    ]
                }
            },
