{%- assign newsletterHasBackground = false -%}
{%- if section.settings.sectionBgImg != blank -%}
    {%- assign newsletterHasBackground = true -%}
{%- endif -%}

{%- capture sectionContent -%}

    <div class="newsletter-stack{% if newsletterHasBackground %} newsletter-stack-background{% endif %}" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: 1">

        <div class="newsletter-intro">
            {% container 'intro' %}
        </div>

        <div class="newsletter-form">
            {% block 'newsletter' id:'section-newsletter' %}
        </div>

        <div class="newsletter-social">
            {% container 'social' %}
        </div>

    </div>

{%- endcapture -%}

{% render 'section', section: section, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false, sectionInnerGap: '2rem' %}

{% schema %}
{
    "name": "t:sections.newsletter.name",
    "tag": "section",
    "class": "section section-newsletter",
    "category": "theme-marketing",
    "keywords": [
        "Form",
        "Subscribe",
        "Email",
        "Lead"
    ],
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.settings.title",
                "settings": {
                    "list_type": "list",
                    "groups": [
                        {
                            "title": "t:all.groups.style.title",
                            "settings": [
                                {
                                    "id": "sectionColorScheme",
                                    "type": "select",
                                    "label": "t:all.settings.sectionColorScheme.label",
                                    "default": false,
                                    "options": [
                                        {
                                            "value": false,
                                            "label": "t:all.settings.sectionColorScheme.options.false.label"
                                        },
                                        {
                                            "value": "secondary",
                                            "label": "t:all.settings.sectionColorScheme.options.secondary.label"
                                        },
                                        {
                                            "value": "light",
                                            "label": "t:all.settings.sectionColorScheme.options.light.label"
                                        },
                                        {
                                            "value": "dark",
                                            "label": "t:all.settings.sectionColorScheme.options.dark.label"
                                        },
                                        {
                                            "value": "accent",
                                            "label": "t:all.settings.sectionColorScheme.options.accent.label"
                                        },
                                        {
                                            "value": "custom",
                                            "label": "t:all.settings.sectionColorScheme.options.custom.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "style_custom_color",
                                    "type": "color",
                                    "alpha": true,
                                    "gradient": true,
                                    "label": "t:all.settings.style_custom_color.label",
                                    "default": "#f3f5f6",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_color",
                                    "type": "color",
                                    "alpha": true,
                                    "label": "t:all.settings.style_custom_content_color.label",
                                    "default": "#ffffff",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_content_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionPaddingMode",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionPaddingMode.label",
                                    "default": "auto",
                                    "options": [
                                        {
                                            "value": "auto",
                                            "label": "t:all.settings.sectionPaddingMode.options.auto.label"
                                        },
                                        {
                                            "value": "custom",
                                            "label": "t:all.settings.sectionPaddingMode.options.custom.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "sectionPadding",
                                    "type": "padding",
                                    "label": "t:all.settings.sectionPadding.label",
                                    "padding": {
                                        "top": 0,
                                        "right": 0,
                                        "bottom": 0,
                                        "left": 0
                                    },
                                    "min": 0,
                                    "max": 15,
                                    "step": 0.5,
                                    "apply_to_all_sides": false,
                                    "conditions": [
                                        "sectionPaddingMode eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionBorderRadius",
                                    "label": "t:all.settings.sectionBorderRadius.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 50,
                                    "step": 1,
                                    "default": "0",
                                    "unit": "px",
                                    "conditions": [
                                        "sectionPaddingMode eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionBgImg",
                                    "type": "image-picker",
                                    "label": "t:all.settings.sectionBgImg.label",
                                    "adjustments": true
                                },
                                {
                                    "id": "sectionBgImgFit",
                                    "type": "select",
                                    "label": "t:all.settings.sectionBgImgFit.label",
                                    "default": "cover",
                                    "options": [
                                        {
                                            "value": "cover",
                                            "label": "t:all.settings.sectionBgImgFit.options.cover.label"
                                        },
                                        {
                                            "value": "contain",
                                            "label": "t:all.settings.sectionBgImgFit.options.contain.label"
                                        },
                                        {
                                            "value": "auto",
                                            "label": "t:all.settings.sectionBgImgFit.options.auto.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgPosHorizontal",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionBgImgPosHorizontal.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "left",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.left.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.center.label"
                                        },
                                        {
                                            "value": "right",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.right.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgPosVertical",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionBgImgPosVertical.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "top",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.top.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.center.label"
                                        },
                                        {
                                            "value": "bottom",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.bottom.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgDimming",
                                    "label": "t:all.settings.sectionBgImgDimming.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 90,
                                    "step": 5,
                                    "default": "0",
                                    "unit": "%",
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgBlur",
                                    "label": "t:all.settings.sectionBgImgBlur.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 10,
                                    "step": 1,
                                    "default": "0",
                                    "unit": " ",
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                }
                            ],
                            "id": "style"
                        },
                        {
                            "title": "t:all.groups.layout.title",
                            "settings": [
                                {
                                    "id": "sectionHighlightItems",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionHighlightItems.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.sectionHighlightItems.options.nil.label"
                                        },
                                        {
                                            "value": false,
                                            "label": "t:all.settings.sectionHighlightItems.options.false.label"
                                        },
                                        {
                                            "value": true,
                                            "label": "t:all.settings.sectionHighlightItems.options.true.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "sectionTextAlign",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionTextAlign.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.sectionTextAlign.options.nil.label"
                                        },
                                        {
                                            "value": "start",
                                            "label": "t:all.settings.sectionTextAlign.options.start.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionTextAlign.options.center.label"
                                        },
                                        {
                                            "value": "end",
                                            "label": "t:all.settings.sectionTextAlign.options.end.label"
                                        }
                                    ]
                                }
                            ],
                            "id": "layout"
                        }
                    ]
                },
                "id": "settings"
            }
        ]
    },
    "containers": [
        {
            "id": "intro",
            "title": "t:sections.newsletter.containers.intro.title",
            "allowed_blocks": [
                "heading",
                "text",
                "badge",
                "spacer",
                "separator"
            ]
        },
        {
            "id": "social",
            "title": "t:sections.newsletter.containers.social.title",
            "allowed_blocks": [
                "social-media-buttons",
                "button",
                "button-group",
                "spacer",
                "separator"
            ]
        }
    ],
    "presets": {
        "default": [
            {
