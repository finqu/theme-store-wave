{%- assign sectionHandle = '#finqu-section-' | append: section.id -%}

{%- capture sectionContent -%}

    {% container 'content' %}

{%- endcapture -%}

{% render 'section', section: section, sectionHandle: sectionHandle, sectionContent: sectionContent, sectionHeader: false, sectionContainer: 'tiny', sectionContentWidth: '8', sectionOverlay: settings.sectionOverlay, sectionHeight: '100vh', sectionTextAlign: 'center', sectionHeaderTextAlign: 'center', sectionHeaderGapScale: 1, sectionPaddingMode: 'custom', sectionPaddingTop: '20rem', sectionPaddingBottom: '20rem' %}

{% schema %}
{
    "name": "t:sections.password-template.name",
    "tag": "section",
    "class": "section section-password",
    "is_creatable": false,
    "templates": [
        "password"
    ],
    "settings": [],
    "containers": [
        {
            "id": "content",
            "allowed_blocks": [
                "heading",
                "text",
                "countdown",
                "newsletter",
                "separator",
                "social-media-buttons",
                "password-login",
                "spacer",
                "button",
                "button-group",
                "image",
                "badge"
            ]
        }
    ],
    "presets": [
        {
            "id": "default",
            "blocks": [
                {
                    "name": "heading",
                    "container": "content",
                    "settings": {
                        "title": {
                            "type": "translation",
                            "key": "password_protection.title",
                            "string_value": "Opening soon"
                        },
                        "subtitle": {
                            "type": "translation",
                            "key": "password_protection.subtitle",
                            "string_value": "Subscribe to our newsletter"
                        },
                        "titleTag": "h1",
                        "textAlign": "center"
                    }
                },
                {
                    "name": "text",
                    "container": "content",
                    "settings": {
                        "richtext": {
                            "type": "translation",
                            "key": "password_protection.description",
                            "string_value": "We announce in a newsletter about promotions, new products and sales."
                        }
                    }
                },
                {
                    "name": "newsletter",
                    "container": "content",
                    "settings": {
                        "submitAppearance": "button",
                        "submitLayout": "stack",
                        "btnLabel": {
                            "type": "translation",
                            "key": "password_protection.newsletter_cta",
                            "string_value": "Subscribe to the newsletter"
                        },
                        "btnTheme": "primary",
                        "btnVariant": "outline",
                        "btnSize": "md",
                        "formMaxWidth": "full",
                        "contentAlign": "center"
                    }
                },
                {
                    "name": "separator",
                    "container": "content",
                    "settings": {
                        "contentAlign": "center"
                    }
                },
                {
                    "name": "social-media-buttons",
                    "container": "content",
                    "settings": {
                        "contentAlign": "center"
                    }
                },
                {
                    "name": "password-login",
                    "container": "content",
                    "settings": {
                        "triggerLabel": {
                            "type": "translation",
                            "key": "password_protection.login_to_store",
                            "string_value": "Log in to the store"
                        },
                        "ctaLabel": {
                            "type": "translation",
                            "key": "password_protection.login_to_store_cta",
                            "string_value": "Confirm"
                        }
                    }
                }
            ]
        }
    ]
}
{% endschema %}
