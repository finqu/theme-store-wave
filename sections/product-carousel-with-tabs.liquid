{%- assign productPerRow = section.settings.productPerRow -%}

{%- capture sectionStyle -%}
    #finqu-section-{{ section.id }} .swiper-slide {
        --swiper-slide-width: 50;
        --swiper-slide-width-sm: 25;
        --swiper-slide-width-md: 33.333333;
        --swiper-slide-width-lg: {{ 100 | divided_by: productPerRow }};
    }
    #finqu-section-{{ section.id }} .swiper-slide.promotion-slide {
        --swiper-slide-width: 80;
        --swiper-slide-width-sm: 50;
        --swiper-slide-width-md: {% if settings.styleElevation == 'hard' %}33.333333{% else %}30{% endif %};
        --swiper-slide-width-lg: {% if settings.styleElevation == 'hard' %}{{ 100 | divided_by: productPerRow }}{% else %}30{% endif %};
    }
    {%- for tab in section.settings.setting_blocks.items -%}
        #finqu-section-{{ section.id }} [data-tab="{{ forloop.index }}"] .promotion-slide {
            --style-text-color: {{ tab.settings.promotionTextColor }};
            --style-link-color: {{ tab.settings.promotionTextColor }};
            --style-heading-color: {{ tab.settings.promotionTextColor }};
            --style-accent-color: {{ tab.settings.promotionTextColor }};
        }
    {%- endfor %}
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- capture sectionHeaderBlocks -%}
    {% container 'intro' %}
{%- endcapture -%}

{%- capture sectionHeaderContent -%}
    {%- if sectionHeaderBlocks != blank -%}
        <div class="section-header">
            <div class="container">
                {{- sectionHeaderBlocks -}}
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture sectionTabs -%}

    {% if section.settings.setting_blocks.items.size > 1 %}

        {%- for tab in section.settings.setting_blocks.items -%}
            {%- render 'section-tab', sectionTab: tab.settings.title -%}
        {%- endfor -%}

    {% endif %}

{%- endcapture -%}

{%- capture sectionContent -%}

    {%- for tab in section.settings.setting_blocks.items -%}

        {%- capture sectionTabContent -%}

            <div data-tab="{{ forloop.index }}">

                {%- case tab.settings.listType -%}
                    {% when 'discounted' %}
                        {%- assign items = products.discounted -%}
                    {% when 'new' %}
                        {%- assign items = products.new_products -%}
                    {% when 'recent' %}
                        {%- assign items = products.recent -%}
                    {% when 'tag' %}
                        {%- assign items = products.tags[tab.settings.tagId] -%}
                    {% when 'category' %}
                        {%- assign items = categories[tab.settings.category.id].products -%}
                    {% when 'manufacturer' %}
                        {%- assign items = manufacturers[tab.settings.manufacturer.id].products -%}
                {%- endcase -%}

                {%- assign carouselProducts = items | slice: 0, section.settings.productAmount -%}

                {%- capture carouselSlides -%}
                
                    {%- assign carouselSlideIndex = 0 -%}

                    {% if tab.settings.showPromotionSlide %}

                        {%- assign carouselSlideIndex = 1 -%}
                        {%- assign promotionImageId = 'section-promotion-image-' | append: forloop.index -%}

                        <div class="swiper-slide promotion-slide{% if carouselProducts.size < 1 and request.design_mode == false %} min-h-px-350 min-h-px-md-500{% endif %}">

                            <div class="rounded-product-image promotion-card ct-inline-size overflow-hidden h-100 position-relative bg-accent">

                                <div class="section-media promotion-card-media" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ carouselSlideIndex }}">
                                    {% block 'image' id:promotionImageId %}
                                </div>

                                {%- if tab.settings.promotionText or tab.settings.promotionLinkResource.text or tab.settings.promotionImgDimming > 0 -%}

                                    <div class="promotion-slide-content position-absolute top-0 start-0 w-100 h-100 d-flex flex-column justify-content-end align-items-start p-4"{% if tab.settings.promotionImgDimming > 0 %} style="background: linear-gradient(0deg, rgb(0,0,0, {{ tab.settings.promotionImgDimming }}%), rgb(0,0,0, {{ tab.settings.promotionImgDimming }}%))"{% endif %}>

                                        {%- if tab.settings.promotionText or tab.settings.promotionLinkResource.text -%}

                                            <div class="promotion-card-caption">

                                                {% if tab.settings.promotionText %}

                                                    <p class="promotion-card-title display-5 fs-cqi text-style-accent">
                                                        {{ tab.settings.promotionText }}
                                                    </p>

                                                {% endif %}

                                                {% if tab.settings.promotionLinkResource.text %}

                                                    <div>
                                                        <a href="{{ tab.settings.promotionLinkResource.url | default: '#' }}" class="promotion-card-action lead text-underline-indicator">
                                                            {{ tab.settings.promotionLinkResource.text }}
                                                        </a>
                                                    </div>

                                                {% endif %}

                                            </div>

                                        {%- endif -%}

                                    </div>

                                {%- endif -%}

                            </div>

                        </div>

                    {% endif %}
                    {% if carouselProducts.size > 0 %}

                        {% for product in carouselProducts %}

                            <div class="swiper-slide">

                                <div class="swiper-slide-inner" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ forloop.index | plus: carouselSlideIndex }}">

                                    {%- capture productCardShellClass -%}
                                        {%- render 'product-card-shell-class', product: product -%}
                                    {%- endcapture -%}

                                    <div class="product-card-grid-item section-highlight-item {{ productCardShellClass | strip }}">

                        {% block 'product-list-item' id:'section-product-card' %}

                    </div>

                                </div>

                            </div>

                        {% endfor %}

                    {% elsif request.design_mode %}

                        {% for num in (1..section.settings.productAmount) %}

                            <div class="swiper-slide">

                                <div class="swiper-slide-inner" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ forloop.index | plus: carouselSlideIndex }}">

                                        {%- assign product = nil -%}

                                        {%- capture productCardShellClass -%}
                                            {%- render 'product-card-shell-class', product: product -%}
                                        {%- endcapture -%}

                                        <div class="product-card-grid-item section-highlight-item {{ productCardShellClass | strip }}">

                        {% block 'product-list-item' id:'section-product-card' %}

                    </div>

                                </div>

                            </div>

                        {% endfor %}

                    {% endif %}

                {%- endcapture -%}

                {%- render 'swiper', slides: carouselSlides, pagination: section.settings.carouselPagination, navigation: section.settings.carouselNavigation, slidesPerView: 'auto', style: section.settings.carouselStyle, paginationPosition: 'relative', evenHeightSlides: true, standalone: true, freemode: true, autoplaySpeed: section.settings.carouselAutoplaySpeed -%}

            </div>

        {%- endcapture -%}

        {%- render 'section-tab-content', sectionTabContent: sectionTabContent -%}

    {%- endfor -%}

    {% container 'outro' %}

{%- endcapture -%}

{% render 'section', section: section, sectionHeaderContent: sectionHeaderContent, sectionTabs: sectionTabs, sectionContent: sectionContent, sectionContentOverflow: 'hidden', sectionContentAnimation: false, sectionHeader: false %}

