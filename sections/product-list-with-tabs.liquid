{%- capture sectionAction -%}
    {% render 'section-quick-link', section: section %}
{%- endcapture -%}
{%- assign sectionAction = sectionAction | strip -%}

{%- capture sectionHeaderBlocks -%}
    {% container 'header' %}
{%- endcapture -%}
{%- assign sectionHeaderBlocks = sectionHeaderBlocks | strip -%}

{%- capture sectionHeaderContent -%}
    {%- if sectionHeaderBlocks != blank or sectionAction != blank -%}
        <div class="section-header">
            <div class="container">
                <div class="d-flex align-items-end justify-content-between gap-g flex-wrap">
                    <div class="flex-grow-1 min-w-0">
                        {{- sectionHeaderBlocks -}}
                    </div>
                    {%- if sectionAction != blank -%}
                        <div class="section-action">
                            {{- sectionAction -}}
                        </div>
                    {%- endif -%}
                </div>
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture sectionTabs -%}

    {% if section.settings.setting_blocks.items.size > 1 %}

        {%- for tab in section.settings.setting_blocks.items -%}
            {%- render 'section-tab', sectionTab: tab.settings.title -%}
        {%- endfor -%}

    {% endif %}

{%- endcapture -%}

{%- capture sectionContent -%}

    {%- for tab in section.settings.setting_blocks.items -%}

        {%- capture sectionTabContent -%}

            {%- case tab.settings.listType -%}
                {% when 'discounted' %}
                    {%- assign items = products.discounted -%}
                {% when 'new' %}
                    {%- assign items = products.new_products -%}
                {% when 'recent' %}
                    {%- assign items = products.recent -%}
                {% when 'tag' %}
                    {%- assign items = products.tags[tab.settings.tagId] -%}
                {% when 'category' %}
                    {%- assign items = categories[tab.settings.category.id].products -%}
                {% when 'manufacturer' %}
                    {%- assign items = manufacturers[tab.settings.manufacturer.id].products -%}
            {%- endcase -%}

            {%- assign items = items | slice: 0, section.settings.productAmount -%}
            {%- assign productPerRow = section.settings.productPerRow -%}

            {% render 'product-list-grid', items: items, product_amount: section.settings.productAmount, product_per_row: productPerRow, section_id: section.id, section: section %}

        {%- endcapture -%}

        {%- render 'section-tab-content', sectionTabContent: sectionTabContent -%}

    {%- endfor -%}

{%- endcapture -%}

{% render 'section', section: section, sectionHeaderContent: sectionHeaderContent, sectionTabs: sectionTabs, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false %}

