{%- assign product = section.settings.product -%}
{%- assign productImageAspectRatio = '1:1' -%}
{%- assign productName = product.title | default: '' -%}
{%- assign productLinkUrl = product | link | default: '' -%}
{%- assign productLinkText = 'product.view' | t -%}

{%- unless product -%}
    {%- assign productName = 'placeholder.product' | t -%}
{%- endunless -%}

{%- assign sectionAnimationOrder = 0 -%}

{%- capture sectionStyle -%}
    #finqu-section-{{ section.id }} .product-media-img-container + div {
        transform: translateX(70%);
    }
    #finqu-section-{{ section.id }} .product-media-img-container + div .aspect-ratio-item {
        box-shadow: 0 2px 6px #0003;
    }
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- capture sectionContent -%}

     <div class="row gy-g">

        <div class="col-12 col-md-6 order-2 order-md-1 d-flex flex-column justify-content-center">

            {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

            <div class="product-caption" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                {% container 'content' %}

            </div>

            {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

            <div class="product-action mt-4" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                {%- render 'section-quick-link', theme: section.settings.btnTheme, variant: section.settings.btnVariant, size: section.settings.btnSize, text: productLinkText, url: productLinkUrl  -%}

            </div>

        </div>

        <div class="col-12 col-md-6 order-1 order-md-2 position-relative">

            {%- if product -%}
                <a href="{{ productLinkUrl }}">
            {%- endif -%}

            <div class="product-media d-flex">

                {%- if product.images -%}

                    {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}
                    {%- assign generalImages = product.images | where: 'attached_to_variant', false -%}

                    {% if generalImages.size > 1 %}

                        {%- assign img1 = generalImages[0] -%}
                        {%- assign img2 = generalImages[1] -%}

                    {% elsif generalImages.size == 1 and product.default_or_selected_variant.image %}

                        {%- assign img1 = generalImages[0] -%}
                        {%- assign img2 = product.default_or_selected_variant.image -%}

                    {% elsif generalImages.size == 1 %}

                        {%- assign img1 = generalImages[0] -%}

                    {%- elsif product.default_or_selected_variant.image -%}

                        {%- assign img1 = product.default_or_selected_variant.image -%}

                    {% endif %}
                    
                    {%- if productImageAspectRatio == '9:13' -%}

                        {%- assign imgSizeSm = '236,336' -%}
                        {%- assign imgSizeMd = '286,418' -%}
                        {%- assign imgSizeLg = '394,564' -%}

                    {%- elsif productImageAspectRatio == '4:3' -%}

                        {%- assign imgSizeSm = '236,179' -%}
                        {%- assign imgSizeMd = '286,217' -%}
                        {%- assign imgSizeLg = '394,298' -%}

                    {%- elsif productImageAspectRatio == '3:4' -%}

                        {%- assign imgSizeSm = '236,315' -%}
                        {%- assign imgSizeMd = '286,381' -%}
                        {%- assign imgSizeLg = '394,525' -%}

                    {%- elsif productImageAspectRatio == '1:1' -%}

                        {%- assign imgSizeSm = '236,236' -%}
                        {%- assign imgSizeMd = '286,286' -%}
                        {%- assign imgSizeLg = '394,394' -%}

                    {%- endif -%}

                    <div class="aspect-ratio-product w-60 overflow-visible">

                        <div class="product-media-img-container aspect-ratio-container" data-aos="animation-fadeInLeft" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                            <picture>
                                <source media="(min-width: {{ settings.styleGridBreakpointLg }})" data-srcset="
                                    {{- img1 | thumb: imgSizeLg }} 1x,
                                    {{- img1 | thumb: imgSizeLg | thumb:'@2x' }} 2x">

                                <source media="(min-width: {{ settings.styleGridBreakpointSm }})" data-srcset="
                                    {{- img1 | thumb: imgSizeMd }} 1x,
                                    {{- img1 | thumb: imgSizeMd | thumb:'@2x' }} 2x">

                                <source data-srcset="
                                    {{- img1 | thumb: imgSizeSm }} 1x,
                                    {{- img1 | thumb: imgSizeSm | thumb:'@2x' }} 2x">

                                <img
                                    alt="{{ productName }}" 
                                    data-src="{{ img1 | thumb: imgSizeSm }}"
                                    data-srcset="{{ img1 | thumb: imgSizeSm }} 1x, {{ img1 | thumb: imgSizeSm | thumb:'@2x' }} 2x"
                                    class="lazy d-block mx-auto img-fluid aspect-ratio-item">
                            </picture>

                        </div>

                        {% if img2 %}

                            {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

                            {%- if productImageAspectRatio == '9:13' -%}

                                {%- assign imgSizeSm = '118,168' -%}
                                {%- assign imgSizeMd = '143,209' -%}
                                {%- assign imgSizeLg = '197,282' -%}

                            {%- elsif productImageAspectRatio == '4:3' -%}

                                {%- assign imgSizeSm = '118,90' -%}
                                {%- assign imgSizeMd = '143,109' -%}
                                {%- assign imgSizeLg = '197,149' -%}

                            {%- elsif productImageAspectRatio == '3:4' -%}

                                {%- assign imgSizeSm = '118,157' -%}
                                {%- assign imgSizeMd = '143,109' -%}
                                {%- assign imgSizeLg = '197,263' -%}

                            {%- elsif productImageAspectRatio == '1:1' -%}

                                {%- assign imgSizeSm = '118,118' -%}
                                {%- assign imgSizeMd = '143,191' -%}
                                {%- assign imgSizeLg = '197,197' -%}

                            {%- endif -%}

                            <div class="position-absolute top-0 end-0 bottom-0 d-flex align-items-center">

                                <div class="aspect-ratio-product overflow-visible" data-aos="animation-fadeInRight" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                                    <div class="product-media-img-container aspect-ratio-container">

                                        <picture>
                                            <source media="(min-width: {{ settings.styleGridBreakpointLg }})" data-srcset="
                                                {{- img2 | thumb: imgSizeLg }} 1x,
                                                {{- img2 | thumb: imgSizeLg | thumb:'@2x' }} 2x">

                                            <source media="(min-width: {{ settings.styleGridBreakpointSm }})" data-srcset="
                                                {{- img2 | thumb: imgSizeMd }} 1x,
                                                {{- img2 | thumb: imgSizeMd | thumb:'@2x' }} 2x">

                                            <source data-srcset="
                                                {{- img2 | thumb: imgSizeSm }} 1x,
                                                {{- img2 | thumb: imgSizeSm | thumb:'@2x' }} 2x">

                                            <img
                                                alt="{{ productName }}" 
                                                data-src="{{ img2 | thumb: imgSizeSm }}"
                                                data-srcset="{{ img2 | thumb: imgSizeSm }} 1x, {{ img2 | thumb: imgSizeSm | thumb:'@2x' }} 2x"
                                                class="lazy d-block mx-auto img-fluid aspect-ratio-item">
                                        </picture>

                                    </div>

                                </div>

                            </div>

                        {% endif %}

                    </div>

                {%- else -%}

                    {%- if productImageAspectRatio == '9:13' -%}

                        {%- assign img1Size = '394,564' -%}
                        {%- assign img2Size = '197,282' -%}

                    {%- elsif productImageAspectRatio == '4:3' -%}

                        {%- assign img1Size = '465,350' -%}
                        {%- assign img2Size = '233,175' -%}

                    {%- elsif productImageAspectRatio == '3:4' -%}

                        {%- assign img1Size = '350,465' -%}
                        {%- assign img2Size = '233,311' -%}

                    {%- elsif productImageAspectRatio == '1:1' -%}

                        {%- assign img1Size = '400,400' -%}
                        {%- assign img2Size = '200,200' -%}
                        
                    {%- endif -%}

                    {%- assign img1Width = img1Size | split: ',' | first -%}
                    {%- assign img1Height = img1Size | split: ',' | last -%}
                    {%- assign img2Width = img2Size | split: ',' | first -%}
                    {%- assign img2Height = img2Size | split: ',' | last -%}

                    {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

                    <div class="aspect-ratio-product w-60 overflow-visible">

                        <div class="product-media-img-container aspect-ratio-container" data-aos="animation-fadeInLeft" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                            {%- if product -%}
                                {%- render 'placeholder-svg', type: 'image', class: 'aspect-ratio-item', width: img1Width, height: img1Height -%}
                            {% else %}
                                {%- render 'placeholder-svg', type: 'product', class: 'aspect-ratio-item', width: img1Width, height: img1Height -%}
                            {%- endif -%}

                        </div>

                        <div class="position-absolute top-0 end-0 bottom-0 d-flex align-items-center">

                            {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

                            <div class="aspect-ratio-product overflow-visible" data-aos="animation-fadeInRight" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                                <div class="product-media-img-container aspect-ratio-container">

                                    {%- if product -%}
                                        {%- render 'placeholder-svg', type: 'image', class: 'aspect-ratio-item', width: img2Width, height: img2Height -%}
                                    {% else %}
                                        {%- render 'placeholder-svg', type: 'product', class: 'aspect-ratio-item', width: img2Width, height: img2Height -%}
                                    {%- endif -%}

                                </div>

                            </div>

                        </div>

                    </div>

                {%- endif -%}

            </div>
            
            {%- if product -%}
                </a>
            {%- endif -%}

        </div>

    </div>

{%- endcapture -%}

{% render 'section', section: section, sectionContent: sectionContent, sectionHeader: false, sectionContentAnimation: false %}

{% schema %}
{
    "name": "t:sections.product-promotion.name",
    "tag": "section",
    "class": "section section-product-promotion",
    "category": "theme-product",
    "keywords": [
        "Product",
        "Promotion",
        "Marketing",
        "Advertisement",
        "Campaign"
    ],
    "settings": {
        "list_type": "tabs",
        "groups": [
            {
                "title": "t:all.groups.content.title",
                "settings": [
                    {
                        "id": "product",
                        "type": "product",
                        "label": "t:sections.product-promotion.settings.product.label"
                    }
                ],
                "id": "content"
            },
            {
                "title": "t:all.groups.settings.title",
                "settings": {
                    "list_type": "list",
                    "groups": [
                        {
                            "title": "t:all.groups.style.title",
                            "settings": [
                                {
                                    "id": "sectionColorScheme",
                                    "type": "select",
                                    "label": "t:all.settings.sectionColorScheme.label",
                                    "default": false,
                                    "options": [
                                        {
                                            "value": false,
                                            "label": "t:all.settings.sectionColorScheme.options.false.label"
                                        },
                                        {
                                            "value": "secondary",
                                            "label": "t:all.settings.sectionColorScheme.options.secondary.label"
                                        },
                                        {
                                            "value": "light",
                                            "label": "t:all.settings.sectionColorScheme.options.light.label"
                                        },
                                        {
                                            "value": "dark",
                                            "label": "t:all.settings.sectionColorScheme.options.dark.label"
                                        },
                                        {
                                            "value": "accent",
                                            "label": "t:all.settings.sectionColorScheme.options.accent.label"
                                        },
                                        {
                                            "value": "custom",
                                            "label": "t:all.settings.sectionColorScheme.options.custom.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "style_custom_color",
                                    "type": "color",
                                    "alpha": true,
                                    "gradient": true,
                                    "label": "t:all.settings.style_custom_color.label",
                                    "default": "#f3f5f6",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_color",
                                    "type": "color",
                                    "alpha": true,
                                    "label": "t:all.settings.style_custom_content_color.label",
                                    "default": "#ffffff",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "style_custom_content_text_color",
                                    "type": "color",
                                    "alpha": true,
                                    "nullable": true,
                                    "label": "t:all.settings.style_custom_content_text_color.label",
                                    "conditions": [
                                        "sectionColorScheme eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionPaddingMode",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionPaddingMode.label",
                                    "default": "auto",
                                    "options": [
                                        {
                                            "value": "auto",
                                            "label": "t:all.settings.sectionPaddingMode.options.auto.label"
                                        },
                                        {
                                            "value": "custom",
                                            "label": "t:all.settings.sectionPaddingMode.options.custom.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "sectionPadding",
                                    "type": "padding",
                                    "label": "t:all.settings.sectionPadding.label",
                                    "padding": {
                                        "top": 0,
                                        "right": 0,
                                        "bottom": 0,
                                        "left": 0
                                    },
                                    "min": 0,
                                    "max": 15,
                                    "step": 0.5,
                                    "apply_to_all_sides": false,
                                    "conditions": [
                                        "sectionPaddingMode eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionBorderRadius",
                                    "label": "t:all.settings.sectionBorderRadius.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 50,
                                    "step": 1,
                                    "default": "0",
                                    "unit": "px",
                                    "conditions": [
                                        "sectionPaddingMode eq custom"
                                    ]
                                },
                                {
                                    "id": "sectionBgImg",
                                    "type": "image-picker",
                                    "label": "t:all.settings.sectionBgImg.label",
                                    "adjustments": true
                                },
                                {
                                    "id": "sectionBgImgFit",
                                    "type": "select",
                                    "label": "t:all.settings.sectionBgImgFit.label",
                                    "default": "cover",
                                    "options": [
                                        {
                                            "value": "cover",
                                            "label": "t:all.settings.sectionBgImgFit.options.cover.label"
                                        },
                                        {
                                            "value": "contain",
                                            "label": "t:all.settings.sectionBgImgFit.options.contain.label"
                                        },
                                        {
                                            "value": "auto",
                                            "label": "t:all.settings.sectionBgImgFit.options.auto.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgPosHorizontal",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionBgImgPosHorizontal.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "left",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.left.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.center.label"
                                        },
                                        {
                                            "value": "right",
                                            "label": "t:all.settings.sectionBgImgPosHorizontal.options.right.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgPosVertical",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionBgImgPosVertical.label",
                                    "default": "center",
                                    "options": [
                                        {
                                            "value": "top",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.top.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.center.label"
                                        },
                                        {
                                            "value": "bottom",
                                            "label": "t:all.settings.sectionBgImgPosVertical.options.bottom.label"
                                        }
                                    ],
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgDimming",
                                    "label": "t:all.settings.sectionBgImgDimming.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 90,
                                    "step": 5,
                                    "default": "0",
                                    "unit": "%",
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "id": "sectionBgImgBlur",
                                    "label": "t:all.settings.sectionBgImgBlur.label",
                                    "type": "range",
                                    "min": 0,
                                    "max": 10,
                                    "step": 1,
                                    "default": "0",
                                    "unit": " ",
                                    "conditions": [
                                        "!sectionBgImg eq false"
                                    ]
                                },
                                {
                                    "type": "title",
                                    "label": "t:all.groups.buttons.title"
                                },
                                {
                                    "id": "btnTheme",
                                    "type": "select",
                                    "label": "t:all.settings.btnTheme.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.btnTheme.options.nil.label"
                                        },
                                        {
                                            "value": "primary",
                                            "label": "t:all.settings.btnTheme.options.primary.label"
                                        },
                                        {
                                            "value": "secondary",
                                            "label": "t:all.settings.btnTheme.options.secondary.label"
                                        },
                                        {
                                            "value": "contrast",
                                            "label": "t:all.settings.btnTheme.options.contrast.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "btnVariant",
                                    "type": "select",
                                    "label": "t:all.settings.btnVariant.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.btnVariant.options.nil.label"
                                        },
                                        {
                                            "value": "filled",
                                            "label": "t:all.settings.btnVariant.options.filled.label"
                                        },
                                        {
                                            "value": "outline",
                                            "label": "t:all.settings.btnVariant.options.outline.label"
                                        },
                                        {
                                            "value": "ghost",
                                            "label": "t:all.settings.btnVariant.options.ghost.label"
                                        },
                                        {
                                            "value": "text",
                                            "label": "t:all.settings.btnVariant.options.text.label"
                                        }
                                    ]
                                },
                                {
                                    "id": "btnSize",
                                    "type": "select",
                                    "label": "t:all.settings.btnSize.label",
                                    "default": "sm",
                                    "options": [
                                        {
                                            "value": "xs",
                                            "label": "t:all.settings.btnSize.options.xs.label"
                                        },
                                        {
                                            "value": "sm",
                                            "label": "t:all.settings.btnSize.options.sm.label"
                                        },
                                        {
                                            "value": "md",
                                            "label": "t:all.settings.btnSize.options.md.label"
                                        },
                                        {
                                            "value": "lg",
                                            "label": "t:all.settings.btnSize.options.lg.label"
                                        }
                                    ]
                                }
                            ],
                            "id": "style"
                        },
                        {
                            "title": "t:all.groups.layout.title",
                            "settings": [
                                {
                                    "id": "sectionTextAlign",
                                    "type": "radio-pill",
                                    "label": "t:all.settings.sectionTextAlign.label",
                                    "default": "nil",
                                    "options": [
                                        {
                                            "value": "nil",
                                            "label": "t:all.settings.sectionTextAlign.options.nil.label"
                                        },
                                        {
                                            "value": "start",
                                            "label": "t:all.settings.sectionTextAlign.options.start.label"
                                        },
                                        {
                                            "value": "center",
                                            "label": "t:all.settings.sectionTextAlign.options.center.label"
                                        },
                                        {
                                            "value": "end",
                                            "label": "t:all.settings.sectionTextAlign.options.end.label"
                                        }
                                    ]
                                }
                            ],
                            "id": "layout"
                        }
                    ]
                },
                "id": "settings"
            }
        ]
    },
    "presets": [
        {
            "id": "default",
            "settings": {
                "btnSize": "sm"
            },
            "blocks": [
                {
                    "name": "product-manufacturer",
                    "container": "content"
                },
                {
                    "name": "product-title",
                    "container": "content",
                    "settings": {
                        "truncateName": false
                    }
                },
                {
                    "name": "product-rating",
                    "container": "content",
                    "settings": {
                        "iconSize": "md"
                    }
                },
                {
                    "name": "product-price",
                    "container": "content",
                    "settings": {
                        "showPromotion": true
                    }
                },
                {
                    "name": "product-description",
                    "container": "content"
                }
            ]
        }
    ],
    "containers": [
        {
            "id": "content",
            "title": "t:sections.product-promotion.containers.content.title",
            "allowed_blocks": [
                "product-manufacturer",
                "product-title",
                "product-title-price",
                "product-rating",
                "product-price",
                "product-description",
                "product-variants",
                "product-inventory",
                "spacer",
                "separator"
            ]
        }
    ]
}
{% endschema %}
