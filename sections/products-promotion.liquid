{% assign sectionAnimationOrder = 0 %}
{% assign productPerRow = section.settings.productPerRow | default: 3 %}

{% assign textAlign = section.settings.sectionTextAlign %}

{% if textAlign == 'nil' %}
    {% assign textAlign = settings.sectionTextAlign %}
{% endif %}

{%- capture sectionStyle -%}

    #finqu-section-{{ section.id }} .swiper-slide {
        --swiper-slide-width: {% if settings.styleElevation == 'hard' %}80{% else %}45{% endif %};
        --swiper-slide-width-sm: {% if settings.styleElevation == 'hard' %}50{% else %}40{% endif %};
        --swiper-slide-width-md: {% if settings.styleElevation == 'hard' %}40{% else %}35{% endif %};
        --swiper-slide-width-lg: {% if settings.styleElevation == 'hard' %}{{ 100 | divided_by: productPerRow }}{% else %}20{% endif %};
    }
    {% if settings.styleElevation == 'hard' %}
    #finqu-section-{{ section.id }} .products-promotion-carousel .swiper-slide {
        --swiper-slide-inner-width: calc(100% * var(--swiper-slide-width-in-percentage));
    }
    {% endif %}
    @media screen and (min-width: {{ settings.styleGridBreakpointLg }}) {
        #finqu-section-{{ section.id }} {
            --style-grid-gutter-width: {{ settings.styleGridGutterWidth }};
        }
    }
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- capture sectionContent -%}

    <div class="products-promotion-layout row gy-g gx-lg-10">

        <div class="products-promotion-media-column col-12 col-lg-6 order-2 order-lg-1">

            {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

            <div class="products-promotion-media section-media" data-aos="animation-fadeInLeft" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">
                {% block 'image' id:'section-image' %}
            </div>

        </div>

        <div class="products-promotion-content col-12 col-lg-6 order-1 order-lg-2 d-flex flex-column justify-content-center align-items-{{ textAlign }}">

            {% if settings.styleElevation == 'hard' %}
                <div class="products-promotion-intro">
            {% endif %}

                {% container 'intro' %}

            {% if settings.styleElevation == 'hard' %}
                </div>
            {% endif %}

            {%- capture slides -%}

                {% if section.settings.setting_blocks.items.size > 0 %}

                    {% for product in section.settings.setting_blocks.items %}

                        {%- if product.settings.product -%}
                            {%- assign product = product.settings.product -%}
                        {%- endif -%}

                        {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

                        <div class="swiper-slide">

                            <div class="swiper-slide-inner" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                                {%- capture productCardShellClass -%}
                                    {%- render 'product-card-shell-class', product: product -%}
                                {%- endcapture -%}

                                <div class="product-card-grid-item section-highlight-item {{ productCardShellClass | strip }}">

                        {% block 'product-list-item' id:'section-product-card' %}

                    </div>

                            </div>

                        </div>

                    {% endfor %}

                {% elsif request.design_mode %}

                    {% for num in (1..4) %}

                        {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

                        <div class="swiper-slide">

                            <div class="swiper-slide-inner" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                                {%- assign product = nil -%}
                                {%- capture productCardShellClass -%}
                                    {%- render 'product-card-shell-class', product: product -%}
                                {%- endcapture -%}

                                <div class="product-card-grid-item section-highlight-item {{ productCardShellClass | strip }}">

                        {% block 'product-list-item' id:'section-product-card' %}

                    </div>

                            </div>

                        </div>

                    {% endfor %}

                {% endif %}

            {%- endcapture -%}

            {%- render 'swiper', slides: slides, slidesPerView: 'auto', style: 2, evenHeightSlides: true, standalone: true, freemode: true, navigation: 'hover', class: 'products-promotion-carousel mt-6 w-100' -%}

        </div>

    </div>

{%- endcapture -%}

{% render 'section', section: section, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false %}

