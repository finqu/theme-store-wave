{%- if section.settings.sectionTextAlign == 'nil' -%}
    {%- assign textAlign = settings.sectionTextAlign -%}
{%- else -%}
    {%- assign textAlign = section.settings.sectionTextAlign -%}
{%- endif -%}

{%- assign bannerLayout = section.settings.bannerLayout | append: '' -%}
{%- assign isMarqueeLayout = false -%}
{%- if bannerLayout == '4' -%}
    {%- assign isMarqueeLayout = true -%}
{%- endif -%}

{%- if isMarqueeLayout -%}

    {%- assign marqueeTilt = section.settings.marqueeTilt | default: 'up' -%}
    {%- if marqueeTilt == 'down' -%}
        {%- assign marqueeTiltDeg = '3' -%}
    {%- else -%}
        {%- assign marqueeTiltDeg = '-3' -%}
    {%- endif -%}

    {%- capture marqueeTextBlock -%}
        {% block 'text' id:'section-promotion-banner-text', display: 'inline' %}
    {%- endcapture -%}
    {%- capture marqueeButtonBlock -%}
        {% block 'button' id:'section-promotion-banner-button', display: 'inline' %}
    {%- endcapture -%}

    {%- assign marqueePlainFromSetting = section.settings.bannerText | strip_html | strip -%}
    {%- if marqueePlainFromSetting != blank -%}
        {%- assign marqueeSourceHtml = section.settings.bannerText -%}
        {%- assign marqueeHasBannerText = true -%}
    {%- else -%}
        {%- assign marqueeSourceHtml = marqueeTextBlock -%}
        {%- assign marqueeHasBannerText = false -%}
    {%- endif -%}

    {%- assign marqueePlain = marqueeSourceHtml | strip_html | strip -%}
    {%- assign marqueePlain = marqueePlain | replace: '&apos;', "'" | replace: '&#39;', "'" | replace: '&amp;', '&' | replace: ' ✦ ', '. ' | replace: '✦', '. ' | strip -%}
    {%- assign marqueePhrases = marqueePlain | split: '. ' -%}

    {%- capture marqueeGroup -%}
        {%- for phrase in marqueePhrases -%}
            {%- assign phraseText = phrase | strip | replace: '.', '' | strip -%}
            {%- if phraseText != blank -%}
                <span class="promotion-banner-marquee-item">
                    <span class="promotion-banner-marquee-phrase">{{- phraseText | escape -}}</span>
                    <span class="promotion-banner-marquee-sep" aria-hidden="true"></span>
                </span>
            {%- endif -%}
        {%- endfor -%}
    {%- endcapture -%}
    {%- assign marqueeGroup = marqueeGroup | strip -%}

    {%- capture marqueeGroupRepeated -%}
        {%- if marqueeGroup != blank -%}
            {%- for i in (1..4) -%}
                {{- marqueeGroup -}}
            {%- endfor -%}
        {%- endif -%}
    {%- endcapture -%}

    {%- capture sectionContent -%}
        <div
            class="promotion-banner-marquee"
            data-promotion-banner-marquee
            style="--promotion-banner-marquee-tilt: {{ marqueeTiltDeg }}deg;">

            <div class="visually-hidden" data-marquee-source>
                {{- marqueeSourceHtml -}}
            </div>
            {%- if marqueeHasBannerText -%}
                <div class="visually-hidden" aria-hidden="true">
                    {{- marqueeTextBlock -}}
                </div>
            {%- endif -%}

            <div class="promotion-banner-marquee-viewport">
                <div class="promotion-banner-marquee-strip">
                    <div class="promotion-banner-marquee-mask">
                        <div class="promotion-banner-marquee-track">
                            <div class="promotion-banner-marquee-group">
                                {{- marqueeGroupRepeated -}}
                            </div>
                            <div class="promotion-banner-marquee-group" data-marquee-clone aria-hidden="true">
                                {{- marqueeGroupRepeated -}}
                            </div>
                        </div>
                    </div>
                    <div class="promotion-banner-marquee-cta">
                        {{- marqueeButtonBlock -}}
                    </div>
                </div>
            </div>

        </div>

        <script>
        (function () {
            var root = document.currentScript && document.currentScript.previousElementSibling;
            if (!root || !root.hasAttribute('data-promotion-banner-marquee')) return;
            var sourceGroup = root.querySelector('.promotion-banner-marquee-group');
            var cloneGroup = root.querySelector('[data-marquee-clone]');
            if (!sourceGroup) return;
            if (sourceGroup.querySelector('.promotion-banner-marquee-phrase')) {
                if (cloneGroup && !cloneGroup.childElementCount) {
                    cloneGroup.innerHTML = sourceGroup.innerHTML;
                }
                return;
            }
            var textRoot = root.querySelector('[data-marquee-source]') || sourceGroup;
            var text = (textRoot.textContent || '').replace(/\s+/g, ' ').trim();
            if (!text) return;
            var phrases = text.split(/\s*[.✦]\s*/).map(function (phrase) {
                return phrase.replace(/\.+$/, '').trim();
            }).filter(Boolean);
            if (!phrases.length) phrases = [text];
            var itemHtml = phrases.map(function (phrase) {
                return '<span class="promotion-banner-marquee-item"><span class="promotion-banner-marquee-phrase">' +
                    phrase.replace(/&/g, '&amp;').replace(/</g, '&lt;') +
                    '</span><span class="promotion-banner-marquee-sep" aria-hidden="true"></span></span>';
            }).join('');
            var repeated = new Array(4).fill(itemHtml).join('');
            sourceGroup.innerHTML = repeated;
            if (cloneGroup) cloneGroup.innerHTML = repeated;
        })();
        </script>
    {%- endcapture -%}

    {% render 'section', section: section, sectionContent: sectionContent, sectionHeader: false, sectionContentContainer: 'none', sectionOverflow: 'visible', sectionContentOverflow: 'visible' %}

{%- else -%}

    {%- capture sectionContent -%}

        <div class="d-flex flex-column flex-md-row gap-4 gap-md-6 align-items-center justify-content-{{ textAlign }}">

            {% block 'text' id:'section-promotion-banner-text', display: 'inline' %}

            {%- if bannerLayout == '2' and section.settings.discountCode -%}

                <div class="border py-2 px-4" style="--bs-border-style: dashed">

                    <span class="h5 mb-0 text-title">
                        {{- section.settings.discountCode -}}
                    </span>

                </div>

            {%- endif -%}

            {%- if bannerLayout == '3' -%}

                {% block 'countdown' id:'section-countdown' %}

            {%- endif -%}

            {% block 'button' id:'section-promotion-banner-button', display: 'inline' %}

        </div>

    {%- endcapture -%}

    {% render 'section', section: section, sectionContent: sectionContent, sectionHeader: false %}

{%- endif -%}

