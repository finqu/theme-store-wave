                        --style-btn-bg-active-color: {{ item.settings.colorScheme | color_lighten: 10 }};
                        --style-btn-bg-hover-color: {{ item.settings.colorScheme | color_lighten: 8 }};
                        --style-btn-border-hover-color: {{ item.settings.colorScheme | color_lighten: 8 }};
