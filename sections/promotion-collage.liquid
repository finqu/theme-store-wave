{% assign sectionAnimationOrder = 0 %}

{%- if section.settings.textHorizontalAlign == 'nil' -%}
    {%- assign textHorizontalAlign = settings.sectionTextAlign -%}
{%- else -%}
    {%- assign textHorizontalAlign = section.settings.textHorizontalAlign -%}
{%- endif -%}

{%- comment -%}
  Effective bottom padding for stacked collage spacing.
  Mirrors snippet `section` padding API (sectionPaddingMode + sectionPadding).
{%- endcomment -%}
{%- assign collagePadBottom = nil -%}
{%- if section.settings.sectionPaddingMode == 'custom' and section.settings.sectionPadding != nil -%}
    {%- assign collagePadValue = section.settings.sectionPadding -%}
    {%- if collagePadValue.apply_to_all_sides -%}
        {%- assign collagePadBottom = collagePadValue.padding | default: 0 -%}
    {%- else -%}
        {%- assign collagePadSides = collagePadValue.padding | default: collagePadValue -%}
        {%- assign collagePadBottom = collagePadSides.bottom | default: 0 -%}
    {%- endif -%}
{%- elsif settings.sectionPaddingBottom != nil -%}
    {%- assign collagePadBottom = settings.sectionPaddingBottom | remove: 'rem' | plus: 0 -%}
{%- else -%}
    {%- assign collagePadBottom = 0 -%}
{%- endif -%}

{%- capture sectionHeaderBlocks -%}
    {% container 'header' %}
{%- endcapture -%}

{%- capture sectionHeaderContent -%}
    {%- if sectionHeaderBlocks != blank -%}
        <div class="section-header">
            <div class="container">
                {{- sectionHeaderBlocks -}}
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture sectionContent -%}

    {%- if section.settings.collageLayout == 1 -%}

        {%- capture sectionStyle -%}
            #finqu-section-{{ section.id }} .section-content .collage-grid {
                display: grid;
                grid-gap: var(--style-grid-gutter-width);
            }
            #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(1) {
                grid-column: 1 / span 1;
                grid-row: 1 / span 1;
            }
            #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(2) {
                grid-column: 2 / span 1;
                grid-row: 1 / span 1;
            }
            #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(3) {
                grid-column: 1 / span 1;
                grid-row: 2 / span 1;
            }
            #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(4) {
                grid-column: 2 / span 1;
                grid-row: 2 / span 1;
            }
            #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(5) {
                grid-column: 1 / span 2;
                grid-row: 3 / span 2;
            }
            @media screen and (min-width: {{ settings.styleGridBreakpointMd }}) {
                #finqu-section-{{ section.id }} .section-content .collage-grid {
                    grid-template-columns: repeat(4, 1fr);
                }
                #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(5) {
                    grid-column: 3 / span 2;
                    grid-row: 1 / span 2;
                }
            }
            {% if collagePadBottom == 0 %}
                #finqu-section-{{ section.id }} + .section-promotion-collage {
                    --section-padding-top: var(--style-grid-gutter-width);
                }
            {%- endif -%}
            {%- for item in section.settings.setting_blocks.items -%}
                #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child({{ forloop.index}}) {
                    {%- render 'section-color-scheme' colorScheme: item.settings.colorScheme, customColor: item.settings.colorSchemeCustomColor -%}
                }
            {%- endfor -%}
            {%- if section.settings.imgDimming != '0' -%}
                #finqu-section-{{ section.id }} .collage-grid .aspect-ratio-container::after {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 0;
                    right: 0;
                    bottom: 0;
                    z-index: 1;
                    background: linear-gradient(0deg, rgb(0,0,0, {{ section.settings.imgDimming }}%), rgb(0,0,0, {{ section.settings.imgDimming }}%))
                }
            {%- endif -%}
            {%- if section.settings.imgBlur != '0' -%}
                #finqu-section-{{ section.id }} .collage-grid .lazy {
                    transform: scale(1.0{{ section.settings.imgBlur | divided_by: 2 | plus: 2 }});
                    filter: blur({{ section.settings.imgBlur }}px);
                }
            {%- endif -%}
        {%- endcapture -%}

        <style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

        <div class="collage-grid">

            {% for item in section.settings.setting_blocks.items %}

                {% assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 %}

                {% if forloop.index == 5 %}

                    {%- assign imgSizeSm = '414,414' -%}
                    {%- assign imgSizeMd = '560,560' -%}
                    {%- assign imgSizeLg = '650,650' -%}

                {% else %}

                    {%- assign imgSizeSm = '414,414' -%}
                    {%- assign imgSizeMd = '275,275' -%}
                    {%- assign imgSizeLg = '320,320' -%}

                {% endif %}

                <div class="position-relative img-indicator-zoom text-inherit">

                    {%- if item.settings.btnLink.url %}
                        <a href="{{ item.settings.btnLink.url | link }}" target="{{ item.settings.btnLink.target }}">
                    {%- endif %}

                    <div class="aspect-ratio-1-1">

                        <div class="aspect-ratio-container" data-aos="animation-zoomFade" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                            {%- if item.settings.img -%}

                                <picture>

                                    <source media="(min-width: {{ settings.styleGridBreakpointLg }})" data-srcset="
                                        {{- item.settings.img | thumb: imgSizeLg }} 1x,
                                        {{- item.settings.img | thumb: imgSizeLg | thumb:'@2x' }} 2x">

                                    <source media="(min-width: {{ settings.styleGridBreakpointMd }})" data-srcset="
                                        {{- item.settings.img | thumb: imgSizeLg }} 1x,
                                        {{- item.settings.img | thumb: imgSizeLg | thumb:'@2x' }} 2x">

                                    <source data-srcset="
                                        {{- item.settings.img | thumb: imgSizeSm }} 1x,
                                        {{- item.settings.img | thumb: imgSizeSm | thumb:'@2x' }} 2x">

                                    <img
                                        alt="{{ item.settings.img.alt }}"
                                        data-src="{{ item.settings.img | thumb: imgSizeSm }}"
                                        data-srcset="{{ item.settings.img | thumb: imgSizeSm }} 1x, {{ item.settings.img | thumb: imgSizeSm | thumb:'@2x' }} 2x"
                                        class="lazy aspect-ratio-item aspect-ratio-item-cover"{% if item.settings.img.offset_left or item.settings.img.offset_top %} style="--object-position: {{ item.settings.img.offset_left }}% {{ item.settings.img.offset_top }}%"{% endif %}>

                                </picture>

                            {%- else -%}

                                {%- capture class -%}
                                    aspect-ratio-item aspect-ratio-item-cover
                                {%- endcapture -%}

                                {% render 'placeholder-svg', type: 'image', class: class %}

                            {%- endif -%}

                        </div>

                    </div>

                    <div class="grid g-0 position-absolute top-0 start-0 w-100 h-100 p-g p-md-5 z-1" style="--bs-gap: 0">

                        <div class="g-col-12 place-content-{{ section.settings.textVerticalAlign }}">

                            {%- assign sectionHandle = '#finqu-section-' | append: section.id -%}

                            {% render 'section-header', sectionTitle: item.settings.title, sectionTitleTag: 'span', sectionDescription: item.settings.subtitle, sectionSubtitleTag: 'span', sectionOverline: item.settings.overline, sectionOverlineTag: 'span', sectionHeaderContainer: 'none', sectionAnimation: settings.sectionAnimation, sectionHandle: sectionHandle, sectionHeaderGapScale: 0.5, sectionHeaderTextAlign: textHorizontalAlign %}

                            {%- if item.settings.btnLink.text -%}

                                <div class="d-flex mt-4 justify-content-{{ textHorizontalAlign }}" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                                    {%- render 'section-quick-link', theme: section.settings.btnTheme, variant: section.settings.btnVariant, size: section.settings.btnSize, text: item.settings.btnLink.text  -%}

                                </div>

                            {%- endif -%}

                        </div>

                    </div>

                    {%- if item.settings.btnLink.url %}
                        </a>
                    {%- endif %}

                </div>

            {% endfor %}

        </div>

    {%- elsif section.settings.collageLayout == 2 -%}

        {%- capture sectionStyle -%}
            #finqu-section-{{ section.id }} .section-content .collage-grid {
                display: grid;
                grid-gap: var(--style-grid-gutter-width);
            }
            @media screen and (min-width: {{ settings.styleGridBreakpointMd }}) {
                #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(1) {
                    grid-column: 1 / span 1;
                    grid-row: 1 / span 1;
                }
                #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(2) {
                    grid-column: 1 / span 1;
                    grid-row: 2 / span 1;
                }
                #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(3) {
                    grid-column: 2 / span 1;
                    grid-row: 1 / span 1;
                }
                #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(4) {
                    grid-column: 4 / span 1;
                    grid-row: 1 / span 1;
                }
                #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(5) {
                    grid-column: 4 / span 1;
                    grid-row: 2 / span 1;
                }
                #finqu-section-{{ section.id }} .section-content .collage-grid {
                    grid-template-columns: repeat(4, 1fr);
                }
                #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child(3) {
                    grid-column: 2 / span 2;
                    grid-row: 1 / span 2;
                }
            }
            {%- if collagePadBottom == 0 -%}
                #finqu-section-{{ section.id }} + .section-promotion-collage {
                    --section-padding-top: var(--style-grid-gutter-width);
                }
            {%- endif -%}
            {%- for item in section.settings.setting_blocks.items -%}
                #finqu-section-{{ section.id }} .section-content .collage-grid > div:nth-child({{ forloop.index}}) {
                    {%- render 'section-color-scheme' colorScheme: item.settings.colorScheme, customColor: item.settings.colorSchemeCustomColor -%}
                }
            {%- endfor -%}
            {%- if section.settings.imgDimming != '0' -%}
                #finqu-section-{{ section.id }} .collage-grid .aspect-ratio-container::after {
                    content: '';
                    position: absolute;
                    left: 0;
                    top: 0;
                    right: 0;
                    bottom: 0;
                    z-index: 1;
                    background: linear-gradient(0deg, rgb(0,0,0, {{ section.settings.imgDimming }}%), rgb(0,0,0, {{ section.settings.imgDimming }}%))
                }
            {%- endif -%}
            {%- if section.settings.imgBlur != '0' -%}
                #finqu-section-{{ section.id }} .collage-grid .lazy {
                    transform: scale(1.0{{ section.settings.imgBlur | divided_by: 2 | plus: 2 }});
                    filter: blur({{ section.settings.imgBlur }}px);
                }
            {%- endif -%}
        {%- endcapture -%}

        <style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

        <div class="collage-grid">

            {% for item in section.settings.setting_blocks.items %}

                {% assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 %}

                {% if forloop.index == 3 %}

                    {%- assign aspectRatioClass = 'aspect-ratio-1-1 aspect-ratio-md-1-1' -%}
                    {%- assign imgSizeSm = '400,400' -%}
                    {%- assign imgSizeMd = '560,560' -%}
                    {%- assign imgSizeLg = '650,792' -%}

                {% else %}

                    {%- assign aspectRatioClass = 'aspect-ratio-1-1' -%}
                    {%- assign imgSizeSm = '400,400' -%}
