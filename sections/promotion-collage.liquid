                    {%- assign imgSizeLg = '320,320' -%}

                {% endif %}

                <div class="position-relative img-indicator-zoom text-inherit">

                    {%- if item.settings.btnLink.url %}
                        <a href="{{ item.settings.btnLink.url | link }}" target="{{ item.settings.btnLink.target }}">
                    {%- endif %}

                    <div class="{{ aspectRatioClass }}">

                        <div class="aspect-ratio-container" data-aos="animation-zoomFade" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                            {%- if item.settings.img -%}

                                <picture>

                                    <source media="(min-width: {{ settings.styleGridBreakpointLg }})" data-srcset="
                                        {{- item.settings.img | thumb: imgSizeLg }} 1x,
                                        {{- item.settings.img | thumb: imgSizeLg | thumb:'@2x' }} 2x">

                                    <source media="(min-width: {{ settings.styleGridBreakpointMd }})" data-srcset="
                                        {{- item.settings.img | thumb: imgSizeLg }} 1x,
                                        {{- item.settings.img | thumb: imgSizeLg | thumb:'@2x' }} 2x">

                                    <source data-srcset="
                                        {{- item.settings.img | thumb: imgSizeSm }} 1x,
                                        {{- item.settings.img | thumb: imgSizeSm | thumb:'@2x' }} 2x">

                                    <img
                                        alt="{{ item.settings.img.alt }}"
                                        data-src="{{ item.settings.img | thumb: imgSizeSm }}"
                                        data-srcset="{{ item.settings.img | thumb: imgSizeSm }} 1x, {{ item.settings.img | thumb: imgSizeSm | thumb:'@2x' }} 2x"
                                        class="lazy aspect-ratio-item aspect-ratio-item-cover"{% if item.settings.img.offset_left or item.settings.img.offset_top %} style="--object-position: {{ item.settings.img.offset_left }}% {{ item.settings.img.offset_top }}%"{% endif %}>

                                </picture>

                            {%- else -%}

                                {%- capture class -%}
                                    aspect-ratio-item aspect-ratio-item-cover
                                {%- endcapture -%}

                                {% render 'placeholder-svg', type: 'image', class: class %}

                            {%- endif -%}

                        </div>

                    </div>

                    <div class="grid g-0 position-absolute top-0 start-0 w-100 h-100 p-g p-md-5 z-1" style="--bs-gap: 0">

                       <div class="g-col-12 place-content-{{ section.settings.textVerticalAlign }}">

                            {%- assign sectionHandle = '#finqu-section-' | append: section.id -%}

                            {% render 'section-header', sectionTitle: item.settings.title, sectionTitleTag: 'span', sectionDescription: item.settings.subtitle, sectionSubtitleTag: 'span', sectionOverline: item.settings.overline, sectionOverlineTag: 'span', sectionHeaderContainer: 'none', sectionAnimation: settings.sectionAnimation, sectionHandle: sectionHandle, sectionHeaderGapScale: 0.5, sectionHeaderTextAlign: textHorizontalAlign %}

                            {%- if item.settings.btnLink.text -%}

                                <div class="d-flex mt-4 justify-content-{{ textHorizontalAlign }}" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

                                    {%- render 'section-quick-link', theme: section.settings.btnTheme, variant: section.settings.btnVariant, size: section.settings.btnSize, text: item.settings.btnLink.text  -%}

                                </div>

                            {%- endif -%}

                        </div>

                    </div>

                    {%- if item.settings.btnLink.url %}
                        </a>
                    {%- endif %}

                </div>

            {% endfor %}

        </div>

    {%- elsif section.settings.collageLayout == 3 -%}

        {%- case section.settings.imgAspectRatio -%}
            {% when '16:9' %}
                {%- assign imgSizeSm = '400,229' -%}
                {%- assign imgSizeMd = '560,319' -%}
                {%- assign imgSizeLg = '650,370' -%}
            {% when '4:3' %}
                {%- assign imgSizeSm = '420,317' -%}
                {%- assign imgSizeMd = '560,422' -%}
                {%- assign imgSizeLg = '650,490' -%}
            {% when '1:1' %}
                {%- assign imgSizeSm = '400,400' -%}
                {%- assign imgSizeMd = '560,560' -%}
                {%- assign imgSizeLg = '650,650' -%}
        {%- endcase -%}

        {%- capture sectionStyle -%}
            {% if collagePadBottom == 0 %}
                #finqu-section-{{ section.id }} + .section-promotion-collage {
                    --section-padding-top: var(--style-grid-gutter-width);
                }
            {%- endif -%}
            {%- for item in section.settings.setting_blocks.items -%}
                {%- assign colorShemeBrightness = item.settings.colorScheme | color_brightness -%}
                {%- if colorShemeBrightness > 190 -%}
                    {%- assign accentTextColor = '#000' -%}
                {%- else -%}
                    {%- assign accentTextColor = '#fff' -%}
                {%- endif -%}
                #finqu-section-{{ section.id }} .section-content .grid > div:nth-child({{ forloop.index}}) {
                    --style-heading-color: {{ item.settings.colorScheme }};
                    --style-subheading-color: {{ item.settings.colorScheme }};
                    --style-overline-color: {{ item.settings.colorScheme }};
                    --style-text-color: {{ item.settings.colorScheme }};
                    --style-link-color: {{ item.settings.colorScheme }};
                    --style-icon-color: {{ item.settings.colorScheme }};
                    --style-btn-bg-color: {{ item.settings.colorScheme }};
                    --style-btn-text-color: {{ accentTextColor }};
                    --style-btn-border-color: {{ item.settings.colorScheme }};
                    --style-border-color: {{ accentTextColor | color_mix: item.settings.colorScheme, 15 }};
                    --style-border-focus-color: {{ accentTextColor | color_mix: item.settings.colorScheme, 20 }};
                    --style-border-accent-color: {{ accentTextColor | color_mix: item.settings.colorScheme, 50 }};
                    --style-accent-color: {{ item.settings.colorScheme }};
                    --style-accent-text-color: {{ accentTextColor }};
                    {%- if colorShemeBrightness > 190 -%}
                        --style-btn-bg-active-color: {{ item.settings.colorScheme | color_darken: 10 }};
                        --style-btn-bg-hover-color: {{ item.settings.colorScheme | color_darken: 8 }};
                        --style-btn-border-hover-color: {{ item.settings.colorScheme | color_darken: 8 }};
                        --style-btn-border-active-color: {{ item.settings.colorScheme | color_darken: 13 }};
