{%- if section.settings.sectionHighlightItems == 'nil' and settings.sectionHighlightItems == true or section.settings.sectionHighlightItems == true -%}
    {%- assign sectionHighlightItems = true -%}
{%- endif -%}

{%- assign sectionAnimationOrder = 0 -%}

{%- assign columnCount = section.settings.columns | default: 3 | plus: 0 -%}
{%- if columnCount < 1 -%}
    {%- assign columnCount = 1 -%}
{%- elsif columnCount > 4 -%}
    {%- assign columnCount = 4 -%}
{%- endif -%}

{%- if section.settings.orientation == 'horizontal' -%}
    {%- assign textColumnsPerRow = section.settings.colPerRow | default: columnCount -%}
{%- else -%}
    {%- assign textColumnsPerRow = 1 -%}
{%- endif -%}

{%- capture sectionStyle -%}
    #finqu-section-{{ section.id }} .text-columns-row {
        display: grid;
        gap: var(--style-grid-gutter-width, 1.5rem);
        grid-template-columns: 1fr;
        width: 100%;
    }
    {%- if section.settings.orientation == 'horizontal' -%}
        @media screen and (min-width: {{ settings.styleGridBreakpointLg }}) {
            #finqu-section-{{ section.id }} .text-columns-row {
                grid-template-columns: repeat({{ textColumnsPerRow }}, minmax(0, 1fr));
            }
        }
    {%- endif -%}
    {% if section.settings.orientation == 'vertical' and sectionHighlightItems != true %}
        @media screen and (min-width: {{ settings.styleGridBreakpointLg }}) {
            #finqu-section-{{ section.id }} .section-inner {
                --style-grid-gutter-width: 4rem;
            }
        }
        #finqu-section-{{ section.id }} .text-columns-col:not(:first-child) {
            border-top: var(--bs-border-width) var(--bs-border-style) var(--bs-border-color);
            padding-top: var(--style-grid-gutter-width);
        }
        @media screen and (min-width: {{ settings.styleGridBreakpointLg }}) {
            #finqu-section-{{ section.id }} .text-columns-col:not(:first-child) {
                border-top: 0;
                padding-top: 0;
            }
        }
    {% endif %}
    #finqu-section-{{ section.id }} .text-columns-col .finqu-section-blocks-container {
        display: flex;
        flex-direction: column;
        gap: 1rem;
        width: 100%;
        height: 100%;
    }
    #finqu-section-{{ section.id }} .text-columns-col {
        min-width: 0;
    }
    {%- if section.settings.orientation == 'vertical' -%}
        @media screen and (min-width: {{ settings.styleGridBreakpointLg }}) {
            #finqu-section-{{ section.id }} .text-columns-col .finqu-section-blocks-container {
                display: grid;
                grid-template-columns: auto 1fr;
                grid-auto-flow: dense;
                align-items: center;
                gap: 1rem 1.5rem;
            }
            #finqu-section-{{ section.id }} .text-columns-col .block-image {
                grid-row: 1 / span 2;
            }
            #finqu-section-{{ section.id }} .text-columns-col .block-heading {
                grid-column: 2;
            }
            #finqu-section-{{ section.id }} .text-columns-col .block-text,
            #finqu-section-{{ section.id }} .text-columns-col .block-button,
            #finqu-section-{{ section.id }} .text-columns-col .block-button-group {
                grid-column: 2;
            }
        }
    {%- endif -%}
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- capture sectionHeaderBlocks -%}
    {% container 'header' %}
{%- endcapture -%}

{%- capture sectionHeaderContent -%}
    {%- if sectionHeaderBlocks != blank -%}
        <div class="section-header">
            <div class="container">
                {{- sectionHeaderBlocks -}}
            </div>
        </div>
    {%- endif -%}
{%- endcapture -%}

{%- capture sectionContent -%}

    {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

    <div class="text-columns-row" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

        <div class="text-columns-col section-highlight-item">
            {% container 'column-1' %}
        </div>

        {%- if columnCount >= 2 -%}
            <div class="text-columns-col section-highlight-item">
                {% container 'column-2' %}
            </div>
        {%- endif -%}

        {%- if columnCount >= 3 -%}
            <div class="text-columns-col section-highlight-item">
                {% container 'column-3' %}
            </div>
        {%- endif -%}

        {%- if columnCount >= 4 -%}
            <div class="text-columns-col section-highlight-item">
                {% container 'column-4' %}
            </div>
        {%- endif -%}

    </div>

{%- endcapture -%}

{% render 'section', section: section, sectionHeaderContent: sectionHeaderContent, sectionContent: sectionContent, sectionContentAnimation: false, sectionHeader: false %}

