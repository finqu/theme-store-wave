{%- assign cols = section.settings.rowLayout | split: ',' -%}
{%- assign leftColSize = cols[0] -%}
{%- assign rightColSize = cols[1] -%}
{%- assign sectionAnimationOrder = 0 -%}

{%- assign columnCount = section.settings.columns | default: 2 | plus: 0 -%}
{%- if columnCount < 1 -%}
    {%- assign columnCount = 1 -%}
{%- elsif columnCount > 4 -%}
    {%- assign columnCount = 4 -%}
{%- endif -%}

{%- assign textColumnsPerRow = section.settings.colPerRow | default: columnCount -%}

{%- capture sectionStyle -%}
    #finqu-section-{{ section.id }} .text-columns-row {
        display: grid;
        gap: var(--style-grid-gutter-width, 1.5rem);
        grid-template-columns: 1fr;
        width: 100%;
    }
    @media screen and (min-width: {{ settings.styleGridBreakpointLg }}) {
        #finqu-section-{{ section.id }} .text-columns-row {
            grid-template-columns: repeat({{ textColumnsPerRow }}, minmax(0, 1fr));
        }
    }
    #finqu-section-{{ section.id }} .text-columns-col {
        min-width: 0;
    }
    #finqu-section-{{ section.id }} .text-columns-col .finqu-section-blocks-container {
        display: flex;
        flex-direction: column;
        gap: 0.75rem;
        width: 100%;
    }
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{%- capture imgColContent -%}

    {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

    <div class="section-media" data-aos="{% if section.settings.imgPosition == 'start' %}animation-fadeInLeft{% else %}animation-fadeInRight{% endif %}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">
        {% block 'image' id:'section-image' %}
    </div>

{%- endcapture -%}

{%- capture textColContent -%}

    {%- capture sectionHeaderContent -%}
        {% container 'header' %}
    {%- endcapture -%}

    {%- if sectionHeaderContent != blank -%}

        <div class="w-100 mb-5">

            {{- sectionHeaderContent -}}

        </div>

    {%- endif -%}

    {%- assign sectionAnimationOrder = sectionAnimationOrder | plus: 1 -%}

    <div class="text-columns-row w-100" data-aos="{{ settings.sectionAnimation }}" data-aos-anchor="#finqu-section-{{ section.id }}" data-aos-delay style="--aos-order: {{ sectionAnimationOrder }}">

        <div class="text-columns-col">
            {% container 'column-1' %}
        </div>

        {%- if columnCount >= 2 -%}
            <div class="text-columns-col">
                {% container 'column-2' %}
            </div>
        {%- endif -%}

        {%- if columnCount >= 3 -%}
            <div class="text-columns-col">
                {% container 'column-3' %}
            </div>
        {%- endif -%}

        {%- if columnCount >= 4 -%}
            <div class="text-columns-col">
                {% container 'column-4' %}
            </div>
        {%- endif -%}

    </div>

{%- endcapture -%}

{%- capture sectionContent -%}

    <div class="row gy-5">

        {%- if section.settings.imgPosition == 'start' -%}

            <div class="col-12 col-md-6 col-xxl-{{ leftColSize }} d-flex flex-column align-self-center">
                {{- imgColContent -}}
            </div>

            <div class="col-12 col-md-6 col-xxl-{{ rightColSize }} d-flex flex-column justify-content-center align-items-center">
                {{- textColContent -}}
            </div>

        {%- elsif section.settings.imgPosition == 'end' -%}

            <div class="col-12 col-md-6 col-xxl-{{ leftColSize }} d-flex flex-column justify-content-center align-items-center order-2 order-md-1">
                {{- textColContent -}}
            </div>

            <div class="col-12 col-md-6 col-xxl-{{ rightColSize }} d-flex flex-column align-self-center order-1 order-md-2">
                {{- imgColContent -}}
            </div>

        {%- endif -%}

    </div>

{%- endcapture -%}

