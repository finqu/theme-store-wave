{%- if section.settings.barVisibility == 'frontpage' and request.page_type == 'frontpage' -%}
    {%- assign barIsVisible = true -%}
{% elsif section.settings.barVisibility == 'all' %}
    {%- assign barIsVisible = true -%}
{%- else -%}
    {%- assign barIsVisible = false -%}
{%- endif -%}

{%- if section.settings.barTextAlign == 'nil' -%}
    {%- assign barTextAlign = settings.sectionTextAlign -%}
{%- else -%}
    {%- assign barTextAlign = section.settings.barTextAlign -%}
{%- endif -%}

{%- capture sectionStyle -%}
    #finqu-section-{{ section.id }} {
        --style-announcement-align: {{ barTextAlign }};
        {%- render 'header-bar-bg', barBgColor: section.settings.barBgColor -%}
    }
{%- endcapture -%}

<style>{{ sectionStyle | strip | replace: '  ', '' | strip_newlines }}</style>

{% if barIsVisible or request.design_mode == 'edit' -%}

    {%- capture utilityLinks -%}

        {%- for item in section.settings.setting_blocks.items -%}

            {%- if item.settings.link.text -%}

                {%- if item.settings.link.url -%}

                    <a
                        href="{{ item.settings.link.url }}"
                        class="site-utility-bar-link"
                        target="{{ item.settings.link.target | default: '_self' }}">
                        {{- item.settings.link.text -}}
                    </a>

                {%- else -%}

                    <span class="site-utility-bar-link">
                        {{- item.settings.link.text -}}
                    </span>

                {%- endif -%}

            {%- endif -%}

        {%- endfor -%}

    {%- endcapture -%}

    {%- capture utilityLocalization -%}

        {% render 'localization-form',
            form_id: 'utility-bar-localization',
            class: 'site-utility-bar-localization',
            preview: request.design_mode %}

    {%- endcapture -%}

    <div class="site-header-bar">

        <div class="site-utility-bar container">

            {%- if section.settings.utilityLayout == 'mixed' -%}

                <div class="site-utility-bar-mixed">

                    {%- if section.settings.setting_blocks.items.size > 0 -%}
                        <div class="site-utility-bar-links">{{ utilityLinks }}</div>
                    {%- endif -%}

                    {{ utilityLocalization }}

                </div>

            {%- elsif section.settings.utilityLayout == 'localization' -%}

                <div class="site-utility-bar-inner">
                    {{ utilityLocalization }}
                </div>

            {%- else -%}

                <div class="site-utility-bar-inner">
                    <div class="site-utility-bar-links">{{ utilityLinks }}</div>
                </div>

            {%- endif -%}

        </div>

    </div>

{% endif %}

