{% comment %}
	Renders a product list grid. When the list is empty and the theme designer is active,
	renders placeholder product cards so the section layout stays visible in the editor.

	Accepts:
	- items: {Array} Products to display
	- product_amount: {Number} Max items and placeholder count in design mode when empty
	- product_per_row: {Number} Products per row (grid column class)
	- section: {Object} Section Liquid object (required — `render` uses an isolated context; needed for `{% block %}` config lookup)
	- section_id: {String} Section id for AOS anchor (optional)
	- product_list_block_id: {String} product-list-item block id (default: section-product-card)
	- row_class: {String} Extra row CSS classes (optional)
	- col_class: {String} Extra column CSS classes (optional)
	- animated_items_count: {Number} Limit AOS to first N items (optional)
	- aos_anchor_partial: {String} When set, only output inline --aos-order when partial differs (optional)

	Usage:
	{% render 'product-list-grid', items: items, product_amount: section.settings.productAmount, product_per_row: productPerRow, section_id: section.id, section: section %}
{% endcomment %}

{%- assign productListBlockId = product_list_block_id | default: 'section-product-card' -%}
{%- assign productPerRow = product_per_row | default: 5 -%}
{%- assign placeholderCount = product_amount | default: productPerRow | times: 2 -%}

<div class="row gy-g row-scroll-cols-2 row-scroll-cols-md-3 row-cols-lg-{{ productPerRow }}{% if row_class %} {{ row_class }}{% endif %}">

	{% if items and items.size > 0 %}

		{% for item in items %}

			{%- assign product = item -%}

			{%- if item.settings.product -%}
				{%- assign product = item.settings.product -%}
			{%- endif -%}

			<div class="col{% if col_class %} {{ col_class }}{% endif %}"{% if animated_items_count == nil or forloop.index <= animated_items_count %} data-aos="{{ settings.sectionAnimation }}"{% if section_id %} data-aos-anchor="#finqu-section-{{ section_id }}"{% endif %} data-aos-delay{% if aos_anchor_partial == nil or rendered_partial != aos_anchor_partial %} style="--aos-order: {{ forloop.index }}"{% endif %}{% endif %}>

				{%- capture productCardShellClass -%}
					{%- render 'product-card-shell-class', product: product -%}
				{%- endcapture -%}

				<div class="product-card-grid-item section-highlight-item {{ productCardShellClass | strip }}">

					{% block 'product-list-item' id:productListBlockId %}

				</div>

			</div>

		{% endfor %}

	{% elsif request.design_mode %}

		{% for num in (1..placeholderCount) %}

			{%- assign product = nil -%}

			<div class="col{% if col_class %} {{ col_class }}{% endif %}"{% if animated_items_count == nil or forloop.index <= animated_items_count %} data-aos="{{ settings.sectionAnimation }}"{% if section_id %} data-aos-anchor="#finqu-section-{{ section_id }}"{% endif %} data-aos-delay{% if aos_anchor_partial == nil or rendered_partial != aos_anchor_partial %} style="--aos-order: {{ forloop.index }}"{% endif %}{% endif %}>

				{%- capture productCardShellClass -%}
					{%- render 'product-card-shell-class', product: product -%}
				{%- endcapture -%}

				<div class="product-card-grid-item section-highlight-item {{ productCardShellClass | strip }}">

					{% block 'product-list-item' id:productListBlockId %}

				</div>

			</div>

		{% endfor %}

	{% endif %}

</div>
